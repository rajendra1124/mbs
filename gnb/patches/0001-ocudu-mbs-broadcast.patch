+static asn1::rrc_nr::sib20_r17_s make_asn1_rrc_cell_sib20(const sib20_info& sib20_params)
+{
+  using namespace asn1::rrc_nr;
+
+  sib20_r17_s sib20;
+
+  switch (sib20_params.mcch_repetition_period_rf) {
+    case 1:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf1_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 2:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf2_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 4:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf4_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 8:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf8_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 16:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf16_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 32:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf32_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 64:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf64_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 128:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf128_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    case 256:
+      sib20.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf256_r17() = sib20_params.mcch_repetition_offset_rf;
+      break;
+    default:
+      report_fatal_error("Invalid SIB20 MCCH repetition period {}", sib20_params.mcch_repetition_period_rf);
+  }
+
+  sib20.mcch_cfg_r17.mcch_win_start_slot_r17 = sib20_params.mcch_window_start_slot;
+  sib20.mcch_cfg_r17.mcch_win_dur_r17_present = true;
+  bool ret = asn1::number_to_enum(sib20.mcch_cfg_r17.mcch_win_dur_r17,
+                                  sib20_params.mcch_window_duration_slots);
+  ocudu_assert(ret, "Invalid SIB20 MCCH window duration {}", sib20_params.mcch_window_duration_slots);
+  ret = asn1::number_to_enum(sib20.mcch_cfg_r17.mcch_mod_period_r17,
+                             sib20_params.mcch_modification_period_rf);
+  ocudu_assert(ret, "Invalid SIB20 MCCH modification period {}", sib20_params.mcch_modification_period_rf);
+
+  return sib20;
+}
