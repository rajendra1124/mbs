+static void fill_global_mbs_session_id(global_mbs_session_id_s& asn1_session_id, const e1ap_mbs_session_id& session_id)
+{
+  asn1_session_id.tmgi.from_string(session_id.tmgi);
+  if (session_id.nid.has_value()) {
+    asn1_session_id.nid_present = true;
+    asn1_session_id.nid.from_string(*session_id.nid);
+  }
+}
+
+static std::vector<uint8_t> make_mbs_qos_flow_ids(const std::vector<uint8_t>& qos_flow_ids)
+{
+  std::vector<uint8_t> out = qos_flow_ids;
+  if (out.empty()) {
+    out.push_back(1);
+  }
+  std::sort(out.begin(), out.end());
+  out.erase(std::unique(out.begin(), out.end()), out.end());
+  return out;
+}
+
+static qos_flow_qos_param_item_s make_default_mbs_qos_flow_param(uint8_t qos_flow_id)
+{
+  qos_flow_qos_param_item_s item;
+  item.qos_flow_id = qos_flow_id;
+  item.qos_flow_level_qos_params.qos_characteristics.set_non_dyn_5qi().five_qi = 9;
+  item.qos_flow_level_qos_params.ngra_nalloc_retention_prio.prio_level         = 1;
+  item.qos_flow_level_qos_params.ngra_nalloc_retention_prio.pre_emption_cap.value =
+      pre_emption_cap_opts::shall_not_trigger_pre_emption;
+  item.qos_flow_level_qos_params.ngra_nalloc_retention_prio.pre_emption_vulnerability.value =
+      pre_emption_vulnerability_opts::not_pre_emptable;
+  return item;
+}
+
+static mcmrb_setup_cfg_item_s make_mbs_mrb_setup_cfg(const e1ap_mbs_mrb_item& mrb)
+{
+  mcmrb_setup_cfg_item_s item;
+  item.mrb_id                       = mrb.mrb_id;
+  item.mbs_pdcp_cfg.pdcp_sn_size_ul = pdcp_sn_size_e::s_neg18;
+  item.mbs_pdcp_cfg.pdcp_sn_size_dl = pdcp_sn_size_e::s_neg18;
+  item.mbs_pdcp_cfg.rlc_mode        = rlc_mode_opts::rlc_um_unidirectional_dl;
+
+  for (uint8_t qos_flow_id : make_mbs_qos_flow_ids(mrb.qos_flow_ids)) {
+    item.qos_flow_qos_param_list.push_back(make_default_mbs_qos_flow_param(qos_flow_id));
+  }
+  return item;
+}
+
+static mcmrb_setup_modify_cfg_item_s make_mbs_mrb_setup_modify_cfg(const e1ap_mbs_mrb_item& mrb)
+{
+  mcmrb_setup_modify_cfg_item_s item;
+  item.mrb_id                       = mrb.mrb_id;
+  item.mbs_pdcp_cfg_present         = true;
+  item.mbs_pdcp_cfg.pdcp_sn_size_ul = pdcp_sn_size_e::s_neg18;
+  item.mbs_pdcp_cfg.pdcp_sn_size_dl = pdcp_sn_size_e::s_neg18;
+  item.mbs_pdcp_cfg.rlc_mode        = rlc_mode_opts::rlc_um_unidirectional_dl;
+
+  for (uint8_t qos_flow_id : make_mbs_qos_flow_ids(mrb.qos_flow_ids)) {
+    item.qos_flow_qos_param_list.push_back(make_default_mbs_qos_flow_param(qos_flow_id));
+  }
+  return item;
+}
