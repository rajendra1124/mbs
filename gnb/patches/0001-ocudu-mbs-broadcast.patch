+void e1ap_cu_cp_impl::handle_mbs_bearer_context_setup_request(
+    const e1ap_mbs_bearer_context_setup_request& request)
+{
+  e1ap_message e1ap_msg;
+  e1ap_msg.pdu.set_init_msg().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_SETUP);
+  auto& setup_request = e1ap_msg.pdu.init_msg().value.mc_bearer_context_setup_request();
+
+  setup_request->gnb_cu_cp_mbs_e1ap_id = request.cu_cp_mbs_e1ap_id;
+  fill_global_mbs_session_id(setup_request->global_mbs_session_id, request.session_id);
+  setup_request->mc_bearer_context_to_setup.snssai.sst.from_number(1);
+
+  if (request.area_session_id.has_value()) {
+    setup_request->mc_bearer_context_to_setup.ie_exts_present                 = true;
+    setup_request->mc_bearer_context_to_setup.ie_exts.mbs_area_session_id_present = true;
+    setup_request->mc_bearer_context_to_setup.ie_exts.mbs_area_session_id     = *request.area_session_id;
+  }
+
+  for (const auto& mrb : request.mrb_to_setup_list) {
+    setup_request->mc_bearer_context_to_setup.mc_mrb_to_setup_list.push_back(make_mbs_mrb_setup_cfg(mrb));
+  }
+
+  logger.info("MBS CU-CP-E1AP-ID={}: Sending MCBearerContextSetupRequest nof_mrbs={}",
+              request.cu_cp_mbs_e1ap_id,
+              request.mrb_to_setup_list.size());
+  pdu_notifier.on_new_message(e1ap_msg);
+}
+
+void e1ap_cu_cp_impl::handle_mbs_bearer_context_modification_request(
+    const e1ap_mbs_bearer_context_modification_request& request)
+{
+  e1ap_message e1ap_msg;
+  e1ap_msg.pdu.set_init_msg().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_MOD);
+  auto& mod_request = e1ap_msg.pdu.init_msg().value.mc_bearer_context_mod_request();
+
+  mod_request->gnb_cu_cp_mbs_e1ap_id = request.cu_cp_mbs_e1ap_id;
+  mod_request->gnb_cu_up_mbs_e1ap_id = request.cu_up_mbs_e1ap_id;
+
+  for (const auto& mrb : request.mrb_to_setup_modify_list) {
+    mod_request->mc_bearer_context_to_modify.mc_mrb_to_setup_modify_list.push_back(
+        make_mbs_mrb_setup_modify_cfg(mrb));
+  }
+  for (uint16_t mrb_id : request.mrb_to_remove_list) {
+    mod_request->mc_bearer_context_to_modify.mc_mrb_to_rem_list.push_back(mrb_id);
+  }
+
+  logger.info("MBS CU-CP-E1AP-ID={}: Sending MCBearerContextModificationRequest CU-UP-MBS-E1AP-ID={} "
+              "nof_setup_modify_mrbs={} nof_remove_mrbs={}",
+              request.cu_cp_mbs_e1ap_id,
+              request.cu_up_mbs_e1ap_id,
+              request.mrb_to_setup_modify_list.size(),
+              request.mrb_to_remove_list.size());
+  pdu_notifier.on_new_message(e1ap_msg);
+}
