+void e1ap_cu_up_impl::handle_mbs_bearer_context_release_command(
+    const asn1::e1ap::mc_bearer_context_release_cmd_s& msg)
+{
+  e1ap_mbs_bearer_context_release_command command;
+  command.cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  command.cu_up_mbs_e1ap_id = msg->gnb_cu_up_mbs_e1ap_id;
+
+  e1ap_mbs_bearer_context_release_complete complete =
+      cu_up_notifier.on_mbs_bearer_context_release_command_received(command);
+
+  e1ap_message e1ap_msg;
+  e1ap_msg.pdu.set_successful_outcome().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_RELEASE);
+  auto& release_complete = e1ap_msg.pdu.successful_outcome().value.mc_bearer_context_release_complete();
+  release_complete->gnb_cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  release_complete->gnb_cu_up_mbs_e1ap_id = complete.cu_up_mbs_e1ap_id != 0 ? complete.cu_up_mbs_e1ap_id
+                                                                            : msg->gnb_cu_up_mbs_e1ap_id;
+
+  logger.info("MBS CU-CP-E1AP-ID={}: Sending MCBearerContextReleaseComplete CU-UP-MBS-E1AP-ID={}",
+              release_complete->gnb_cu_cp_mbs_e1ap_id,
+              release_complete->gnb_cu_up_mbs_e1ap_id);
+  pdu_notifier->on_new_message(e1ap_msg);
+}
