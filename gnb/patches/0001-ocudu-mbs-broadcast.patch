+void cu_cp_impl::handle_mbs_bearer_context_setup_response(const e1ap_mbs_bearer_context_setup_response& msg)
+{
+  const auto key_it = mbs_session_keys_by_cu_cp_e1ap_id.find(msg.cu_cp_mbs_e1ap_id);
+  if (key_it == mbs_session_keys_by_cu_cp_e1ap_id.end()) {
+    logger.warning("MBS CU-CP-E1AP-ID={}: Setup response received for unknown session", msg.cu_cp_mbs_e1ap_id);
+    return;
+  }
+
+  mbs_cu_up_e1ap_ids[key_it->second] = msg.cu_up_mbs_e1ap_id;
+  logger.info("MBS session={}: CU-CP stored CU-UP-MBS-E1AP-ID={}", key_it->second, msg.cu_up_mbs_e1ap_id);
+}
+
+void cu_cp_impl::handle_mbs_bearer_context_modification_response(
+    const e1ap_mbs_bearer_context_modification_response& msg)
+{
+  const auto key_it = mbs_session_keys_by_cu_cp_e1ap_id.find(msg.cu_cp_mbs_e1ap_id);
+  if (key_it == mbs_session_keys_by_cu_cp_e1ap_id.end()) {
+    logger.warning("MBS CU-CP-E1AP-ID={}: Modification response received for unknown session",
+                   msg.cu_cp_mbs_e1ap_id);
+    return;
+  }
+
+  logger.info("MBS session={}: CU-CP completed E1AP multicast bearer modification CU-UP-MBS-E1AP-ID={} nof_mrbs={}",
+              key_it->second,
+              msg.cu_up_mbs_e1ap_id,
+              msg.mrb_setup_modify_resp_list.size());
+}
+
+void cu_cp_impl::handle_mbs_bearer_context_release_complete(const e1ap_mbs_bearer_context_release_complete& msg)
+{
+  const auto key_it = mbs_session_keys_by_cu_cp_e1ap_id.find(msg.cu_cp_mbs_e1ap_id);
+  if (key_it == mbs_session_keys_by_cu_cp_e1ap_id.end()) {
+    logger.warning("MBS CU-CP-E1AP-ID={}: Release complete received for unknown session", msg.cu_cp_mbs_e1ap_id);
+    return;
+  }
+
+  logger.info("MBS session={}: CU-CP completed E1AP multicast bearer release CU-UP-MBS-E1AP-ID={}",
+              key_it->second,
+              msg.cu_up_mbs_e1ap_id);
+  mbs_cu_up_e1ap_ids.erase(key_it->second);
+  mbs_cu_cp_e1ap_ids.erase(key_it->second);
