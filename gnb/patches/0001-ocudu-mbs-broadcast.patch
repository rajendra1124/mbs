+static std::vector<e1ap_mbs_mrb_item> make_mbs_mrb_list(const mcmrb_setup_modify_cfg_l& asn1_mrb_list)
+{
+  std::vector<e1ap_mbs_mrb_item> out;
+  for (const auto& asn1_mrb : asn1_mrb_list) {
+    e1ap_mbs_mrb_item mrb;
+    mrb.mrb_id = asn1_mrb.mrb_id;
+    for (const auto& qos_flow : asn1_mrb.qos_flow_qos_param_list) {
+      mrb.qos_flow_ids.push_back(qos_flow.qos_flow_id);
+    }
+    out.push_back(std::move(mrb));
+  }
+  return out;
+}
