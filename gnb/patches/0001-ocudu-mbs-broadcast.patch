+void ngap_impl::send_broadcast_session_setup_response(const asn1::ngap::mbs_session_id_s& session_id)
+{
+  ngap_message ngap_msg = {};
+  ngap_msg.pdu.set_successful_outcome();
+  ngap_msg.pdu.successful_outcome().load_info_obj(ASN1_NGAP_ID_BROADCAST_SESSION_SETUP);
+  auto& resp           = ngap_msg.pdu.successful_outcome().value.broadcast_session_setup_resp();
+  resp->mbs_session_id = session_id;
+
+  // The 5GC delivers the broadcast traffic over the shared NG-U multicast tunnel signalled in the request, so no
+  // NG-RAN TNL information needs to be returned in the response transfer.
+  mbs_session_setup_or_mod_resp_transfer_s resp_transfer;
+  byte_buffer                              packed_transfer = pack_into_pdu(resp_transfer);
+  if (!packed_transfer.empty()) {
+    resp->mbs_session_setup_resp_transfer_present = true;
+    resp->mbs_session_setup_resp_transfer         = std::move(packed_transfer);
+  }
+
+  if (!tx_pdu_notifier.on_new_message(ngap_msg)) {
+    logger.warning("MBS session={}: AMF notifier is not set. Cannot send BroadcastSessionSetupResponse",
+                   make_mbs_session_key(session_id));
+  }
+}
