+static std::string make_cu_cp_mbs_session_key(const cu_cp_mbs_session_id& session_id)
+{
+  std::string key = session_id.tmgi;
+  if (session_id.nid.has_value()) {
+    key += ":";
+    key += *session_id.nid;
+  }
+  return key;
+}
+
+static e1ap_mbs_session_id make_e1ap_mbs_session_id(const cu_cp_mbs_session_id& session_id)
+{
+  e1ap_mbs_session_id out;
+  out.tmgi = session_id.tmgi;
+  out.nid  = session_id.nid;
+  return out;
+}
+
+static e1ap_mbs_mrb_item make_e1ap_mbs_default_mrb(const std::vector<uint8_t>& qos_flow_ids)
+{
+  e1ap_mbs_mrb_item item;
+  item.mrb_id       = 1;
+  item.qos_flow_ids = qos_flow_ids;
+  if (item.qos_flow_ids.empty()) {
+    item.qos_flow_ids.push_back(1);
+  }
+  return item;
+}
+
+void cu_cp_impl::handle_mbs_session_update_request(const cu_cp_mbs_session_update_request& msg)
+{
+  const std::string key = make_cu_cp_mbs_session_key(msg.session_id);
+
+  cu_cp_mbs_session_context& session = mbs_sessions[key];
+  session.session_id                 = msg.session_id;
+  session.area_session_id            = msg.area_session_id;
+  session.qos_flow_ids               = msg.qos_flow_ids;
+  session.service_area_present       = msg.service_area_present;
+  session.qos_flows_present          = msg.qos_flows_present;
+  session.ngu_tnl_info_present       = msg.ngu_tnl_info_present;
+  session.qos_flow_release_present   = msg.qos_flow_release_present;
+  session.ngu_tnl_info               = msg.ngu_tnl_info;
+
+  logger.info("MBS session={}: CU-CP stored session update area={} service_area={} qos_flows={} nof_qos_flows={} ngu_tnl={}",
+              key,
+              msg.area_session_id.has_value(),
+              msg.service_area_present,
+              msg.qos_flows_present,
+              msg.qos_flow_ids.size(),
+              msg.ngu_tnl_info_present);
+  if (msg.ngu_tnl_info.has_value()) {
+    logger.info("MBS session={}: CU-CP stored NG-U multicast tunnel {}", key, msg.ngu_tnl_info.value());
+  }
+
+  if (cu_up_db.get_nof_cu_ups() == 0) {
+    logger.debug("MBS session={}: No CU-UP connected for E1AP multicast bearer context setup", key);
+  } else {
+    uint32_t& cu_cp_mbs_e1ap_id = mbs_cu_cp_e1ap_ids[key];
+    if (cu_cp_mbs_e1ap_id == 0) {
+      cu_cp_mbs_e1ap_id = next_mbs_cu_cp_e1ap_id++;
+    }
+    mbs_session_keys_by_cu_cp_e1ap_id[cu_cp_mbs_e1ap_id] = key;
+
+    cu_up_index_t cu_up_index = cu_up_db.select_cu_up();
+    const auto    cu_up_id_it = mbs_cu_up_e1ap_ids.find(key);
+    auto&         e1ap_mbs_manager =
+        cu_up_db.get_cu_up(cu_up_index).get_e1ap_mbs_bearer_context_manager();
+    if (cu_up_id_it == mbs_cu_up_e1ap_ids.end()) {
+      e1ap_mbs_bearer_context_setup_request e1ap_request;
+      e1ap_request.cu_cp_mbs_e1ap_id = cu_cp_mbs_e1ap_id;
+      e1ap_request.session_id        = make_e1ap_mbs_session_id(session.session_id);
+      e1ap_request.area_session_id   = session.area_session_id;
+      e1ap_request.ngu_tnl_info      = session.ngu_tnl_info;
+      e1ap_request.mrb_to_setup_list.push_back(make_e1ap_mbs_default_mrb(session.qos_flow_ids));
+      e1ap_mbs_manager.handle_mbs_bearer_context_setup_request(e1ap_request);
+    } else {
+      e1ap_mbs_bearer_context_modification_request e1ap_request;
+      e1ap_request.cu_cp_mbs_e1ap_id = cu_cp_mbs_e1ap_id;
+      e1ap_request.cu_up_mbs_e1ap_id = cu_up_id_it->second;
+      e1ap_request.ngu_tnl_info      = session.ngu_tnl_info;
+      e1ap_request.mrb_to_setup_modify_list.push_back(make_e1ap_mbs_default_mrb(session.qos_flow_ids));
+      e1ap_mbs_manager.handle_mbs_bearer_context_modification_request(e1ap_request);
+    }
+  }
+
+  const auto du_indexes = du_db.get_du_processor_indexes();
+  if (du_indexes.empty()) {
+    logger.debug("MBS session={}: No DUs connected for F1AP multicast context setup", key);
+    return;
+  }
+
+  for (du_index_t du_index : du_indexes) {
+    du_db.get_du_processor(du_index).get_f1ap_handler().get_f1ap_mbs_manager().handle_mbs_session_update_request(
+        f1ap_mbs_session_update_request{session});
+  }
+}
+
+void cu_cp_impl::handle_mbs_session_activation_request(const cu_cp_mbs_session_activation_request& msg)
+{
+  const std::string key     = make_cu_cp_mbs_session_key(msg.session_id);
+  auto              session = mbs_sessions.find(key);
+  if (session == mbs_sessions.end()) {
+    logger.warning("MBS session={}: CU-CP activation received before session update", key);
+    return;
+  }
+
+  session->second.active = true;
+  logger.info("MBS session={}: CU-CP activated session context", key);
+}
+
+void cu_cp_impl::handle_mbs_session_deactivation_request(const cu_cp_mbs_session_deactivation_request& msg)
+{
+  const std::string key     = make_cu_cp_mbs_session_key(msg.session_id);
+  auto              session = mbs_sessions.find(key);
+  if (session == mbs_sessions.end()) {
+    logger.debug("MBS session={}: CU-CP deactivation received for unknown session", key);
+    return;
+  }
+
+  session->second.active = false;
+  logger.info("MBS session={}: CU-CP deactivated session context", key);
+
+  const auto cu_cp_id_it = mbs_cu_cp_e1ap_ids.find(key);
+  const auto cu_up_id_it = mbs_cu_up_e1ap_ids.find(key);
+  if (cu_up_db.get_nof_cu_ups() == 0) {
+    logger.debug("MBS session={}: No CU-UP connected for E1AP multicast bearer release", key);
+  } else if (cu_cp_id_it == mbs_cu_cp_e1ap_ids.end() || cu_up_id_it == mbs_cu_up_e1ap_ids.end()) {
+    logger.debug("MBS session={}: No established E1AP multicast bearer context to release", key);
+  } else {
+    cu_up_index_t cu_up_index = cu_up_db.select_cu_up();
+    cu_up_db.get_cu_up(cu_up_index)
+        .get_e1ap_mbs_bearer_context_manager()
+        .handle_mbs_bearer_context_release_command(
+            e1ap_mbs_bearer_context_release_command{cu_cp_id_it->second, cu_up_id_it->second});
+  }
+
+  for (du_index_t du_index : du_db.get_du_processor_indexes()) {
+    du_db.get_du_processor(du_index).get_f1ap_handler().get_f1ap_mbs_manager().handle_mbs_session_release_request(
+        f1ap_mbs_session_release_request{msg.session_id});
+  }
+}
+
+void cu_cp_impl::handle_mbs_group_paging_message(const cu_cp_mbs_group_paging_message& msg)
+{
+  logger.info("MBS session={}: CU-CP received multicast group paging with {} area entries",
+              make_cu_cp_mbs_session_key(msg.session_id),
+              msg.nof_paging_area_entries);
+}
