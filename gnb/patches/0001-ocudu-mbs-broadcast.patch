+std::string f1ap_du_impl::make_mbs_session_key(const asn1::f1ap::mbs_session_id_s& session_id)
+{
+  std::string key = session_id.tmgi.to_string();
+  if (session_id.nid_present) {
+    key += ":";
+    key += session_id.nid.to_string();
+  }
+  return key;
+}
+
+uint64_t f1ap_du_impl::allocate_du_mbs_f1ap_id()
+{
+  return next_du_mbs_f1ap_id++;
+}
+
+std::string f1ap_du_impl::make_mbs_f1u_context_key(const std::string& multicast_f1u_context_ref, uint16_t mrb_id)
+{
+  return multicast_f1u_context_ref + ":" + std::to_string(mrb_id);
+}
+
+std::string f1ap_du_impl::get_mbs_f1u_local_addr() const
+{
+  // Co-located CU/DU builds use the local connector address space for F1-U. Split deployments can replace this once
+  // the app-level F1-U bind address is threaded into F1AP MBS distribution setup.
+  return "127.0.10.2";
+}
+
+static void append_unique_mrb_id(std::vector<uint16_t>& mrb_ids, uint16_t mrb_id)
+{
+  if (std::find(mrb_ids.begin(), mrb_ids.end(), mrb_id) == mrb_ids.end()) {
+    mrb_ids.push_back(mrb_id);
+  }
+}
+
+static pdcp_sn_size f1ap_pdcp_sn_len_to_pdcp_sn_size(const asn1::f1ap::pdcp_sn_len_e& sn_len)
+{
+  return sn_len.value == asn1::f1ap::pdcp_sn_len_opts::eighteen_bits ? pdcp_sn_size::size18bits
+                                                                     : pdcp_sn_size::size12bits;
+}
+
+static void upsert_mrb_config(std::vector<f1ap_du_mbs_mrb_config>& configs, f1ap_du_mbs_mrb_config cfg)
+{
+  auto it = std::find_if(configs.begin(), configs.end(), [&cfg](const f1ap_du_mbs_mrb_config& item) {
+    return item.mrb_id == cfg.mrb_id;
+  });
+  if (it == configs.end()) {
+    configs.push_back(cfg);
+  } else {
+    *it = cfg;
+  }
+}
+
+void f1ap_du_impl::handle_multicast_context_setup_request(const asn1::f1ap::multicast_context_setup_request_s& msg)
+{
+  const std::string key = make_mbs_session_key(msg->mbs_session_id);
+
+  mbs_context& context = mbs_contexts[key];
+  if (context.du_mbs_f1ap_id == 0) {
+    context.du_mbs_f1ap_id = allocate_du_mbs_f1ap_id();
+  }
+  context.cu_mbs_f1ap_id = msg->gnb_cu_mbs_f1ap_id;
+  context.session_id     = msg->mbs_session_id;
+  context.mrb_ids.clear();
+  context.mrb_configs.clear();
+
+  f1ap_message resp_msg;
+  resp_msg.pdu.set_successful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_CONTEXT_SETUP);
+  auto& resp = resp_msg.pdu.successful_outcome().value.multicast_context_setup_resp();
+
+  resp->gnb_cu_mbs_f1ap_id = context.cu_mbs_f1ap_id;
+  resp->gnb_du_mbs_f1ap_id = context.du_mbs_f1ap_id;
+  resp->multicast_m_rbs_setup_list.resize(msg->multicast_m_rbs_to_be_setup_list.size());
+
+  for (uint32_t i = 0; i != msg->multicast_m_rbs_to_be_setup_list.size(); ++i) {
+    const auto& req_item = msg->multicast_m_rbs_to_be_setup_list[i]->multicast_m_rbs_to_be_setup_item();
+    resp->multicast_m_rbs_setup_list[i].load_info_obj(ASN1_F1AP_ID_MULTICAST_M_RBS_SETUP_ITEM);
+    resp->multicast_m_rbs_setup_list[i]->multicast_m_rbs_setup_item().mrb_id = req_item.mrb_id;
+  }
+
+  f1ap_du_mbs_context_setup_request du_request;
+  du_request.session_key        = key;
+  du_request.gnb_cu_mbs_f1ap_id = context.cu_mbs_f1ap_id;
+  du_request.gnb_du_mbs_f1ap_id = context.du_mbs_f1ap_id;
+  du_request.mrb_ids.reserve(msg->multicast_m_rbs_to_be_setup_list.size());
+  du_request.mrb_configs.reserve(msg->multicast_m_rbs_to_be_setup_list.size());
+  for (const auto& mrb : msg->multicast_m_rbs_to_be_setup_list) {
+    const auto&    req_item = mrb->multicast_m_rbs_to_be_setup_item();
+    const uint16_t mrb_id   = req_item.mrb_id;
+    f1ap_du_mbs_mrb_config cfg;
+    cfg.mrb_id          = mrb_id;
+    cfg.pdcp_sn_size_dl = f1ap_pdcp_sn_len_to_pdcp_sn_size(req_item.mbs_dl_pdcp_sn_len);
+    append_unique_mrb_id(context.mrb_ids, mrb_id);
+    upsert_mrb_config(context.mrb_configs, cfg);
+    du_request.mrb_ids.push_back(mrb_id);
+    du_request.mrb_configs.push_back(cfg);
+  }
+  du_mng.on_mbs_context_setup(du_request);
+
+  logger.info("MBS session={}: Accepted multicast context setup cu_mbs_f1ap_id={} du_mbs_f1ap_id={} mrbs={}",
+              key,
+              context.cu_mbs_f1ap_id,
+              context.du_mbs_f1ap_id,
+              msg->multicast_m_rbs_to_be_setup_list.size());
+  tx_pdu_notifier->on_new_message(resp_msg);
+}
+
+void f1ap_du_impl::handle_multicast_context_modification_request(
+    const asn1::f1ap::multicast_context_mod_request_s& msg)
+{
+  auto context = std::find_if(mbs_contexts.begin(), mbs_contexts.end(), [&msg](const auto& entry) {
+    return entry.second.cu_mbs_f1ap_id == msg->gnb_cu_mbs_f1ap_id and
+           entry.second.du_mbs_f1ap_id == msg->gnb_du_mbs_f1ap_id;
+  });
+
+  if (context == mbs_contexts.end()) {
+    f1ap_message fail_msg;
+    fail_msg.pdu.set_unsuccessful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_CONTEXT_MOD);
+    auto& fail                 = fail_msg.pdu.unsuccessful_outcome().value.multicast_context_mod_fail();
+    fail->gnb_cu_mbs_f1ap_id   = msg->gnb_cu_mbs_f1ap_id;
+    fail->gnb_du_mbs_f1ap_id   = msg->gnb_du_mbs_f1ap_id;
+    fail->cause.set_radio_network().value =
+        asn1::f1ap::cause_radio_network_opts::unknown_or_inconsistent_pair_of_mbs_f1ap_id;
+    logger.warning(
+        "cu_mbs_f1ap_id={} du_mbs_f1ap_id={}: Rejecting multicast context modification. Cause: context not found",
+        msg->gnb_cu_mbs_f1ap_id,
+        msg->gnb_du_mbs_f1ap_id);
+    tx_pdu_notifier->on_new_message(fail_msg);
+    return;
+  }
+
+  f1ap_message resp_msg;
+  resp_msg.pdu.set_successful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_CONTEXT_MOD);
+  auto& resp = resp_msg.pdu.successful_outcome().value.multicast_context_mod_resp();
+
+  resp->gnb_cu_mbs_f1ap_id = context->second.cu_mbs_f1ap_id;
+  resp->gnb_du_mbs_f1ap_id = context->second.du_mbs_f1ap_id;
+
+  if (msg->multicast_m_rbs_to_be_setup_mod_list_present) {
+    resp->multicast_m_rbs_setup_mod_list_present = true;
+    resp->multicast_m_rbs_setup_mod_list.resize(msg->multicast_m_rbs_to_be_setup_mod_list.size());
+    for (uint32_t i = 0; i != msg->multicast_m_rbs_to_be_setup_mod_list.size(); ++i) {
+      const auto& req_item = msg->multicast_m_rbs_to_be_setup_mod_list[i]->multicast_m_rbs_to_be_setup_mod_item();
+      append_unique_mrb_id(context->second.mrb_ids, req_item.mrb_id);
+      f1ap_du_mbs_mrb_config cfg;
+      cfg.mrb_id          = req_item.mrb_id;
+      cfg.pdcp_sn_size_dl = f1ap_pdcp_sn_len_to_pdcp_sn_size(req_item.mbs_dl_pdcp_sn_len);
+      upsert_mrb_config(context->second.mrb_configs, cfg);
+      resp->multicast_m_rbs_setup_mod_list[i].load_info_obj(ASN1_F1AP_ID_MULTICAST_M_RBS_SETUP_MOD_ITEM);
+      resp->multicast_m_rbs_setup_mod_list[i]->multicast_m_rbs_setup_mod_item().mrb_id = req_item.mrb_id;
+    }
+  }
+
+  if (msg->multicast_m_rbs_to_be_modified_list_present) {
+    resp->multicast_m_rbs_modified_list_present = true;
+    resp->multicast_m_rbs_modified_list.resize(msg->multicast_m_rbs_to_be_modified_list.size());
+    for (uint32_t i = 0; i != msg->multicast_m_rbs_to_be_modified_list.size(); ++i) {
+      const auto& req_item = msg->multicast_m_rbs_to_be_modified_list[i]->multicast_m_rbs_to_be_modified_item();
+      append_unique_mrb_id(context->second.mrb_ids, req_item.mrb_id);
+      if (req_item.mbs_dl_pdcp_sn_len_present) {
+        f1ap_du_mbs_mrb_config cfg;
+        cfg.mrb_id          = req_item.mrb_id;
+        cfg.pdcp_sn_size_dl = f1ap_pdcp_sn_len_to_pdcp_sn_size(req_item.mbs_dl_pdcp_sn_len);
+        upsert_mrb_config(context->second.mrb_configs, cfg);
+      }
+      resp->multicast_m_rbs_modified_list[i].load_info_obj(ASN1_F1AP_ID_MULTICAST_M_RBS_MODIFIED_ITEM);
+      resp->multicast_m_rbs_modified_list[i]->multicast_m_rbs_modified_item().mrb_id = req_item.mrb_id;
+    }
+  }
+
+  if (msg->multicast_m_rbs_to_be_released_list_present) {
+    for (const auto& item : msg->multicast_m_rbs_to_be_released_list) {
+      const uint16_t mrb_id = item->multicast_m_rbs_to_be_released_item().mrb_id;
+      context->second.mrb_ids.erase(std::remove(context->second.mrb_ids.begin(), context->second.mrb_ids.end(), mrb_id),
+                                    context->second.mrb_ids.end());
+      context->second.mrb_configs.erase(std::remove_if(context->second.mrb_configs.begin(),
+                                                       context->second.mrb_configs.end(),
+                                                       [mrb_id](const f1ap_du_mbs_mrb_config& cfg) {
+                                                         return cfg.mrb_id == mrb_id;
+                                                       }),
+                                        context->second.mrb_configs.end());
+    }
+  }
+
+  du_mng.on_mbs_context_modification({context->first,
+                                      context->second.cu_mbs_f1ap_id,
+                                      context->second.du_mbs_f1ap_id,
+                                      context->second.mrb_ids,
+                                      context->second.mrb_configs});
+
+  logger.info("MBS session={}: Accepted multicast context modification cu_mbs_f1ap_id={} du_mbs_f1ap_id={} "
+              "setup_mod_mrbs={} modified_mrbs={} active_mrbs={}",
+              context->first,
+              context->second.cu_mbs_f1ap_id,
+              context->second.du_mbs_f1ap_id,
+              msg->multicast_m_rbs_to_be_setup_mod_list.size(),
+              msg->multicast_m_rbs_to_be_modified_list.size(),
+              context->second.mrb_ids.size());
+  tx_pdu_notifier->on_new_message(resp_msg);
+}
+
+void f1ap_du_impl::handle_multicast_context_release_command(const asn1::f1ap::multicast_context_release_cmd_s& msg)
+{
+  auto context = std::find_if(mbs_contexts.begin(), mbs_contexts.end(), [&msg](const auto& entry) {
+    return entry.second.cu_mbs_f1ap_id == msg->gnb_cu_mbs_f1ap_id and
+           entry.second.du_mbs_f1ap_id == msg->gnb_du_mbs_f1ap_id;
+  });
+
+  if (context == mbs_contexts.end()) {
+    logger.warning("cu_mbs_f1ap_id={} du_mbs_f1ap_id={}: Ignoring multicast context release. Cause: context not found",
+                   msg->gnb_cu_mbs_f1ap_id,
+                   msg->gnb_du_mbs_f1ap_id);
+    return;
+  }
+
+  f1ap_message resp_msg;
+  resp_msg.pdu.set_successful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_CONTEXT_RELEASE);
+  auto& resp = resp_msg.pdu.successful_outcome().value.multicast_context_release_complete();
+
+  resp->gnb_cu_mbs_f1ap_id = context->second.cu_mbs_f1ap_id;
+  resp->gnb_du_mbs_f1ap_id = context->second.du_mbs_f1ap_id;
+
+  logger.info("MBS session={}: Released multicast context cu_mbs_f1ap_id={} du_mbs_f1ap_id={}",
+              context->first,
+              context->second.cu_mbs_f1ap_id,
+              context->second.du_mbs_f1ap_id);
+  du_mng.on_mbs_context_release(
+      {context->first, context->second.cu_mbs_f1ap_id, context->second.du_mbs_f1ap_id});
+  for (auto it = mbs_f1u_distribution_contexts.begin(); it != mbs_f1u_distribution_contexts.end();) {
+    if (it->second.session_key == context->first) {
+      const auto context_ref =
+          it->first.substr(0, it->first.rfind(":"));
+      auto ngu_receiver = mbs_ngu_receivers.find(it->first);
+      if (ngu_receiver != mbs_ngu_receivers.end()) {
+        ngu_receiver->second->stop();
+        mbs_ngu_receivers.erase(ngu_receiver);
+      } else {
+        auto demux_session = mbs_f1u_demux_sessions.find(it->first);
+        if (demux_session != mbs_f1u_demux_sessions.end()) {
+          demux_session->second->stop();
+          mbs_f1u_demux_sessions.erase(demux_session);
+        } else {
+          mbs_f1u_router->unbind_context({context_ref, it->second.mrb_id});
+        }
+      }
+      it = mbs_f1u_distribution_contexts.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  mbs_contexts.erase(context);
+  tx_pdu_notifier->on_new_message(resp_msg);
+}
+
+void f1ap_du_impl::handle_multicast_distribution_setup_request(
+    const asn1::f1ap::multicast_distribution_setup_request_s& msg)
+{
+  const auto send_distribution_setup_failure = [this, &msg](cause_radio_network_opts::options cause) {
+    f1ap_message fail_msg;
+    fail_msg.pdu.set_unsuccessful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_DISTRIBUTION_SETUP);
+    auto& fail = fail_msg.pdu.unsuccessful_outcome().value.multicast_distribution_setup_fail();
+    fail->gnb_cu_mbs_f1ap_id                    = msg->gnb_cu_mbs_f1ap_id;
+    fail->gnb_du_mbs_f1ap_id_present            = true;
+    fail->gnb_du_mbs_f1ap_id                    = msg->gnb_du_mbs_f1ap_id;
+    fail->mbs_multicast_f1_u_context_descriptor = msg->mbs_multicast_f1_u_context_descriptor;
+    fail->cause.set_radio_network().value       = cause;
+    tx_pdu_notifier->on_new_message(fail_msg);
+  };
+
+  auto context = std::find_if(mbs_contexts.begin(), mbs_contexts.end(), [&msg](const auto& entry) {
+    return entry.second.cu_mbs_f1ap_id == msg->gnb_cu_mbs_f1ap_id and
+           entry.second.du_mbs_f1ap_id == msg->gnb_du_mbs_f1ap_id;
+  });
+
+  if (context == mbs_contexts.end()) {
+    logger.warning(
+        "cu_mbs_f1ap_id={} du_mbs_f1ap_id={}: Ignoring multicast distribution setup. Cause: MBS context not found",
+        msg->gnb_cu_mbs_f1ap_id,
+        msg->gnb_du_mbs_f1ap_id);
+    send_distribution_setup_failure(cause_radio_network_opts::unknown_or_inconsistent_pair_of_mbs_f1ap_id);
+    return;
+  }
+
+  if (msg->multicast_f1_u_context_to_be_setup_list.size() == 0) {
+    logger.warning("MBS session={}: Rejecting multicast distribution setup. Cause: empty MRB F1-U context list",
+                   context->first);
+    send_distribution_setup_failure(cause_radio_network_opts::unknown_or_inconsistent_mrb_id);
+    return;
+  }
+
+  const std::string context_ref =
+      msg->mbs_multicast_f1_u_context_descriptor.multicast_f1_u_context_ref_f1.to_string();
+
+  for (const auto& item : msg->multicast_f1_u_context_to_be_setup_list) {
+    const uint16_t mrb_id = item->multicast_f1_u_context_to_be_setup_item().mrb_id;
+    if (std::find(context->second.mrb_ids.begin(), context->second.mrb_ids.end(), mrb_id) ==
+        context->second.mrb_ids.end()) {
+      logger.warning("MBS session={}: Rejecting multicast distribution setup. Cause: MRB {} is not configured",
+                     context->first,
+                     mrb_id);
+      send_distribution_setup_failure(cause_radio_network_opts::unknown_or_inconsistent_mrb_id);
+      return;
+    }
+  }
+
+  f1ap_message resp_msg;
+  resp_msg.pdu.set_successful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_DISTRIBUTION_SETUP);
+  auto& resp = resp_msg.pdu.successful_outcome().value.multicast_distribution_setup_resp();
+
+  resp->gnb_cu_mbs_f1ap_id                  = msg->gnb_cu_mbs_f1ap_id;
+  resp->gnb_du_mbs_f1ap_id                  = msg->gnb_du_mbs_f1ap_id;
+  resp->mbs_multicast_f1_u_context_descriptor = msg->mbs_multicast_f1_u_context_descriptor;
+  resp->multicast_f1_u_context_ref_cu       = msg->mbs_multicast_f1_u_context_descriptor.multicast_f1_u_context_ref_f1;
+
+  std::vector<std::string> bound_dist_keys;
+  const auto cleanup_bound_contexts = [this, &bound_dist_keys, &context_ref]() {
+    for (const std::string& dist_key : bound_dist_keys) {
+      auto ngu_receiver = mbs_ngu_receivers.find(dist_key);
+      if (ngu_receiver != mbs_ngu_receivers.end()) {
+        ngu_receiver->second->stop();
+        mbs_ngu_receivers.erase(ngu_receiver);
+        mbs_f1u_distribution_contexts.erase(dist_key);
+        continue;
+      }
+      auto demux_session = mbs_f1u_demux_sessions.find(dist_key);
+      if (demux_session != mbs_f1u_demux_sessions.end()) {
+        demux_session->second->stop();
+        mbs_f1u_demux_sessions.erase(demux_session);
+      } else {
+        auto dist_context = mbs_f1u_distribution_contexts.find(dist_key);
+        if (dist_context != mbs_f1u_distribution_contexts.end()) {
+          mbs_f1u_router->unbind_context({context_ref, dist_context->second.mrb_id});
+        }
+      }
+      mbs_f1u_distribution_contexts.erase(dist_key);
+    }
+  };
+
+  // An IPv4 multicast traffic source (224.0.0.0/4) indicates an integrated gNB that ingests the MB-UPF NG-U shared
+  // stream directly, rather than receiving the MRB over a unicast F1-U leg from a separate CU-UP.
+  const auto is_ipv4_multicast = [](const up_transport_layer_info& tnl) {
+    span<const uint8_t> bytes = tnl.tp_address.to_bytes();
+    return bytes.size() == 4 and (bytes[0] & 0xf0U) == 0xe0U;
+  };
+
+  for (uint32_t i = 0; i != msg->multicast_f1_u_context_to_be_setup_list.size(); ++i) {
+    const auto& req_item = msg->multicast_f1_u_context_to_be_setup_list[i]
+                               ->multicast_f1_u_context_to_be_setup_item();
+    const f1u_mbs_context_id router_id{context_ref, req_item.mrb_id};
+    const up_transport_layer_info peer_tunnel = asn1_to_up_transport_layer_info(req_item.mbs_f1u_info_at_du);
+
+    const auto data_handler = [this, session_key = context->first, mrb_id = req_item.mrb_id](nru_dl_message dl_msg) {
+      f1ap_du_mbs_data_request request;
+      request.session_key = session_key;
+      request.mrb_id      = mrb_id;
+      request.pdu         = std::move(dl_msg.t_pdu);
+      du_mng.on_mbs_data_pdu(std::move(request));
+    };
+
+    const std::string dist_key = make_mbs_f1u_context_key(context_ref, req_item.mrb_id);
+    if (is_ipv4_multicast(peer_tunnel)) {
+      // Integrated gNB: join the MB-UPF NG-U shared multicast group and feed the decapsulated T-PDUs into the MTCH.
+      if (mbs_f1u_exec == nullptr) {
+        logger.warning("MBS session={}: Cannot set up NG-U multicast ingress ref={} mrb={}. Cause: no F1-U executor",
+                       context->first,
+                       context_ref,
+                       req_item.mrb_id);
+        cleanup_bound_contexts();
+        send_distribution_setup_failure(cause_radio_network_opts::unspecified);
+        return;
+      }
+
+      mbs_ngu_receiver_config ngu_cfg;
+      ngu_cfg.multicast_group = peer_tunnel.tp_address.to_string();
+      ngu_cfg.port            = GTPU_PORT;
+      ngu_cfg.teid            = peer_tunnel.gtp_teid;
+
+      auto tpdu_handler = [data_handler](byte_buffer t_pdu) {
+        nru_dl_message dl_msg;
+        dl_msg.t_pdu = std::move(t_pdu);
+        data_handler(std::move(dl_msg));
+      };
+
+      auto receiver = std::make_unique<mbs_ngu_receiver>(std::move(ngu_cfg), *mbs_f1u_exec, std::move(tpdu_handler));
+      if (not receiver->start()) {
+        logger.warning("MBS session={}: Failed to start NG-U multicast ingress ref={} mrb={} group={}",
+                       context->first,
+                       context_ref,
+                       req_item.mrb_id,
+                       peer_tunnel.tp_address.to_string());
+        cleanup_bound_contexts();
+        send_distribution_setup_failure(cause_radio_network_opts::unspecified);
+        return;
+      }
+      mbs_ngu_receivers[dist_key] = std::move(receiver);
+
+      resp->multicast_f1_u_context_setup_list.push_back({});
+      auto& resp_ie = resp->multicast_f1_u_context_setup_list.back();
+      resp_ie.load_info_obj(ASN1_F1AP_ID_MULTICAST_F1_U_CONTEXT_SETUP_ITEM);
+      auto& resp_item  = resp_ie->multicast_f1_u_context_setup_item();
+      resp_item.mrb_id = req_item.mrb_id;
+      // The DU ingests the shared multicast tunnel directly, so it echoes the same tunnel back as the CU endpoint.
+      resp_item.mbs_f1u_info_at_cu = req_item.mbs_f1u_info_at_du;
+
+      mbs_f1u_distribution_context dist_context;
+      dist_context.session_key = context->first;
+      dist_context.mrb_id      = req_item.mrb_id;
+      dist_context.du_f1u_info = req_item.mbs_f1u_info_at_du;
+      dist_context.cu_f1u_info = resp_item.mbs_f1u_info_at_cu;
+      mbs_f1u_distribution_contexts[dist_key] = std::move(dist_context);
+      bound_dist_keys.push_back(dist_key);
+      continue;
+    }
+    if (mbs_demux_ctrl != nullptr and mbs_f1u_exec != nullptr) {
+      auto session =
+          std::make_unique<f1u_mbs_demux_session>(*mbs_f1u_router, *mbs_demux_ctrl, *mbs_f1u_exec, router_id);
+      f1u_mbs_demux_bind_result bind_result =
+          session->bind(get_mbs_f1u_local_addr(), peer_tunnel, data_handler);
+      if (bind_result != f1u_mbs_demux_bind_result::success) {
+        logger.warning("MBS session={}: Failed to bind multicast F1-U demux ref={} mrb={} result={}",
+                       context->first,
+                       context_ref,
+                       req_item.mrb_id,
+                       static_cast<unsigned>(bind_result));
+        cleanup_bound_contexts();
+        send_distribution_setup_failure(cause_radio_network_opts::unspecified);
+        return;
+      }
+      mbs_f1u_demux_sessions[dist_key] = std::move(session);
+    } else {
+      f1u_mbs_bind_result bind_result =
+          mbs_f1u_router->bind_context(router_id, get_mbs_f1u_local_addr(), peer_tunnel, data_handler);
+      if (bind_result != f1u_mbs_bind_result::success) {
+        logger.warning("MBS session={}: Failed to bind multicast F1-U ref={} mrb={} result={}",
+                       context->first,
+                       context_ref,
+                       req_item.mrb_id,
+                       static_cast<unsigned>(bind_result));
+        cleanup_bound_contexts();
+        send_distribution_setup_failure(cause_radio_network_opts::unspecified);
+        return;
+      }
+    }
+
+    const std::optional<f1u_mbs_tunnel_info> tunnel_info = mbs_f1u_router->get_tunnel_info(router_id);
+    ocudu_assert(tunnel_info.has_value(), "MBS F1-U router returned success but no tunnel info");
+
+    resp->multicast_f1_u_context_setup_list.push_back({});
+    auto& resp_ie = resp->multicast_f1_u_context_setup_list.back();
+    resp_ie.load_info_obj(ASN1_F1AP_ID_MULTICAST_F1_U_CONTEXT_SETUP_ITEM);
+    auto& resp_item  = resp_ie->multicast_f1_u_context_setup_item();
+    resp_item.mrb_id = req_item.mrb_id;
+    up_transport_layer_info_to_asn1(resp_item.mbs_f1u_info_at_cu, tunnel_info->local);
+
+    mbs_f1u_distribution_context dist_context;
+    dist_context.session_key  = context->first;
+    dist_context.mrb_id       = req_item.mrb_id;
+    dist_context.du_f1u_info  = req_item.mbs_f1u_info_at_du;
+    dist_context.cu_f1u_info  = resp_item.mbs_f1u_info_at_cu;
+    mbs_f1u_distribution_contexts[dist_key] = std::move(dist_context);
+    bound_dist_keys.push_back(dist_key);
+  }
+
+  logger.info("MBS session={}: Accepted multicast distribution setup ref={} mrbs={}",
+              context->first,
+              context_ref,
+              msg->multicast_f1_u_context_to_be_setup_list.size());
+  tx_pdu_notifier->on_new_message(resp_msg);
+}
+
+void f1ap_du_impl::handle_multicast_distribution_release_command(
+    const asn1::f1ap::multicast_distribution_release_cmd_s& msg)
+{
+  auto context = std::find_if(mbs_contexts.begin(), mbs_contexts.end(), [&msg](const auto& entry) {
+    return entry.second.cu_mbs_f1ap_id == msg->gnb_cu_mbs_f1ap_id and
+           entry.second.du_mbs_f1ap_id == msg->gnb_du_mbs_f1ap_id;
+  });
+
+  if (context == mbs_contexts.end()) {
+    logger.warning(
+        "cu_mbs_f1ap_id={} du_mbs_f1ap_id={}: Ignoring multicast distribution release. Cause: MBS context not found",
+        msg->gnb_cu_mbs_f1ap_id,
+        msg->gnb_du_mbs_f1ap_id);
+    return;
+  }
+
+  const std::string context_ref =
+      msg->mbs_multicast_f1_u_context_descriptor.multicast_f1_u_context_ref_f1.to_string();
+  const std::string key_prefix = context_ref + ":";
+  unsigned          nof_erased = 0;
+  for (auto it = mbs_f1u_distribution_contexts.begin(); it != mbs_f1u_distribution_contexts.end();) {
+    if (it->first.rfind(key_prefix, 0) == 0 and it->second.session_key == context->first) {
+      auto ngu_receiver = mbs_ngu_receivers.find(it->first);
+      if (ngu_receiver != mbs_ngu_receivers.end()) {
+        ngu_receiver->second->stop();
+        mbs_ngu_receivers.erase(ngu_receiver);
+      } else {
+        auto demux_session = mbs_f1u_demux_sessions.find(it->first);
+        if (demux_session != mbs_f1u_demux_sessions.end()) {
+          demux_session->second->stop();
+          mbs_f1u_demux_sessions.erase(demux_session);
+        } else {
+          mbs_f1u_router->unbind_context({context_ref, it->second.mrb_id});
+        }
+      }
+      it = mbs_f1u_distribution_contexts.erase(it);
+      ++nof_erased;
+    } else {
+      ++it;
+    }
+  }
+
+  f1ap_message resp_msg;
+  resp_msg.pdu.set_successful_outcome().load_info_obj(ASN1_F1AP_ID_MULTICAST_DISTRIBUTION_RELEASE);
+  auto& resp = resp_msg.pdu.successful_outcome().value.multicast_distribution_release_complete();
+
+  resp->gnb_cu_mbs_f1ap_id                    = msg->gnb_cu_mbs_f1ap_id;
+  resp->gnb_du_mbs_f1ap_id                    = msg->gnb_du_mbs_f1ap_id;
+  resp->mbs_multicast_f1_u_context_descriptor = msg->mbs_multicast_f1_u_context_descriptor;
+
+  logger.info("MBS session={}: Released multicast distribution ref={} mrbs={}",
+              context->first,
+              context_ref,
+              nof_erased);
+  tx_pdu_notifier->on_new_message(resp_msg);
+}
+
+void f1ap_du_impl::handle_mbs_f1u_data(f1ap_du_mbs_f1u_data_indication indication)
+{
+  const std::string key = make_mbs_f1u_context_key(indication.multicast_f1u_context_ref, indication.mrb_id);
+  auto              it  = mbs_f1u_distribution_contexts.find(key);
+  if (it == mbs_f1u_distribution_contexts.end()) {
+    logger.warning("Discarding multicast F1-U PDU ref={} mrb={}. Cause: distribution context not found",
+                   indication.multicast_f1u_context_ref,
+                   indication.mrb_id);
+    return;
+  }
+  if (indication.nru.t_pdu.empty()) {
+    logger.debug("Discarding multicast F1-U PDU ref={} mrb={}. Cause: empty T-PDU",
+                 indication.multicast_f1u_context_ref,
+                 indication.mrb_id);
+    return;
+  }
+
+  if (not mbs_f1u_router->route_dl_pdu({indication.multicast_f1u_context_ref, indication.mrb_id},
+                                       std::move(indication.nru))) {
+    logger.warning("Discarding multicast F1-U PDU ref={} mrb={}. Cause: router binding not found",
+                   indication.multicast_f1u_context_ref,
+                   indication.mrb_id);
+  }
+}
