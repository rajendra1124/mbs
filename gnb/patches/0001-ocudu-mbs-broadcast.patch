+static bool unpack_multicast_session_deactivation_request_transfer(
+    multicast_session_deactivation_request_transfer_s& out,
+    const asn1::unbounded_octstring<true>&             transfer)
+{
+  asn1::cbit_ref bref(transfer);
+  return out.unpack(bref) == asn1::OCUDUASN_SUCCESS;
+}
+
+static bool unpack_multicast_session_update_request_transfer(multicast_session_upd_request_transfer_s& out,
+                                                            const asn1::unbounded_octstring<true>&    transfer)
+{
+  asn1::cbit_ref bref(transfer);
+  return out.unpack(bref) == asn1::OCUDUASN_SUCCESS;
+}
+
+static bool unpack_mbs_session_setup_request_transfer(mbs_session_setup_or_mod_request_transfer_s& out,
+                                                      const asn1::unbounded_octstring<true>&       transfer)
+{
+  asn1::cbit_ref bref(transfer);
+  return out.unpack(bref) == asn1::OCUDUASN_SUCCESS;
+}
+
+static cu_cp_mbs_session_id make_cu_cp_mbs_session_id(const mbs_session_id_s& session_id)
+{
+  cu_cp_mbs_session_id out;
+  out.tmgi = session_id.tmgi.to_string();
+  if (session_id.nid_present) {
+    out.nid = session_id.nid.to_string();
+  }
+  return out;
+}
+
+static bool is_valid_mbs_session_update_transfer(const multicast_session_upd_request_transfer_s& transfer)
+{
+  return transfer->mbs_service_area_present or transfer->mbs_qos_flows_to_be_setup_mod_list_present or
+         transfer->mbs_session_tnl_info5_gc_present or transfer->mbs_qos_flow_to_release_list_present;
+}
+
+static std::vector<uint8_t> make_cu_cp_mbs_qos_flow_ids(const mbs_qos_flows_to_be_setup_list_l& flows)
+{
+  std::vector<uint8_t> qos_flow_ids;
+  qos_flow_ids.reserve(flows.size());
+  for (const auto& flow : flows) {
+    if (std::find(qos_flow_ids.begin(), qos_flow_ids.end(), flow.mb_sqos_flow_id) == qos_flow_ids.end()) {
+      qos_flow_ids.push_back(flow.mb_sqos_flow_id);
+    }
+  }
+  return qos_flow_ids;
+}
+
+static up_transport_layer_info make_cu_cp_mbs_ngu_tnl_info(const shared_ngu_multicast_tnl_info_s& tnl_info)
+{
+  return {tla_from_asn1_bitstring(tnl_info.ip_multicast_address),
+          int_to_gtpu_teid(tnl_info.gtp_teid.to_number())};
+}
+
+static std::optional<up_transport_layer_info>
+make_cu_cp_mbs_ngu_tnl_info(const mbs_session_tnl_info5_gc_c& tnl_info, std::optional<uint32_t> area_session_id)
+{
+  switch (tnl_info.type().value) {
+    case mbs_session_tnl_info5_gc_c::types_opts::locationindependent:
+      return make_cu_cp_mbs_ngu_tnl_info(tnl_info.locationindependent());
+    case mbs_session_tnl_info5_gc_c::types_opts::locationdependent: {
+      const auto& items = tnl_info.locationdependent();
+      if (items.size() == 0) {
+        return std::nullopt;
+      }
+      if (area_session_id.has_value()) {
+        const auto item = std::find_if(items.begin(), items.end(), [area_session_id](const auto& tnl_item) {
+          return tnl_item.mbs_area_session_id == area_session_id.value();
+        });
+        if (item != items.end()) {
+          return make_cu_cp_mbs_ngu_tnl_info(item->shared_ngu_multicast_tnl_info);
+        }
+      }
+      return make_cu_cp_mbs_ngu_tnl_info(items[0].shared_ngu_multicast_tnl_info);
+    }
+    default:
+      return std::nullopt;
+  }
+}
