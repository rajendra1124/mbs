+void scheduler_impl::handle_mbs_context_setup(const sched_mbs_context_setup_request& request)
+{
+  mbs_contexts[request.session_key] = request;
+  for (auto& cell : cells) {
+    cell->handle_mbs_context_setup(request);
+  }
+  logger.info("MBS session={}: scheduler stored MCCH/MTCH context mcch_rnti={} mtch_rnti={} mrbs={}",
+              request.session_key,
+              request.mcch_rnti,
+              request.mtch_rnti,
+              request.mrb_ids.size());
+}
+
+void scheduler_impl::handle_mbs_context_release(const sched_mbs_context_release_request& request)
+{
+  const auto nof_erased = mbs_contexts.erase(request.session_key);
+  for (auto& cell : cells) {
+    cell->handle_mbs_context_release(request);
+  }
+  logger.info("MBS session={}: scheduler released MCCH/MTCH context cu_mbs_f1ap_id={} du_mbs_f1ap_id={} found={}",
+              request.session_key,
+              request.gnb_cu_mbs_f1ap_id,
+              request.gnb_du_mbs_f1ap_id,
+              nof_erased != 0);
+}
+
+void scheduler_impl::handle_mbs_buffer_state_update(const sched_mbs_buffer_state_indication& bs)
+{
+  if (mbs_contexts.find(bs.session_key) == mbs_contexts.end()) {
+    return;
+  }
+  for (auto& cell : cells) {
+    cell->handle_mbs_buffer_state_update(bs);
+  }
+}
