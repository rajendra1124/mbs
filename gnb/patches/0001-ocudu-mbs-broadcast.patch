+e1ap_mbs_bearer_context_modification_response
+cu_up_manager_impl::handle_mbs_bearer_context_modification_request(
+    const e1ap_mbs_bearer_context_modification_request& msg)
+{
+  e1ap_mbs_bearer_context_modification_response response = {};
+  response.cu_cp_mbs_e1ap_id                             = msg.cu_cp_mbs_e1ap_id;
+  response.cu_up_mbs_e1ap_id                             = msg.cu_up_mbs_e1ap_id;
+
+  auto context_it = mbs_contexts.find(msg.cu_up_mbs_e1ap_id);
+  if (context_it == mbs_contexts.end()) {
+    logger.warning("MBS CU-CP-E1AP-ID={}: CU-UP received modification for unknown CU-UP-MBS-E1AP-ID={}",
+                   msg.cu_cp_mbs_e1ap_id,
+                   msg.cu_up_mbs_e1ap_id);
+    return response;
+  }
+
+  auto& context = context_it->second;
+  if (msg.ngu_tnl_info.has_value()) {
+    context.ngu_tnl_info = msg.ngu_tnl_info;
+  }
+  for (uint16_t mrb_id : msg.mrb_to_remove_list) {
+    context.mrb_list.erase(std::remove_if(context.mrb_list.begin(),
+                                          context.mrb_list.end(),
+                                          [mrb_id](const e1ap_mbs_mrb_item& item) { return item.mrb_id == mrb_id; }),
+                           context.mrb_list.end());
+  }
+
+  for (const auto& mrb : msg.mrb_to_setup_modify_list) {
+    auto mrb_it = std::find_if(context.mrb_list.begin(),
+                               context.mrb_list.end(),
+                               [&mrb](const e1ap_mbs_mrb_item& item) { return item.mrb_id == mrb.mrb_id; });
+    if (mrb_it == context.mrb_list.end()) {
+      context.mrb_list.push_back(mrb);
+    } else {
+      *mrb_it = mrb;
+    }
+  }
+
+  response.success                    = true;
+  response.mrb_setup_modify_resp_list = msg.mrb_to_setup_modify_list;
+  logger.info("MBS CU-CP-E1AP-ID={}: CU-UP modified multicast bearer context CU-UP-MBS-E1AP-ID={} "
+              "nof_setup_modify_mrbs={} nof_remove_mrbs={} nof_context_mrbs={}",
+              msg.cu_cp_mbs_e1ap_id,
+              msg.cu_up_mbs_e1ap_id,
+              msg.mrb_to_setup_modify_list.size(),
+              msg.mrb_to_remove_list.size(),
+              context.mrb_list.size());
+  return response;
+}
