+e1ap_mbs_bearer_context_setup_response
+cu_up_manager_impl::handle_mbs_bearer_context_setup_request(const e1ap_mbs_bearer_context_setup_request& msg)
+{
+  e1ap_mbs_bearer_context_setup_response response = {};
+  response.cu_cp_mbs_e1ap_id                      = msg.cu_cp_mbs_e1ap_id;
+
+  e1ap_mbs_bearer_context context;
+  context.cu_cp_mbs_e1ap_id = msg.cu_cp_mbs_e1ap_id;
+  context.cu_up_mbs_e1ap_id = next_cu_up_mbs_e1ap_id++;
+  context.session_id        = msg.session_id;
+  context.area_session_id   = msg.area_session_id;
+  context.mrb_list          = msg.mrb_to_setup_list;
+  context.ngu_tnl_info      = msg.ngu_tnl_info;
+
+  response.success             = true;
+  response.cu_up_mbs_e1ap_id   = context.cu_up_mbs_e1ap_id;
+  response.mrb_setup_resp_list = context.mrb_list;
+
+  mbs_contexts[context.cu_up_mbs_e1ap_id] = std::move(context);
+
+  logger.info("MBS CU-CP-E1AP-ID={}: CU-UP stored multicast bearer context CU-UP-MBS-E1AP-ID={} nof_mrbs={}",
+              msg.cu_cp_mbs_e1ap_id,
+              response.cu_up_mbs_e1ap_id,
+              response.mrb_setup_resp_list.size());
+  if (msg.ngu_tnl_info.has_value()) {
+    logger.info("MBS CU-CP-E1AP-ID={}: CU-UP stored NG-U multicast tunnel {}",
+                msg.cu_cp_mbs_e1ap_id,
+                msg.ngu_tnl_info.value());
+  }
+  return response;
+}
+
+e1ap_mbs_bearer_context_release_complete
+cu_up_manager_impl::handle_mbs_bearer_context_release_command(const e1ap_mbs_bearer_context_release_command& msg)
+{
+  e1ap_mbs_bearer_context_release_complete complete;
+  complete.cu_cp_mbs_e1ap_id = msg.cu_cp_mbs_e1ap_id;
+  complete.cu_up_mbs_e1ap_id = msg.cu_up_mbs_e1ap_id;
+
+  const size_t erased = mbs_contexts.erase(msg.cu_up_mbs_e1ap_id);
+  if (erased == 0) {
+    logger.warning("MBS CU-CP-E1AP-ID={}: CU-UP received release for unknown CU-UP-MBS-E1AP-ID={}",
+                   msg.cu_cp_mbs_e1ap_id,
+                   msg.cu_up_mbs_e1ap_id);
+  } else {
+    logger.info("MBS CU-CP-E1AP-ID={}: CU-UP released multicast bearer context CU-UP-MBS-E1AP-ID={}",
+                msg.cu_cp_mbs_e1ap_id,
+                msg.cu_up_mbs_e1ap_id);
+  }
+  return complete;
+}
