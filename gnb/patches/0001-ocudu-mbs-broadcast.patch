+byte_buffer asn1_packer::pack_sib20(const sib20_info& sib20_params, std::string* js_str)
+{
+  byte_buffer               buf;
+  asn1::bit_ref             bref{buf};
+  asn1::rrc_nr::sib20_r17_s sib20 = make_asn1_rrc_cell_sib20(sib20_params);
+  asn1::OCUDUASN_CODE       ret   = sib20.pack(bref);
+  ocudu_assert(ret == asn1::OCUDUASN_SUCCESS, "Failed to pack SIB20");
+
+  if (js_str != nullptr) {
+    asn1::json_writer js;
+    sib20.to_json(js);
+    *js_str = js.to_string();
+  }
+  return buf;
+}
