+void mac_cell_processor::handle_mbs_context_setup(const mac_mbs_context_setup_request& request)
+{
+  defer_until_success(cell_exec, timers, [this, request]() {
+    // The G-RNTI pool is finite and reused across sessions (see derive_mtch_g_rnti()). If the core network never
+    // signalled release of an older session (some CN test images skip session release entirely), evict it here so
+    // its RLC/PDCP entities are torn down before a new session reuses the same G-RNTI.
+    for (auto it = mbs_contexts.begin(); it != mbs_contexts.end();) {
+      if (it->first != request.session_key and it->second.setup.mtch_rnti == request.mtch_rnti) {
+        logger.warning(
+            "cell={}: Evicting stale MBS session={} reusing rnti={}. Cause: new session={} was assigned the same "
+            "G-RNTI",
+            fmt::underlying(cell_cfg.cell_index),
+            it->first,
+            request.mtch_rnti,
+            request.session_key);
+        it = mbs_contexts.erase(it);
+      } else {
+        ++it;
+      }
+    }
+
+    auto& ctx = mbs_contexts[request.session_key];
+    mac_mbs_context_setup_request old_setup = ctx.setup;
+    ctx.setup = request;
+    for (auto it = ctx.mrbs.begin(); it != ctx.mrbs.end();) {
+      const bool removed = std::find(request.mrb_ids.begin(), request.mrb_ids.end(), it->first) == request.mrb_ids.end();
+      const bool config_changed =
+          not removed and not mbs_mrb_configs_equal(get_mbs_mrb_config_or_default(request, it->first),
+                                                    get_mbs_mrb_config_or_default(old_setup, it->first));
+      if (removed or config_changed) {
+        it = ctx.mrbs.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    for (uint16_t mrb_id : request.mrb_ids) {
+      ctx.mrbs.try_emplace(
+          mrb_id,
+          mrb_id,
+          get_mbs_mrb_config_or_default(request, mrb_id),
+          timers,
+          cell_exec,
+          cell_exec,
+          [this, session_key = request.session_key, mrb_id](const rlc_buffer_state& bs) {
+            sched.handle_mbs_buffer_state_update({session_key, mrb_id, bs.pending_bytes});
+          });
+      sched.handle_mbs_buffer_state_update({request.session_key, mrb_id, 0});
+    }
+    logger.info("cell={}: MBS radio context installed. session={} mcch-rnti={} mtch-rnti={} nof-mrbs={}",
+                fmt::underlying(cell_cfg.cell_index),
+                request.session_key,
+                request.mcch_rnti,
+                request.mtch_rnti,
+                request.mrb_ids.size());
+  });
+}
+
+void mac_cell_processor::handle_mbs_context_release(const mac_mbs_context_release_request& request)
+{
+  defer_until_success(cell_exec, timers, [this, request]() {
+    mbs_contexts.erase(request.session_key);
+    logger.info("cell={}: MBS radio context released. session={}",
+                fmt::underlying(cell_cfg.cell_index),
+                request.session_key);
+  });
+}
+
+void mac_cell_processor::handle_mbs_data_pdu(mac_mbs_data_indication msg)
+{
+  defer_until_success(cell_exec, timers, [this, msg = std::move(msg)]() mutable {
+    auto ctx_it = mbs_contexts.find(msg.session_key);
+    if (ctx_it == mbs_contexts.end()) {
+      logger.warning("cell={}: Dropping MBS MTCH PDU for unknown session={}",
+                     fmt::underlying(cell_cfg.cell_index),
+                     msg.session_key);
+      return;
+    }
+    auto mrb_it = ctx_it->second.mrbs.find(msg.mrb_id);
+    if (mrb_it == ctx_it->second.mrbs.end()) {
+      logger.warning("cell={}: Dropping MBS MTCH PDU for unknown MRB. session={} mrb={}",
+                     fmt::underlying(cell_cfg.cell_index),
+                     msg.session_key,
+                     msg.mrb_id);
+      return;
+    }
+    mrb_it->second.push_sdu(std::move(msg.pdu));
+    sched.handle_mbs_buffer_state_update({ctx_it->first, msg.mrb_id, mrb_it->second.pending()});
+  });
+}
