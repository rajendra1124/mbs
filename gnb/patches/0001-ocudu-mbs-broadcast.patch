+void cell_scheduler::handle_mbs_context_setup(const sched_mbs_context_setup_request& request)
+{
+  // The G-RNTI pool is finite and reused across sessions (see derive_mtch_g_rnti()). If the core network never
+  // signalled release of an older session (some CN test images skip session release entirely), evict it here so two
+  // live MBS contexts never contend for the same G-RNTI's PDCCH/PDSCH resources.
+  for (auto it = mbs_contexts.begin(); it != mbs_contexts.end();) {
+    if (it->first != request.session_key and it->second.setup.mtch_rnti == request.mtch_rnti) {
+      logger.warning("Evicting stale MBS session={} reusing rnti={}. Cause: new session={} was assigned the same G-RNTI",
+                     it->first,
+                     request.mtch_rnti,
+                     request.session_key);
+      it = mbs_contexts.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  auto& ctx = mbs_contexts[request.session_key];
+  ctx.setup = request;
+  for (uint16_t mrb_id : request.mrb_ids) {
+    ctx.mrb_pending_bytes.try_emplace(mrb_id, 0U);
+  }
+}
+
+void cell_scheduler::handle_mbs_context_release(const sched_mbs_context_release_request& request)
+{
+  mbs_contexts.erase(request.session_key);
+}
