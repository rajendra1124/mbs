+byte_buffer mac_cell_processor::encode_mbs_mcch_pdu(const dl_mbs_allocation& mbs) const
+{
+  using namespace asn1::rrc_nr;
+
+  mcch_msg_r17_s mcch;
+  auto&          cfg = mcch.msg.set_c1().set_mbs_broadcast_cfg_r17().crit_exts.set_mbs_broadcast_cfg_r17();
+
+  const auto ctx_it = mbs_contexts.find(mbs.session_key);
+  const std::vector<uint16_t>* mrb_ids =
+      ctx_it == mbs_contexts.end() ? nullptr : &ctx_it->second.setup.mrb_ids;
+  const mac_mbs_context_setup_request* setup = ctx_it == mbs_contexts.end() ? nullptr : &ctx_it->second.setup;
+
+  cfg.mbs_session_info_list_r17.push_back(mbs_session_info_r17_s{});
+  mbs_session_info_r17_s& session = cfg.mbs_session_info_list_r17.back();
+  session.mbs_session_id_r17.plmn_id_r17.set_plmn_idx() = 1;
+  session.mbs_session_id_r17.service_id_r17.from_string(make_mbs_service_id_hex(mbs.session_key));
+  session.g_rnti_r17                         = to_value(mbs.pdsch_cfg.rnti);
+  session.mtch_sched_info_r17_present        = true;
+  session.mtch_sched_info_r17                = 0;
+  session.pdsch_cfg_idx_r17_present          = true;
+  session.pdsch_cfg_idx_r17                  = 0;
+  session.mtch_ssb_map_win_idx_r17_present   = true;
+  session.mtch_ssb_map_win_idx_r17           = 0;
+
+  if (mrb_ids == nullptr or mrb_ids->empty()) {
+    session.mrb_list_broadcast_r17.push_back(mrb_info_broadcast_r17_s{});
+    mac_mbs_mrb_config mrb_cfg;
+    mrb_cfg.mrb_id = mbs.mrb_id;
+    fill_mbs_broadcast_mrb_info(session.mrb_list_broadcast_r17.back(), mrb_cfg);
+  } else {
+    const unsigned nof_mrbs = std::min<unsigned>(mrb_ids->size(), 4U);
+    for (unsigned i = 0; i != nof_mrbs; ++i) {
+      session.mrb_list_broadcast_r17.push_back(mrb_info_broadcast_r17_s{});
+      fill_mbs_broadcast_mrb_info(session.mrb_list_broadcast_r17.back(),
+                                  get_mbs_mrb_config_or_default(*setup, (*mrb_ids)[i]));
+    }
+  }
+
+  byte_buffer   pdu;
+  asn1::bit_ref bref{pdu};
+  if (mcch.pack(bref) != asn1::OCUDUASN_SUCCESS) {
+    logger.error("Failed to ASN.1 encode MCCH-Message-r17 for MBS session={}", mbs.session_key);
+    return byte_buffer{};
+  }
+  return pdu;
+}
+
+byte_buffer mac_cell_processor::encode_mbs_mtch_pdu(const dl_mbs_allocation& mbs, size_t tbs_bytes)
+{
+  auto ctx_it = mbs_contexts.find(mbs.session_key);
+  if (ctx_it == mbs_contexts.end()) {
+    logger.warning("No MBS context for scheduled MTCH session={}", mbs.session_key);
+    return byte_buffer{};
+  }
+
+  auto mrb_it = ctx_it->second.mrbs.find(mbs.mrb_id);
+  if (mrb_it == ctx_it->second.mrbs.end() or mrb_it->second.empty()) {
+    logger.debug("No queued MTCH payload for MBS session={} mrb={}", mbs.session_key, mbs.mrb_id);
+    return byte_buffer{};
+  }
+
+  byte_buffer pdu = mrb_it->second.pull_pdu(tbs_bytes);
+  sched.handle_mbs_buffer_state_update({ctx_it->first, mbs.mrb_id, mrb_it->second.pending()});
+  return pdu;
+}
