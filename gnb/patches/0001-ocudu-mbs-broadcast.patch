+static e1ap_mbs_session_id make_mbs_session_id(const global_mbs_session_id_s& asn1_session_id)
+{
+  e1ap_mbs_session_id session_id;
+  session_id.tmgi = asn1_session_id.tmgi.to_string();
+  if (asn1_session_id.nid_present) {
+    session_id.nid = asn1_session_id.nid.to_string();
+  }
+  return session_id;
