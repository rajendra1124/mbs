+{
+  std::vector<uint16_t> mrb_ids;
+  mrb_ids.reserve(mrb_setup_list.size());
+  for (const auto& mrb : mrb_setup_list) {
+    mrb_ids.push_back(mrb->multicast_m_rbs_setup_item().mrb_id);
