+void ngap_impl::handle_multicast_session_activation_request(
+    const asn1::ngap::multicast_session_activation_request_s& msg)
+{
+  const std::string key = make_mbs_session_key(msg->mbs_session_id);
+
+  multicast_session_activation_request_transfer_s transfer;
+  if (!unpack_multicast_session_activation_request_transfer(transfer,
+                                                            msg->multicast_session_activation_request_transfer)) {
+    logger.warning("MBS session={}: Dropping MulticastSessionActivationRequest. Cannot unpack request transfer", key);
+    send_multicast_session_activation_failure(msg->mbs_session_id, cause_radio_network_opts::options::unspecified);
+    return;
+  }
+
+  if (make_mbs_session_key(transfer.mbs_session_id) != key) {
+    logger.warning("MBS session={}: Rejecting MulticastSessionActivationRequest. Transfer MBS Session ID mismatch", key);
+    send_multicast_session_activation_failure(msg->mbs_session_id, cause_radio_network_opts::options::unspecified);
+    return;
+  }
+
+  auto session = mbs_sessions.find(key);
+  if (session == mbs_sessions.end()) {
+    logger.warning("MBS session={}: Rejecting activation. Session resources were not created by an update request", key);
+    send_multicast_session_activation_failure(msg->mbs_session_id,
+                                              cause_radio_network_opts::options::unknown_mbs_session_id);
+    return;
+  }
+
+  if (not session->second.has_qos_flows or not session->second.has_ng_u_tnl_info) {
+    logger.warning(
+        "MBS session={}: Rejecting activation. Cause: missing mandatory QoS flow or 5GC multicast tunnel context",
+        key);
+    send_multicast_session_activation_failure(
+        msg->mbs_session_id, cause_radio_network_opts::options::no_radio_res_available_in_target_cell);
+    return;
+  }
+
+  session->second.active = true;
+  cu_cp_notifier.on_mbs_session_activation_request({make_cu_cp_mbs_session_id(msg->mbs_session_id)});
+  logger.info("MBS session={}: Activated multicast session resources", key);
+  send_multicast_session_activation_response(msg->mbs_session_id);
+}
+
+void ngap_impl::handle_multicast_session_deactivation_request(
+    const asn1::ngap::multicast_session_deactivation_request_s& msg)
+{
+  const std::string key = make_mbs_session_key(msg->mbs_session_id);
+
+  multicast_session_deactivation_request_transfer_s transfer;
+  if (!unpack_multicast_session_deactivation_request_transfer(transfer,
+                                                              msg->multicast_session_deactivation_request_transfer)) {
+    logger.warning("MBS session={}: Dropping MulticastSessionDeactivationRequest. Cannot unpack request transfer", key);
+    return;
+  }
+
+  if (make_mbs_session_key(transfer.mbs_session_id) != key) {
+    logger.warning("MBS session={}: Ignoring MulticastSessionDeactivationRequest. Transfer MBS Session ID mismatch", key);
+    return;
+  }
+
+  auto session = mbs_sessions.find(key);
+  if (session != mbs_sessions.end()) {
+    session->second.active = false;
+  }
+
+  cu_cp_notifier.on_mbs_session_deactivation_request({make_cu_cp_mbs_session_id(msg->mbs_session_id)});
+  logger.info("MBS session={}: Deactivated multicast session resources", key);
+  send_multicast_session_deactivation_response(msg->mbs_session_id);
+}
+
+void ngap_impl::handle_multicast_session_update_request(const asn1::ngap::multicast_session_upd_request_s& msg)
+{
+  const std::string        key             = make_mbs_session_key(msg->mbs_session_id);
+  std::optional<uint32_t>  area_session_id = msg->mbs_area_session_id_present ? std::make_optional(msg->mbs_area_session_id)
+                                                                               : std::nullopt;
+
+  multicast_session_upd_request_transfer_s transfer;
+  if (!unpack_multicast_session_update_request_transfer(transfer, msg->multicast_session_upd_request_transfer)) {
+    logger.warning("MBS session={}: Dropping MulticastSessionUpdateRequest. Cannot unpack request transfer", key);
+    send_multicast_session_update_failure(
+        msg->mbs_session_id, area_session_id, cause_radio_network_opts::options::unspecified);
+    return;
+  }
+
+  if (make_mbs_session_key(transfer->mbs_session_id) != key) {
+    logger.warning("MBS session={}: Rejecting MulticastSessionUpdateRequest. Transfer MBS Session ID mismatch", key);
+    send_multicast_session_update_failure(
+        msg->mbs_session_id, area_session_id, cause_radio_network_opts::options::unspecified);
+    return;
+  }
+
+  if (not is_valid_mbs_session_update_transfer(transfer)) {
+    logger.warning("MBS session={}: Rejecting MulticastSessionUpdateRequest. Cause: empty update transfer", key);
+    send_multicast_session_update_failure(
+        msg->mbs_session_id, area_session_id, cause_radio_network_opts::options::no_radio_res_available_in_target_cell);
+    return;
+  }
+
+  mbs_session_context& session = mbs_sessions[key];
+  session.id                  = msg->mbs_session_id;
+  session.area_session_id     = area_session_id;
+  session.has_service_area    = transfer->mbs_service_area_present;
+  session.has_qos_flows       = transfer->mbs_qos_flows_to_be_setup_mod_list_present;
+  session.has_ng_u_tnl_info   = transfer->mbs_session_tnl_info5_gc_present;
+  session.has_released_flows  = transfer->mbs_qos_flow_to_release_list_present;
+  std::vector<uint8_t> qos_flow_ids =
+      transfer->mbs_qos_flows_to_be_setup_mod_list_present
+          ? make_cu_cp_mbs_qos_flow_ids(transfer->mbs_qos_flows_to_be_setup_mod_list)
+          : std::vector<uint8_t>{};
+  std::optional<up_transport_layer_info> ngu_tnl_info =
+      transfer->mbs_session_tnl_info5_gc_present
+          ? make_cu_cp_mbs_ngu_tnl_info(transfer->mbs_session_tnl_info5_gc, area_session_id)
+          : std::nullopt;
+
+  cu_cp_notifier.on_mbs_session_update_request({make_cu_cp_mbs_session_id(msg->mbs_session_id),
+                                                area_session_id,
+                                                qos_flow_ids,
+                                                transfer->mbs_service_area_present,
+                                                transfer->mbs_qos_flows_to_be_setup_mod_list_present,
+                                                transfer->mbs_session_tnl_info5_gc_present,
+                                                transfer->mbs_qos_flow_to_release_list_present,
+                                                ngu_tnl_info});
+
+  logger.info(
+      "MBS session={}: Updated multicast session context service_area={} qos_flows={} ngu_tnl={} released_flows={}",
+      key,
+      session.has_service_area,
+      session.has_qos_flows,
+      session.has_ng_u_tnl_info,
+      session.has_released_flows);
+  if (ngu_tnl_info.has_value()) {
+    logger.info("MBS session={}: NG-U multicast tunnel {}", key, ngu_tnl_info.value());
+  } else if (transfer->mbs_session_tnl_info5_gc_present) {
+    logger.warning("MBS session={}: NG-U multicast tunnel IE was present but could not be converted", key);
+  }
+  send_multicast_session_update_response(msg->mbs_session_id, area_session_id);
+}
+
+void ngap_impl::handle_multicast_group_paging(const asn1::ngap::multicast_group_paging_s& msg)
+{
+  const std::string key     = make_mbs_session_key(msg->mbs_session_id);
+  auto              session = mbs_sessions.find(key);
+  if (session == mbs_sessions.end()) {
+    logger.warning("MBS session={}: Ignoring MulticastGroupPaging. Cause: unknown MBS session", key);
+    return;
+  }
+  if (not session->second.active) {
+    logger.debug("MBS session={}: Ignoring MulticastGroupPaging. Cause: MBS session is inactive", key);
+    return;
+  }
+
+  cu_cp_notifier.on_mbs_group_paging_message(
+      {make_cu_cp_mbs_session_id(msg->mbs_session_id),
+       static_cast<unsigned>(msg->multicast_group_paging_area_list.size())});
+  logger.info("MBS session={}: Received MulticastGroupPaging for {} paging area entries",
+              key,
+              msg->multicast_group_paging_area_list.size());
+}
+
+void ngap_impl::handle_broadcast_session_setup_request(const asn1::ngap::broadcast_session_setup_request_s& msg)
+{
+  const std::string key = make_mbs_session_key(msg->mbs_session_id);
+
+  // The MBS Session ID (TMGI) is the mandatory element that identifies the broadcast session. The
+  // MBSSessionSetupRequestTransfer carries optional NG-U shared tunnel and QoS-flow information. Per TS 38.413,
+  // Section 8.13.1, a missing or unparseable transfer must not abort the broadcast session establishment: the gNB
+  // still sets up the radio bearer based on the TMGI. We therefore parse it best-effort and proceed either way.
+  std::optional<up_transport_layer_info> ngu_tnl_info;
+  std::vector<uint8_t>                   qos_flow_ids;
+  bool                                   has_qos_flows = false;
+
+  mbs_session_setup_or_mod_request_transfer_s transfer;
+  if (unpack_mbs_session_setup_request_transfer(transfer, msg->mbs_session_setup_request_transfer)) {
+    has_qos_flows = transfer->mbs_qos_flows_to_be_setup_mod_list.size() != 0;
+    if (has_qos_flows) {
+      qos_flow_ids = make_cu_cp_mbs_qos_flow_ids(transfer->mbs_qos_flows_to_be_setup_mod_list);
+    }
+    if (transfer->mbs_session_tnl_info5_gc_present) {
+      ngu_tnl_info = make_cu_cp_mbs_ngu_tnl_info(transfer->mbs_session_tnl_info5_gc, std::nullopt);
+      if (not ngu_tnl_info.has_value()) {
+        logger.warning("MBS session={}: BroadcastSessionSetupRequest NG-U TNL info present but not convertible", key);
+      }
+    }
+  } else {
+    logger.warning("MBS session={}: BroadcastSessionSetupRequest transfer ({} bytes) could not be unpacked; "
+                   "proceeding with TMGI-only broadcast setup",
+                   key,
+                   msg->mbs_session_setup_request_transfer.size());
+  }
+
+  mbs_session_context& session = mbs_sessions[key];
+  session.id                   = msg->mbs_session_id;
+  session.area_session_id      = std::nullopt;
+  session.has_qos_flows        = has_qos_flows;
+  session.has_ng_u_tnl_info    = ngu_tnl_info.has_value();
+  session.active               = true;
+
+  // A broadcast session reuses the common MBS session machinery: the session update request drives the E1AP
+  // multicast bearer context in the CU-UP and the F1AP multicast context + distribution setup in the DUs, which in
+  // turn create the MCCH/MTCH and G-RNTI resources for PTM delivery.
+  cu_cp_notifier.on_mbs_session_update_request({make_cu_cp_mbs_session_id(msg->mbs_session_id),
+                                                std::nullopt,
+                                                qos_flow_ids,
+                                                false,
+                                                session.has_qos_flows,
+                                                session.has_ng_u_tnl_info,
+                                                false,
+                                                ngu_tnl_info});
+  cu_cp_notifier.on_mbs_session_activation_request({make_cu_cp_mbs_session_id(msg->mbs_session_id)});
+
+  logger.info("MBS session={}: Established broadcast session qos_flows={} ngu_tnl={}",
+              key,
+              qos_flow_ids.size(),
+              session.has_ng_u_tnl_info);
+  if (ngu_tnl_info.has_value()) {
+    logger.info("MBS session={}: NG-U shared multicast tunnel {}", key, ngu_tnl_info.value());
+  }
+
+  send_broadcast_session_setup_response(msg->mbs_session_id);
+}
+
+void ngap_impl::handle_broadcast_session_release_request(const asn1::ngap::broadcast_session_release_request_s& msg)
+{
+  const std::string key     = make_mbs_session_key(msg->mbs_session_id);
+  auto              session = mbs_sessions.find(key);
+  if (session == mbs_sessions.end()) {
+    logger.warning("MBS session={}: Received BroadcastSessionReleaseRequest for unknown session", key);
+    // Reply with a release response anyway, so the 5GC can complete its release procedure.
+    send_broadcast_session_release_response(msg->mbs_session_id);
+    return;
+  }
+
+  cu_cp_notifier.on_mbs_session_deactivation_request({make_cu_cp_mbs_session_id(msg->mbs_session_id)});
+  mbs_sessions.erase(session);
+
+  logger.info("MBS session={}: Released broadcast session", key);
+  send_broadcast_session_release_response(msg->mbs_session_id);
+}
