+void e1ap_cu_up_impl::handle_mbs_bearer_context_setup_request(
+    const asn1::e1ap::mc_bearer_context_setup_request_s& msg)
+{
+  e1ap_message e1ap_msg;
+  e1ap_msg.pdu.set_unsuccessful_outcome();
+  e1ap_msg.pdu.unsuccessful_outcome().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_SETUP);
+  e1ap_msg.pdu.unsuccessful_outcome().value.mc_bearer_context_setup_fail()->gnb_cu_cp_mbs_e1ap_id =
+      msg->gnb_cu_cp_mbs_e1ap_id;
+  e1ap_msg.pdu.unsuccessful_outcome().value.mc_bearer_context_setup_fail()->cause.set_protocol();
+
+  e1ap_mbs_bearer_context_setup_request request;
+  request.cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  request.session_id        = make_mbs_session_id(msg->global_mbs_session_id);
+  if (msg->mc_bearer_context_to_setup.ie_exts_present &&
+      msg->mc_bearer_context_to_setup.ie_exts.mbs_area_session_id_present) {
+    request.area_session_id = msg->mc_bearer_context_to_setup.ie_exts.mbs_area_session_id;
+  }
+  request.mrb_to_setup_list = make_mbs_mrb_list(msg->mc_bearer_context_to_setup.mc_mrb_to_setup_list);
+
+  e1ap_mbs_bearer_context_setup_response response =
+      cu_up_notifier.on_mbs_bearer_context_setup_request_received(request);
+  if (!response.success) {
+    pdu_notifier->on_new_message(e1ap_msg);
+    return;
+  }
+
+  e1ap_msg.pdu.set_successful_outcome();
+  e1ap_msg.pdu.successful_outcome().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_SETUP);
+  auto& setup_resp = e1ap_msg.pdu.successful_outcome().value.mc_bearer_context_setup_resp();
+  setup_resp->gnb_cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  setup_resp->gnb_cu_up_mbs_e1ap_id = response.cu_up_mbs_e1ap_id;
+  for (const auto& mrb : response.mrb_setup_resp_list) {
+    setup_resp->mc_bearer_context_to_setup_resp.mc_mrb_setup_resp_list.push_back(
+        make_mbs_mrb_setup_response_item(mrb));
+  }
+
+  logger.info("MBS CU-CP-E1AP-ID={}: Sending MCBearerContextSetupResponse CU-UP-MBS-E1AP-ID={} nof_mrbs={}",
+              msg->gnb_cu_cp_mbs_e1ap_id,
+              response.cu_up_mbs_e1ap_id,
+              response.mrb_setup_resp_list.size());
+  pdu_notifier->on_new_message(e1ap_msg);
+}
+
+void e1ap_cu_up_impl::handle_mbs_bearer_context_modification_request(
+    const asn1::e1ap::mc_bearer_context_mod_request_s& msg)
+{
+  e1ap_message e1ap_msg;
+  e1ap_msg.pdu.set_unsuccessful_outcome();
+  e1ap_msg.pdu.unsuccessful_outcome().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_MOD);
+  auto& mod_fail = e1ap_msg.pdu.unsuccessful_outcome().value.mc_bearer_context_mod_fail();
+  mod_fail->gnb_cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  mod_fail->gnb_cu_up_mbs_e1ap_id = msg->gnb_cu_up_mbs_e1ap_id;
+  mod_fail->cause.set_protocol();
+
+  e1ap_mbs_bearer_context_modification_request request;
+  request.cu_cp_mbs_e1ap_id          = msg->gnb_cu_cp_mbs_e1ap_id;
+  request.cu_up_mbs_e1ap_id          = msg->gnb_cu_up_mbs_e1ap_id;
+  request.mrb_to_setup_modify_list   = make_mbs_mrb_list(msg->mc_bearer_context_to_modify.mc_mrb_to_setup_modify_list);
+  request.mrb_to_remove_list.reserve(msg->mc_bearer_context_to_modify.mc_mrb_to_rem_list.size());
+  for (uint16_t mrb_id : msg->mc_bearer_context_to_modify.mc_mrb_to_rem_list) {
+    request.mrb_to_remove_list.push_back(mrb_id);
+  }
+
+  e1ap_mbs_bearer_context_modification_response response =
+      cu_up_notifier.on_mbs_bearer_context_modification_request_received(request);
+  if (!response.success) {
+    pdu_notifier->on_new_message(e1ap_msg);
+    return;
+  }
+
+  e1ap_msg.pdu.set_successful_outcome();
+  e1ap_msg.pdu.successful_outcome().load_info_obj(ASN1_E1AP_ID_MC_BEARER_CONTEXT_MOD);
+  auto& mod_resp = e1ap_msg.pdu.successful_outcome().value.mc_bearer_context_mod_resp();
+  mod_resp->gnb_cu_cp_mbs_e1ap_id = msg->gnb_cu_cp_mbs_e1ap_id;
+  mod_resp->gnb_cu_up_mbs_e1ap_id = response.cu_up_mbs_e1ap_id;
+  for (const auto& mrb : response.mrb_setup_modify_resp_list) {
+    mod_resp->mc_bearer_context_to_modify_resp.mc_mrb_modify_setup_resp_list.push_back(
+        make_mbs_mrb_setup_modify_response_item(mrb));
+  }
+
+  logger.info("MBS CU-CP-E1AP-ID={}: Sending MCBearerContextModificationResponse CU-UP-MBS-E1AP-ID={} nof_mrbs={}",
+              msg->gnb_cu_cp_mbs_e1ap_id,
+              response.cu_up_mbs_e1ap_id,
+              response.mrb_setup_modify_resp_list.size());
+  pdu_notifier->on_new_message(e1ap_msg);
+}
