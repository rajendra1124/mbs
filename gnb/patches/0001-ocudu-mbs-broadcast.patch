+static mcmrb_setup_resp_list_item_s make_mbs_mrb_setup_response_item(const e1ap_mbs_mrb_item& mrb)
+{
+  mcmrb_setup_resp_list_item_s item;
+  item.mrb_id = mrb.mrb_id;
