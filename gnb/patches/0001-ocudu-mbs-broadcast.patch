+        // the MRB LCID and exact RLC PDU length instead of interpreting the first RLC header byte as an LCID.
+        const unsigned max_rlc_pdu_size = get_mac_sdu_payload_size(tbs);
+        payload                         = encode_mbs_mtch_pdu(mbs, max_rlc_pdu_size);
+        if (not payload.empty()) {
