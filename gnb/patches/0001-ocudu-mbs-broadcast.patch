+/// \brief Selects a search space from the UE-dedicated configuration for fallback C-RNTI grants, if usable.
+///
+/// Some UEs only monitor the RA search space (Type1-PDCCH CSS) for C-RNTI PDCCH while a RA procedure is ongoing,
+/// even though TS 38.213, Section 10.1 lists the C-RNTI among the RNTIs monitored in this search space. Grants
+/// sent in the RA search space after the ConRes procedure completion may therefore never be decoded by such UEs,
+/// preventing e.g. the delivery of the RRC Setup Complete. Once ConRes is complete (at which point the UE has
+/// applied the CellGroupConfig carried in the RRC Setup), prefer a search space from the UE-dedicated
+/// configuration.
+static const search_space_info* get_ded_cfg_fallback_search_space(const ue& u, slot_point pdcch_slot)
+{
+  if (u.ue_cfg_dedicated() == nullptr or not u.get_pcell().get_pcell_state().conres_complete) {
+    return nullptr;
+  }
+  const ue_cell_configuration& ue_cc_cfg = u.get_pcell().cfg();
+  const auto& common_ss_list = ue_cc_cfg.cell_cfg_common.params.dl_cfg_common.init_dl_bwp.pdcch_common.search_spaces;
+  for (const sched_search_space_config* ss_ded :
+       ue_cc_cfg.bwp(u.get_pcell().active_bwp_id()).dl.pdcch().search_spaces()) {
+    const bool is_cell_common_ss =
+        std::any_of(common_ss_list.begin(), common_ss_list.end(), [&ss_ded](const search_space_configuration& css) {
+          return css.get_id() == ss_ded->id();
+        });
+    if (is_cell_common_ss) {
+      continue;
+    }
+    const search_space_info& ss = ue_cc_cfg.search_space(ss_ded->id());
+    if (ss.get_ul_dci_format() != dci_ul_format::f0_0 or ss.get_dl_dci_format() != dci_dl_format::f1_0) {
+      // In fallback, only DCI formats 0_0/1_0 are used.
+      continue;
+    }
+    if (not pdcch_helper::is_pdcch_monitoring_active(pdcch_slot, *ss.cfg) or
+        ss.get_pdcch_candidates(aggregation_level::n4, pdcch_slot).empty()) {
+      continue;
+    }
+    return &ss;
+  }
+  return nullptr;
+}
