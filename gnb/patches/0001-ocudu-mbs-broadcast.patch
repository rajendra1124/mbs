+static uint8_t mbs_mrb_id_to_lcid(uint16_t mrb_id)
+{
+  return static_cast<uint8_t>(std::clamp<unsigned>(mrb_id == 0 ? 1U : mrb_id, 1U, 32U));
+}
+
+static mac_mbs_mrb_config get_mbs_mrb_config_or_default(const mac_mbs_context_setup_request& setup, uint16_t mrb_id)
+{
+  auto it = std::find_if(setup.mrb_configs.begin(), setup.mrb_configs.end(), [mrb_id](const mac_mbs_mrb_config& cfg) {
+    return cfg.mrb_id == mrb_id;
+  });
+  if (it != setup.mrb_configs.end()) {
+    return *it;
+  }
+  mac_mbs_mrb_config default_cfg;
+  default_cfg.mrb_id = mrb_id;
+  return default_cfg;
+}
+
+static bool mbs_mrb_configs_equal(const mac_mbs_mrb_config& lhs, const mac_mbs_mrb_config& rhs)
+{
+  return lhs.mrb_id == rhs.mrb_id and lhs.pdcp_sn_size_dl == rhs.pdcp_sn_size_dl and
+         lhs.pdcp_t_reordering_dl == rhs.pdcp_t_reordering_dl and lhs.rlc_sn_size == rhs.rlc_sn_size and
+         lhs.rlc_t_reassembly_ms == rhs.rlc_t_reassembly_ms;
+}
+
+static void fill_mbs_broadcast_mrb_info(asn1::rrc_nr::mrb_info_broadcast_r17_s& mrb,
+                                        const mac_mbs_mrb_config&               cfg)
+{
+  mrb.pdcp_cfg_r17.hdr_compress_r17.set_not_used();
+  mrb.pdcp_cfg_r17.pdcp_sn_size_dl_r17_present = cfg.pdcp_sn_size_dl == pdcp_sn_size::size12bits;
+  mrb.pdcp_cfg_r17.t_reordering_r17_present    = true;
+  switch (cfg.pdcp_t_reordering_dl) {
+    case pdcp_t_reordering::ms1:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms1;
+      break;
+    case pdcp_t_reordering::ms10:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms10;
+      break;
+    case pdcp_t_reordering::ms160:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms160;
+      break;
+    case pdcp_t_reordering::ms500:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms500;
+      break;
+    case pdcp_t_reordering::ms1000:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms1000;
+      break;
+    case pdcp_t_reordering::ms1250:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms1250;
+      break;
+    case pdcp_t_reordering::ms2750:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms2750;
+      break;
+    case pdcp_t_reordering::ms40:
+    default:
+      mrb.pdcp_cfg_r17.t_reordering_r17 =
+          asn1::rrc_nr::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms40;
+      break;
+  }
+  mrb.rlc_cfg_r17.lc_ch_id_r17                 = mbs_mrb_id_to_lcid(cfg.mrb_id);
+  mrb.rlc_cfg_r17.sn_field_len_r17_present     = cfg.rlc_sn_size == rlc_um_sn_size::size6bits;
+  mrb.rlc_cfg_r17.t_reassembly_r17_present     = true;
+  mrb.rlc_cfg_r17.t_reassembly_r17             = asn1::rrc_nr::t_reassembly_opts::ms40;
+}
