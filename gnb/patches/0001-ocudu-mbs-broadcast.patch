+static std::string make_mbs_service_id_hex(std::string_view session_key)
+{
+  std::string hex;
+  hex.reserve(6);
+  for (char c : session_key) {
+    if (std::isxdigit(static_cast<unsigned char>(c))) {
+      hex.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+      if (hex.size() == 6) {
+        break;
+      }
+    }
+  }
+  while (hex.size() < 6) {
+    hex.push_back('0');
+  }
+  return hex;
+}
