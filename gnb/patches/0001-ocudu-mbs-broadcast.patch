+  mbs_teid_pool_cfg.max_nof_teids                   = 4096;
+  mbs_f1u_teid_pool                                 = create_gtpu_allocator(mbs_teid_pool_cfg);
+  mbs_f1u_router                                    = std::make_unique<f1u_mbs_router>(*mbs_f1u_teid_pool);
 }
 
