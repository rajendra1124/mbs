+#!/usr/bin/env python3
+"""Import the MBS ASN.1 dependency closure, using existing Release 15 types.
+
+Run from srsRAN_4G. OCUDU is read-only; imported files have no build/runtime
+dependency on the sibling checkout. Keep the upstream copyright and license.
+"""
+import hashlib
+import pathlib
+import re
+import sys
+
+root = pathlib.Path(__file__).resolve().parents[1]
+upstream = pathlib.Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else root.parent / "ocudu"
+base = (root / "lib/include/srsran/asn1/rrc_nr.h").read_text()
+existing = set(re.findall(r"^(?:struct|using|typedef\s+\S+)\s+(\w+)", base, re.M))
+# Older headers also use 'typedef X alias;' for several list/enum definitions.
+existing.update(re.findall(r"^typedef\s+.+?\s+(\w+);", base, re.M))
+headers, methods, origin = {}, {}, {}
+pattern = r"(?=^// [^\n]* ::= )"
+for path in sorted((upstream / "include/ocudu/asn1/rrc_nr").glob("*.h")):
+    for part in re.split(pattern, path.read_text(), flags=re.M)[1:]:
+        part = part.split("} // namespace")[0].rstrip()
+        for name in re.findall(r"^(?:struct|using)\s+(\w+)", part, re.M):
+            headers[name] = part
+            origin[name] = str(path.relative_to(upstream))
+for path in sorted((upstream / "lib/asn1/rrc_nr").glob("*.cpp")):
+    for part in re.split(pattern, path.read_text(), flags=re.M)[1:]:
+        for name in set(re.findall(r"\b(\w+)::", part)) & headers.keys():
+            methods[name] = part.rstrip()
+
+# Keep the entire SIB1-to-PDCCH chain in the MBS namespace so Release 17
+# extensions do not change the ABI of the existing unicast ASN.1 library.
+forced = {"pdcch_cfg_common_s", "bwp_dl_common_s", "dl_cfg_common_sib_s",
+          "serving_cell_cfg_common_sib_s", "sib1_s"}
+ordered, visiting, done = [], set(), set()
+def visit(name):
+    if (name in existing and name not in forced) or name in done or name not in headers:
+        return
+    if name in visiting:
+        raise RuntimeError("Unexpected dependency cycle: " + name)
+    visiting.add(name)
+    own = set(re.findall(r"^(?:struct|using)\s+(\w+)", headers[name], re.M))
+    deps = set(re.findall(r"\b\w+\b", headers[name])) & headers.keys()
+    for dep in sorted(deps - own):
+        visit(dep)
+    visiting.remove(name)
+    done.update(own)
+    ordered.append(name)
+
+for name in ("sib20_r17_s", "mcch_msg_r17_s", "sib1_s"):
+    visit(name)
+license_header = "// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited\n// SPDX-License-Identifier: BSD-3-Clause-Open-MPI\n// Adapted from OCUDU ASN.1: MBS types with existing srsRAN Release 15 dependencies.\n// Portions implement 3GPP specifications; upstream licensing notices are retained.\n"
+def adapt(text):
+    text = text.replace("OCUDUASN", "SRSASN")
+    # Map the newer scoped extension decoder to the existing srsRAN API.
+    pattern = r"ext_groups_unpacker group_unpacker\(bref\);(.*?)HANDLE_CODE\(group_unpacker.consume_remaining_groups\(bref\)\);"
+    def groups(match):
+        body = match[1]
+        count = body.count("HANDLE_CODE(group_unpacker.unpack_next_group());")
+        body = body.replace("HANDLE_CODE(group_unpacker.unpack_next_group());", "")
+        for i in range(count):
+            body = body.replace("if (group_unpacker.get_last_group_range(bref)) {",
+                f"if (group_flags[{i}]) {{\n      varlength_field_unpack_guard varlen_scope(bref, false);", 1)
+        return f"ext_groups_unpacker_guard group_flags({count});\n    HANDLE_CODE(group_flags.unpack(bref));" + body
+    text = re.sub(pattern, groups, text, flags=re.S)
+    text = re.sub(r"unpack_presence_flag\((\w+), bref\);",
+        r"bool \1_present = false;\n      HANDLE_CODE(bref.unpack(\1_present, 1));\n      \1.set_present(\1_present);", text)
+    return text
+header = license_header + '#pragma once\n#include "srsran/asn1/rrc_nr.h"\nnamespace asn1 { namespace rrc_nr { namespace mbs {\n\n'
+header += "\n\n".join(adapt(headers[n]) for n in ordered)
+header += "\n} } } // namespace asn1::rrc_nr::mbs\n"
+source = license_header + '#include "srsran/asn1/mbs_rrc_nr.h"\nnamespace asn1 { namespace rrc_nr { namespace mbs {\n\n'
+method_groups = []
+seen_methods = set()
+for name in ordered:
+    for declaration in re.findall(r"^(?:struct|using)\s+(\w+)", headers[name], re.M):
+        body = methods.get(declaration)
+        if body is not None and body not in seen_methods:
+            method_groups.append(adapt(body))
+            seen_methods.add(body)
+source += "\n\n".join(method_groups) + "\n} } } // namespace asn1::rrc_nr::mbs\n"
+(root / "lib/include/srsran/asn1/mbs_rrc_nr.h").write_text(header)
+(root / "lib/src/asn1/mbs_rrc_nr.cc").write_text(source)
+manifest = ["# OCUDU MBS ASN.1 import", "", "Imported declarations and their upstream header SHA-256:", ""]
+for path in sorted(set(origin[n] for n in ordered)):
+    manifest.append(hashlib.sha256((upstream / path).read_bytes()).hexdigest() + "  " + path)
+(root / "docs/mbs-asn1-provenance.md").write_text("\n".join(manifest) + "\n")
+(root / "docs/mbs-asn1-upstream-license.txt").write_bytes((upstream / "LICENSE").read_bytes())
+print(f"Imported {len(ordered)} declaration groups, {len(header)} header bytes and {len(source)} source bytes")
diff --git a/scripts/run-ocudu-b210-mbs.sh b/scripts/run-ocudu-b210-mbs.sh
new file mode 100755
index 000000000..8991f405f
--- /dev/null
+++ b/scripts/run-ocudu-b210-mbs.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# Run the receive-only MBS UE against this workspace's OCUDU B210 profile.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+MBS_BIN="${MBS_BIN:-${REPO_DIR}/build-mbs-local/srsue/src/srsue_mbs}"
+SERVICE_ID="${SERVICE_ID:-000001}"
+RF_ARGS="${RF_ARGS:-type=b200}"
+RF_GAIN="${RF_GAIN:-40}"
+UDP_PORT="${UDP_PORT:-5005}"
+MBS_WIRE_FORMAT="${MBS_WIRE_FORMAT:-ocudu}"
+
+if [[ ! -x "${MBS_BIN}" ]]; then
+  cat >&2 <<EOF
+Missing executable: ${MBS_BIN}
+
+Build the receive-only UE first:
+  cmake -S ${REPO_DIR} -B ${REPO_DIR}/build-mbs-local \\
+    -DENABLE_SRSUE=ON -DENABLE_SRSENB=OFF -DENABLE_SRSEPC=OFF \\
+    -DENABLE_GUI=OFF -DENABLE_ZEROMQ=OFF -DENABLE_HARDSIM=OFF \\
+    -DCMAKE_BUILD_TYPE=Release
+  cmake --build ${REPO_DIR}/build-mbs-local --target srsue_mbs -j4
+EOF
+  exit 1
+fi
+
+if [[ ! "${SERVICE_ID}" =~ ^[[:xdigit:]]{6}$ ]]; then
+  echo "SERVICE_ID must contain exactly six hexadecimal digits" >&2
+  exit 1
+fi
+if [[ "${MBS_WIRE_FORMAT}" != ocudu && "${MBS_WIRE_FORMAT}" != release17 ]]; then
+  echo "MBS_WIRE_FORMAT must be ocudu or release17" >&2
+  exit 1
+fi
+
+args=(
+  --rf.device uhd --rf.args "${RF_ARGS}" --rf.gain "${RF_GAIN}"
+  --rate 23040000 --frequency 3489420000 --ssb-frequency 3488160000
+  --scs 30 --prbs 51 --pci 1 --coreset0 13 --ssb-period 20
+  --service-id "${SERVICE_ID}" --plmn 99970 --lcid 1
+  --mbs-wire-format "${MBS_WIRE_FORMAT}" --udp-port "${UDP_PORT}"
+)
+
+# The current OCUDU compatibility profile advertises SI-RNTI instead of its
+# actual FE01 group. Standard Release-17 cells should omit this override.
+if [[ "${MBS_WIRE_FORMAT}" == ocudu ]]; then
+  args+=(--rnti 65025)
+fi
+
+exec "${MBS_BIN}" "${args[@]}" "$@"
diff --git a/scripts/run-ocudu-b210-ue.sh b/scripts/run-ocudu-b210-ue.sh
new file mode 100755
index 000000000..c3f42270f
--- /dev/null
+++ b/scripts/run-ocudu-b210-ue.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+
+CONFIG="${1:-${REPO_DIR}/srsue/ue_ocudu_b210_n78_unicast.conf.example}"
+SRSUE_BIN="${SRSUE_BIN:-${REPO_DIR}/build/srsue/src/srsue}"
+
+if [[ ! -x "${SRSUE_BIN}" ]]; then
+  cat >&2 <<EOF
+Missing executable: ${SRSUE_BIN}
+
+Build srsUE first:
+  cd ${REPO_DIR}
+  cmake -S . -B build \\
+    -DENABLE_SRSUE=ON \\
+    -DENABLE_SRSENB=OFF \\
+    -DENABLE_SRSEPC=OFF \\
+    -DENABLE_GUI=OFF \\
+    -DENABLE_ZEROMQ=OFF \\
+    -DENABLE_HARDSIM=OFF
+  cmake --build build --target srsue -j "\$(nproc)"
+
+Then rerun:
+  ${0} ${CONFIG}
+EOF
+  exit 1
+fi
+
+if [[ ! -f "${CONFIG}" ]]; then
+  echo "Missing config: ${CONFIG}" >&2
+  exit 1
+fi
+
+echo "Using srsUE binary: ${SRSUE_BIN}"
+echo "Using UE config:    ${CONFIG}"
+echo
+echo "Expected after attach:"
+echo "  ip addr show tun_srsue"
+echo "  ping -I tun_srsue -c 4 10.45.0.1"
+echo
+echo "Note: this validates NR SA unicast/PDU connectivity only, not Rel-17 MBS reception."
+
+if [[ "${EUID}" -ne 0 ]]; then
+  exec sudo "${SRSUE_BIN}" "${CONFIG}"
+fi
+
+exec "${SRSUE_BIN}" "${CONFIG}"
