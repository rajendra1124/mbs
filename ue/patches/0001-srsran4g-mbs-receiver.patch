+#####################################################################
+# srsUE profile for this workspace's host-run OCUDU B200/B210 gNB.
+#
+# Scope:
+#   - Intended for SDR laptop UE attach/PDU-session validation.
+#   - Not a 3GPP Release 17 5G MBS UE profile. This srsRAN_4G tree has
+#     LTE eMBMS support and prototype NR SA UE support, but it does not
+#     implement NR Rel-17 MBS MCCH/G-RNTI/MTCH/MRB reception.
+#
+# Matching gNB profile:
+#   /home/raj/chatgpt/sdr-mbs/docs/ocudu-host-gnb-b210.yml
+#
+# Matching core:
+#   /home/raj/chatgpt/sdr-mbs/rt-mbs-examples
+#####################################################################
+
+[rf]
+freq_offset = 0
+tx_gain = 70
+rx_gain = 40
+srate = 23.04e6
+nof_antennas = 1
+
+device_name = uhd
+device_args = type=b200,num_recv_frames=512,num_send_frames=512
+
+[rat.eutra]
+nof_carriers = 0
+
+[rat.nr]
+bands = 78
+nof_carriers = 1
+max_nof_prb = 106
+dl_nr_arfcn = 632628
+ssb_nr_arfcn = 632628
+nof_prb = 106
+scs = 30
+ssb_scs = 30
+
+[pcap]
+enable = mac_nr,nas
+mac_filename = /tmp/ue_ocudu_b210_mac.pcap
+mac_nr_filename = /tmp/ue_ocudu_b210_mac_nr.pcap
+nas_filename = /tmp/ue_ocudu_b210_nas.pcap
+
+[log]
+all_level = info
+phy_lib_level = warning
+all_hex_limit = 32
+filename = /tmp/ue_ocudu_b210.log
+file_max_size = -1
+
+[usim]
+mode = soft
+algo = milenage
+opc  = 00000000000000000000000000000000
+k    = 00000000000000000000000000000000
+imsi = 999701234567891
+imei = 353490069873319
+
+[rrc]
+release = 15
+ue_category = 4
+mbms_service_id = -1
+
+[slicing]
+enable = true
+nssai-sst = 1
+nssai-sd = 16777215
+
+[nas]
+apn = internet
+apn_protocol = ipv4
+
+[gw]
+ip_devname = tun_srsue
+ip_netmask = 255.255.255.0
+
+[gui]
+enable = false
+
+[phy]
+nof_phy_threads = 3
