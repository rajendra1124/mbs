+bool reject(std::string& error, const char* text) { error = text; return false; }
+bool bandwidth(unsigned riv, unsigned& start, unsigned& width)
+{
+  if (riv >= 275 * 276 / 2) return false;
+  width = riv / 275 + 1; start = riv % 275;
+  if (width > 275 - start) { width = 277 - width; start = 274 - start; }
+  return width && start + width <= 275;
+}
+bool coreset(const mbs::coreset_s& in, unsigned origin, const srsran_carrier_nr_t& carrier,
+             srsran_pdcch_cfg_nr_t& out, std::string& error)
+{
+  if (in.coreset_id >= SRSRAN_UE_DL_NR_MAX_NOF_CORESET || !in.dur || in.dur > 3)
+    return reject(error, "CORESET identity or duration is outside receiver limits");
+  srsran_coreset_t value{};
+  value.id = in.coreset_id; value.duration = in.dur;
+  value.offset_rb = origin + (in.rb_offset_r16_present ? in.rb_offset_r16 : 0);
+  value.dmrs_scrambling_id_present = in.pdcch_dmrs_scrambling_id_present;
+  value.dmrs_scrambling_id = in.pdcch_dmrs_scrambling_id;
+  value.precoder_granularity = in.precoder_granularity == mbs::coreset_s::precoder_granularity_opts::all_contiguous_rbs ?
+      srsran_coreset_precoder_granularity_contiguous : srsran_coreset_precoder_granularity_reg_bundle;
+  value.mapping_type = srsran_coreset_mapping_type_non_interleaved;
+  if (in.cce_reg_map_type.type() == mbs::coreset_s::cce_reg_map_type_c_::types::interleaved) {
+    const auto& inter = in.cce_reg_map_type.interleaved();
+    value.mapping_type = srsran_coreset_mapping_type_interleaved;
+    const auto bundle = [](unsigned n) { return n == 2 ? srsran_coreset_bundle_size_n2 :
+        n == 3 ? srsran_coreset_bundle_size_n3 : srsran_coreset_bundle_size_n6; };
+    value.reg_bundle_size = bundle(inter.reg_bundle_size.to_number());
+    value.interleaver_size = bundle(inter.interleaver_size.to_number());
+    value.shift_index = inter.shift_idx_present ? inter.shift_idx : carrier.pci;
+  }
+  for (unsigned i = 0; i < 45; ++i) {
+    value.freq_resources[i] = in.freq_domain_res.get(44 - i);
+    if (value.freq_resources[i] && value.offset_rb + (i + 1) * 6 > carrier.nof_prb)
+      return reject(error, "CORESET extends beyond the captured carrier");
+  }
+  if (!srsran_coreset_get_bw(&value)) return reject(error, "Empty CORESET");
+  out.coreset[value.id] = value; out.coreset_present[value.id] = true;
+  return true;
+}
+bool search(const asn1::rrc_nr::search_space_s& in, mbs_search_space& out, std::string& error)
+{
+  if (!in.ctrl_res_set_id_present || !in.nrof_candidates_present || !in.monitoring_symbols_within_slot_present)
+    return reject(error, "Incomplete common search space");
+  out = {};
+  out.phy.id = in.search_space_id; out.phy.coreset_id = in.ctrl_res_set_id;
+  out.phy.type = srsran_search_space_type_common_2;
+  out.phy.nof_formats = 1; out.phy.formats[0] = srsran_dci_format_nr_1_0;
+  out.phy.nof_candidates[0] = in.nrof_candidates.aggregation_level1.to_number();
+  out.phy.nof_candidates[1] = in.nrof_candidates.aggregation_level2.to_number();
+  out.phy.nof_candidates[2] = in.nrof_candidates.aggregation_level4.to_number();
+  out.phy.nof_candidates[3] = in.nrof_candidates.aggregation_level8.to_number();
+  out.phy.nof_candidates[4] = in.nrof_candidates.aggregation_level16.to_number();
+  out.duration = in.dur_present ? in.dur : 1;
+  out.symbols = 0;
+  for (unsigned i = 0; i < 14; ++i) if (in.monitoring_symbols_within_slot.get(13 - i)) out.symbols |= 1U << i;
+  if (in.monitoring_slot_periodicity_and_offset_present) {
+    const auto& p = in.monitoring_slot_periodicity_and_offset;
+    out.period = p.type().to_number();
+    switch (out.period) {
+      case 1: out.offset = 0; break;
+#define PERIOD(n) case n: out.offset = p.sl##n(); break
+      PERIOD(2); PERIOD(4); PERIOD(5); PERIOD(8); PERIOD(10); PERIOD(16); PERIOD(20);
+      PERIOD(40); PERIOD(80); PERIOD(160); PERIOD(320); PERIOD(640); PERIOD(1280); PERIOD(2560);
+#undef PERIOD
+      default: return reject(error, "Invalid monitoring period");
+    }
+  }
+  return true;
+}
+bool append_tdd(const asn1::rrc_nr::tdd_ul_dl_pattern_s& pattern, unsigned slots_per_ms,
+                std::vector<uint16_t>& uplink, std::string& error)
+{
+  static const unsigned periods_us[] = {500,625,1000,1250,2000,2500,5000,10000};
+  if (unsigned(pattern.dl_ul_tx_periodicity.value) >= 8) return reject(error, "Invalid TDD period");
+  const unsigned microseconds = pattern.dl_ul_tx_periodicity_v1530_present ?
+      pattern.dl_ul_tx_periodicity_v1530.to_number() * 1000 : periods_us[pattern.dl_ul_tx_periodicity.value];
+  if (microseconds * slots_per_ms % 1000) return reject(error, "TDD period is not an integral slot count");
+  const unsigned slots = microseconds * slots_per_ms / 1000;
+  const unsigned occupied = pattern.nrof_dl_slots + pattern.nrof_ul_slots;
+  if (!slots || occupied > slots || pattern.nrof_dl_symbols > 13 || pattern.nrof_ul_symbols > 13 ||
+      (occupied == slots && (pattern.nrof_dl_symbols || pattern.nrof_ul_symbols)) ||
+      (occupied + 1 == slots && pattern.nrof_dl_symbols + pattern.nrof_ul_symbols > 14))
+    return reject(error, "Overlapping TDD downlink and uplink symbols");
+  const auto origin = uplink.size();
+  uplink.resize(origin + slots, 0);
+  for (unsigned i = slots - pattern.nrof_ul_slots; i < slots; ++i) uplink[origin + i] = 0x3fff;
+  if (pattern.nrof_ul_symbols)
+    uplink[origin + slots - pattern.nrof_ul_slots - 1] = ((1U << pattern.nrof_ul_symbols) - 1) << (14 - pattern.nrof_ul_symbols);
+  return true;
+}
+bool pdsch(const mbs::pdsch_cfg_broadcast_r17_s& in, unsigned index, mbs_pdsch_profile& out, std::string& error)
+{
+  if (in.rate_match_pattern_to_add_mod_list_r17.size() || in.lte_crs_to_match_around_r17_present)
+    return reject(error, "Broadcast rate-matching patterns are not supported");
+  out.common.mcs_table = !in.mcs_table_r17_present ? srsran_mcs_table_64qam :
+      in.mcs_table_r17 == mbs::pdsch_cfg_broadcast_r17_s::mcs_table_r17_opts::qam256 ?
+      srsran_mcs_table_256qam : srsran_mcs_table_qam64LowSE;
+  out.common.sch_cfg.xoverhead = !in.xoverhead_r17_present ? srsran_xoverhead_0 :
+      static_cast<srsran_xoverhead_t>(unsigned(in.xoverhead_r17.value) + 1);
+  out.aggregation = 1; out.repetitions.fill(0);
+  out.common.scrambling_id_present = false;
+  out.common.dmrs_typeA.scrambling_id0_present = false;
+  if (in.pdsch_cfg_list_r17.size()) {
+    if (index >= in.pdsch_cfg_list_r17.size()) return reject(error, "PDSCH configuration index exceeds MCCH list");
+    const auto& item = in.pdsch_cfg_list_r17[index];
+    if (item.pdsch_aggregation_factor_r17_present) out.aggregation = item.pdsch_aggregation_factor_r17.to_number();
+    out.common.scrambling_id_present = item.data_scrambling_id_pdsch_r17_present;
+    out.common.scambling_id = item.data_scrambling_id_pdsch_r17;
+    out.common.dmrs_typeA.scrambling_id0_present = item.dmrs_scrambling_id0_r17_present;
+    out.common.dmrs_typeA.scrambling_id0 = item.dmrs_scrambling_id0_r17;
+  }
+  if (in.pdsch_time_domain_alloc_list_r17.size()) {
+    out.common.nof_common_time_ra = in.pdsch_time_domain_alloc_list_r17.size();
+    if (out.common.nof_common_time_ra > SRSRAN_MAX_NOF_TIME_RA) return false;
+    for (unsigned i = 0; i < out.common.nof_common_time_ra; ++i) {
+      const auto& item = in.pdsch_time_domain_alloc_list_r17[i];
+      if (item.repeat_num_r16_present || item.repeat_num_v1730_present) {
+        if (out.aggregation != 1) return reject(error, "PDSCH aggregation and TDRA repetition cannot be combined");
+        out.repetitions[i] = item.repeat_num_v1730_present ? item.repeat_num_v1730.to_number() : item.repeat_num_r16.to_number();
+      }
+      auto& time = out.common.common_time_ra[i];
+      time.mapping_type = item.map_type_r16 == mbs::pdsch_time_domain_res_alloc_r16_s::map_type_r16_opts::type_a ?
+          srsran_sch_mapping_type_A : srsran_sch_mapping_type_B;
+      time.sliv = item.start_symbol_and_len_r16;
+      time.k = item.k0_v1710_present ? item.k0_v1710 : item.k0_r16_present ? item.k0_r16 : 0;
+
+    }
+  }
+  return true;
+}
+}
