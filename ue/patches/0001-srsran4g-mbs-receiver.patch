new file mode 100644
index 000000000..f114c4284
--- /dev/null
+++ b/srsue/test/mbs/ocudu_mbs_gateway_test.cc
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#include "srsue/hdr/stack/mbs/ocudu_mbs_gateway.h"
+#include <cstdio>
+int main() {
+  int fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+  if (fd < 0) { perror("socket"); return 1; }
+  sockaddr_in local{};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (bind(fd, reinterpret_cast<sockaddr*>(&local), sizeof(local))) { perror("bind"); return 1; }
+  socklen_t length = sizeof(local);
+  if (getsockname(fd, reinterpret_cast<sockaddr*>(&local), &length)) return 1;
+  srsue::ocudu_mbs_gateway gateway;
+  const uint8_t tb[] = {1, 4, 0, 0x80, 0, 0x47, 63};
+  if (!gateway.deliver(tb, sizeof(tb), 1, ntohs(local.sin_port))) return 1;
+  uint8_t output[10]{};
+  auto count = recv(fd, output, sizeof(output), MSG_DONTWAIT);
+  close(fd);
+  if (count != 1 || output[0] != 0x47 || gateway.metrics().delivered != 1) return 1;
+  puts("Loopback UDP delivery passed");
+}
diff --git a/srsue/test/mbs/ocudu_mbs_phy_test.cc b/srsue/test/mbs/ocudu_mbs_phy_test.cc
new file mode 100644
index 000000000..93703faae
--- /dev/null
+++ b/srsue/test/mbs/ocudu_mbs_phy_test.cc
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#include "srsue/hdr/phy/nr/ocudu_mbs_phy.h"
+#include "srsran/phy/phch/ra_dl_nr.h"
+extern "C" {
+#include "srsran/phy/common/sliv.h"
+}
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+#include "srsue/hdr/stack/mbs/ocudu_mbs_rx.h"
+#define CHECK(x) do { if (!(x)) { std::cerr << "Failed line " << __LINE__ << ": " #x << '\n'; std::exit(1); } } while (0)
+
+// Noiseless symbol-grid test. This exercises LDPC, rate matching, group-RNTI
+// scrambling, modulation and MAC/RLC/PDCP delivery, without claiming RF or
+// PDCCH blind-search interoperability with OCUDU.
+static void test_symbols(const srsran_carrier_nr_t& carrier, srsran_sch_cfg_nr_t cfg)
+{
+  srsran_pdsch_nr_t encoder{}, decoder{};
+  srsran_pdsch_nr_args_t args{};
+  CHECK(srsran_pdsch_nr_init_enb(&encoder, &args) == SRSRAN_SUCCESS);
+  CHECK(srsran_pdsch_nr_init_ue(&decoder, &args) == SRSRAN_SUCCESS);
+  CHECK(srsran_pdsch_nr_set_carrier(&encoder, &carrier) == SRSRAN_SUCCESS);
+  CHECK(srsran_pdsch_nr_set_carrier(&decoder, &carrier) == SRSRAN_SUCCESS);
+  srsran_softbuffer_tx_t tx_buffer{};
+  srsran_softbuffer_rx_t rx_buffer{};
+  CHECK(srsran_softbuffer_tx_init_guru(&tx_buffer, SRSRAN_SCH_NR_MAX_NOF_CB_LDPC,
+                                      SRSRAN_LDPC_MAX_LEN_ENCODED_CB) == SRSRAN_SUCCESS);
+  CHECK(srsran_softbuffer_rx_init_guru(&rx_buffer, SRSRAN_SCH_NR_MAX_NOF_CB_LDPC,
+                                      SRSRAN_LDPC_MAX_LEN_ENCODED_CB) == SRSRAN_SUCCESS);
+  cf_t* symbols[SRSRAN_MAX_LAYERS_NR]{};
+  symbols[0] = srsran_vec_cf_malloc(SRSRAN_SLOT_LEN_RE_NR(carrier.nof_prb));
+  CHECK(symbols[0]);
+  srsran_vec_cf_zero(symbols[0], SRSRAN_SLOT_LEN_RE_NR(carrier.nof_prb));
+  const size_t size = cfg.grant.tb[0].tbs / 8;
+  CHECK(size >= 8);
+  std::vector<uint8_t> input(size, 0), output(size, 0);
+  const uint8_t header[] = {1, 4, 0, 0x80, 0, 0x47, 63};
+  std::copy(std::begin(header), std::end(header), input.begin());
+  uint8_t* inputs[SRSRAN_MAX_TB] = {input.data()};
+  cfg.grant.tb[0].softbuffer.tx = &tx_buffer;
+  CHECK(srsran_pdsch_nr_encode(&encoder, &cfg, &cfg.grant, inputs, symbols) == SRSRAN_SUCCESS);
+  srsran_chest_dl_res_t channel{};
+  CHECK(srsran_chest_dl_res_init(&channel, carrier.nof_prb) == SRSRAN_SUCCESS);
+  channel.nof_re = cfg.grant.tb[0].nof_re;
+  for (unsigned i = 0; i < channel.nof_re; ++i) channel.ce[0][0][i] = 1.0f;
+  cfg.grant.tb[0].softbuffer.rx = &rx_buffer;
+  srsran_softbuffer_rx_reset(&rx_buffer);
+  srsran_pdsch_res_nr_t result{};
+  result.tb[0].payload = output.data();
+  CHECK(srsran_pdsch_nr_decode(&decoder, &cfg, &cfg.grant, &channel, symbols, &result) == SRSRAN_SUCCESS);
+  CHECK(result.tb[0].crc && input == output);
+  srsue::ocudu_mbs_rx receiver;
+  CHECK(receiver.consume(output.data(), output.size(), 1, 0) ==
+        (std::vector<srsue::ocudu_mbs_rx::packet>{{0x47}}));
+  // Another RNTI must not recover the group's transport block.
+  cfg.grant.rnti = 0xfe02;
+  srsran_softbuffer_rx_reset(&rx_buffer);
+  CHECK(srsran_pdsch_nr_decode(&decoder, &cfg, &cfg.grant, &channel, symbols, &result) == SRSRAN_SUCCESS);
+  CHECK(!result.tb[0].crc);
+  srsran_chest_dl_res_free(&channel);
+  srsran_pdsch_nr_free(&encoder);
+  srsran_pdsch_nr_free(&decoder);
+  srsran_softbuffer_tx_free(&tx_buffer);
+  srsran_softbuffer_rx_free(&rx_buffer);
+  free(symbols[0]);
+}
+
+int main()
+{
+  srsran_dci_nr_t codec{};
+  srsran_dci_cfg_nr_t dci_cfg{};
+  dci_cfg.bwp_dl_initial_bw = 51;
+  dci_cfg.bwp_dl_active_bw = 51;
+  dci_cfg.bwp_ul_initial_bw = 51;
+  dci_cfg.bwp_ul_active_bw = 51;
+  dci_cfg.coreset0_bw = 48;
+  CHECK(srsran_dci_nr_set_cfg(&codec, &dci_cfg) == SRSRAN_SUCCESS);
+  srsran_dci_dl_nr_t tx{};
+  tx.ctx.rnti = 0xfe01;
+  tx.ctx.rnti_type = srsran_rnti_type_p;
+  tx.ctx.ss_type = srsran_search_space_type_common_2;
+  tx.ctx.format = srsran_dci_format_nr_1_0;
+  tx.ctx.coreset_id = 0;
+  tx.ctx.coreset_start_rb = 1;
+  tx.smi = 1;
+  tx.mcs = 5;
+  tx.freq_domain_assigment = 48 * (10 - 1) + 2; // 10 PRBs starting at relative PRB 2.
+  srsran_dci_msg_nr_t message{};
+  CHECK(srsran_dci_nr_dl_pack(&codec, &tx, &message) == SRSRAN_SUCCESS);
+  srsran_dci_dl_nr_t rx{};
+  CHECK(srsran_dci_nr_dl_unpack(&codec, &message, &rx) == SRSRAN_SUCCESS);
+  CHECK(rx.ctx.rnti == 0xfe01 && rx.smi == 1 && rx.freq_domain_assigment == tx.freq_domain_assigment);
+
+  srsran_carrier_nr_t carrier{};
+  carrier.pci = 1;
+  carrier.nof_prb = 51;
+  carrier.max_mimo_layers = 1;
+  srsran_slot_cfg_t slot{};
+  srsran_sch_hl_cfg_nr_t serving{};
+  serving.typeA_pos = srsran_dmrs_sch_typeA_pos_2;
+  serving.nof_common_time_ra = 1;
+  serving.common_time_ra[0].mapping_type = srsran_sch_mapping_type_A;
+  serving.common_time_ra[0].sliv = srsran_sliv_from_s_and_l(14, 2, 12);
+  // Deliberately incompatible dedicated settings must not affect multicast.
+  serving.mcs_table = srsran_mcs_table_256qam;
+  serving.scrambling_id_present = true;
+  serving.scambling_id = 123;
+  serving.nof_dedicated_time_ra = 1;
+  serving.dedicated_time_ra[0].k = 3;
+  srsran_sch_cfg_nr_t pdsch{};
+  CHECK(srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  CHECK(pdsch.grant.rnti == 0xfe01 && pdsch.grant.rnti_type == srsran_rnti_type_p);
+  CHECK(pdsch.grant.k == 0 && pdsch.grant.S == 2 && pdsch.grant.L == 12);
+  CHECK(pdsch.grant.nof_prb == 10 && pdsch.grant.prb_idx[3] && pdsch.grant.prb_idx[12]);
+  CHECK(pdsch.sch_cfg.mcs_table == srsran_mcs_table_64qam && !pdsch.scrambling_id_present);
+  CHECK(pdsch.grant.tb[0].tbs > 0);
+  test_symbols(carrier, pdsch);
+  rx.time_domain_assigment = 1;
+  CHECK(!srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  rx.time_domain_assigment = 0;
+  serving.common_time_ra[0].k = 1;
+  CHECK(!srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  serving.nof_common_time_ra = 0;
+  CHECK(srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  serving.typeA_pos = srsran_dmrs_sch_typeA_pos_3;
+  CHECK(srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  CHECK(pdsch.dmrs.typeA_pos == srsran_dmrs_sch_typeA_pos_3);
+  rx.smi = 2;
+  CHECK(!srsue::nr::make_ocudu_mbs_pdsch(carrier, slot, serving, rx, pdsch));
+  std::cout << "OCUDU MBS paging-format grant tests passed\n";
+}
diff --git a/srsue/test/mbs/ocudu_mbs_rx_test.cc b/srsue/test/mbs/ocudu_mbs_rx_test.cc
new file mode 100644
index 000000000..d6de07910
--- /dev/null
+++ b/srsue/test/mbs/ocudu_mbs_rx_test.cc
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#include "srsue/hdr/stack/mbs/ocudu_mbs_rx.h"
+#include <cstdlib>
+#include <iostream>
+#include <random>
+
+#define CHECK(x) do { if (!(x)) { std::cerr << "Failed line " << __LINE__ << ": " #x << '\n'; std::exit(1); } } while (0)
+using rx_type = srsue::ocudu_mbs_rx;
+using packet = rx_type::packet;
+static packet mac(packet rlc, unsigned lcid = 1, bool long_length = false)
+{
+  packet tb{uint8_t(lcid | (long_length ? 0x40 : 0))};
+  if (long_length) tb.push_back(rlc.size() >> 8);
+  tb.push_back(rlc.size() & 255);
+  tb.insert(tb.end(), rlc.begin(), rlc.end());
+  tb.push_back(63);
+  return tb;
+}
+static std::vector<packet> consume(rx_type& rx, packet data, uint64_t time = 0)
+{
+  return rx.consume(data.data(), data.size(), 1, time);
+}
+int main()
+{
+  rx_type rx;
+  const packet payload{0x47, 0x12, 0x34, 0x56};
+  CHECK(consume(rx, mac({0, 0x80, 0, 0x47, 0x12, 0x34, 0x56})) == std::vector<packet>{payload});
+  CHECK(consume(rx, mac({0, 0x80, 0, 0x47})).empty()); // PDCP duplicate
+  CHECK(rx.stats.duplicates == 1);
+  CHECK(consume(rx, mac({0, 0x80, 1, 0x47}, 2)).empty()); // MRB isolation
+  CHECK(consume(rx, mac({0, 0x80, 1, 0x47}, 1, true)).size() == 1);
+
+  // Last segment can finish decoding before first on another PHY worker.
+  CHECK(consume(rx, mac({0x85, 0, 4, 0x34, 0x56})).empty());
+  CHECK(consume(rx, mac({0x45, 0x80, 2, 0x47, 0x12})) == std::vector<packet>{payload});
+  CHECK(consume(rx, mac({0x46, 0x80, 3})).empty());
+  CHECK(consume(rx, mac({0xc6, 0, 2, 0x47, 0x12})).empty());
+  CHECK(consume(rx, mac({0xc6, 0, 2, 0x47, 0x12})).empty()); // duplicate segment
+  CHECK(consume(rx, mac({0x86, 0, 4, 0x34, 0x56})) == std::vector<packet>{payload});
+
+  // Missing segment expires and cannot contaminate reuse of the six-bit SN.
+  CHECK(consume(rx, mac({0x47, 0x80, 4}), 10).empty());
+  rx.expire(211);
+  CHECK(rx.stats.expired == 1);
+  CHECK(consume(rx, mac({0x47, 0x80, 5, 0x47, 0x12}), 212).empty());
+  CHECK(consume(rx, mac({0x87, 0, 4, 0x34, 0x56}), 213) == std::vector<packet>{payload});
+
+  // Overlapping and inconsistent segments must never produce video bytes.
+  CHECK(consume(rx, mac({0x48, 0x80, 6, 0x47}), 214).empty());
+  CHECK(consume(rx, mac({0x88, 0, 2, 0x12}), 215).empty());
+  CHECK(rx.stats.malformed == 1);
+  CHECK(consume(rx, {1, 200, 0}).empty());
+  CHECK(consume(rx, {0x41, 0}).empty());
+  CHECK(consume(rx, mac({1, 0x80, 6, 0x47})).empty()); // RLC reserved bits
+  CHECK(consume(rx, mac({0, 0x90, 6, 0x47})).empty()); // PDCP reserved bits
+  CHECK(consume(rx, mac({0, 0x00, 6, 0x47})).empty()); // control PDCP
+
+  // A malformed trailing subheader must not partially deliver the TB.
+  auto corrupt = mac({0, 0x80, 7, 0x47});
+  corrupt.back() = 1;
+  auto before = rx.stats.delivered;
+  CHECK(consume(rx, corrupt).empty());
+  CHECK(rx.stats.delivered == before);
+
+  rx_type wrap;
+  CHECK(consume(wrap, mac({0, 0x8f, 0xff, 0x47})).size() == 1);
+  CHECK(consume(wrap, mac({0, 0x80, 0, 0x47})).size() == 1);
+  CHECK(consume(wrap, mac({0, 0x8f, 0xff, 0x47})).empty());
+  CHECK(consume(wrap, mac({0, 0x80, 0, 0x47}), 201).size() == 1); // idle restart
+
+  // Real two-byte MAC length, multiple SDUs and bearer isolation in one TB.
+  rx_type large_rx;
+  packet large(400, 0x47);
+  packet large_pdu{0, 0x80, 0};
+  large_pdu.insert(large_pdu.end(), large.begin(), large.end());
+  CHECK(consume(large_rx, mac(large_pdu, 1, true)) == std::vector<packet>{large});
+  auto joined = mac({0, 0x80, 1, 0x47});
+  joined.pop_back();
+  auto second = mac({0, 0x80, 2, 0x12});
+  joined.insert(joined.end(), second.begin(), second.end());
+  CHECK(consume(large_rx, joined) == (std::vector<packet>{{0x47}, {0x12}}));
+  CHECK(consume(large_rx, mac({0x81, 0, 4, 0x47}), 1).empty()); // no first segment
+  large_rx.expire(202);
+  CHECK(large_rx.stats.expired == 1);
+
+  // PDCP completion order may differ from SN order when RLC segments are lost.
+  rx_type ordered;
+  CHECK(consume(ordered, mac({0, 0x80, 0, 0})).size() == 1);
+  CHECK(consume(ordered, mac({0, 0x80, 2, 2}), 1).empty());
+  CHECK(consume(ordered, mac({0, 0x80, 1, 1}), 2) == (std::vector<packet>{{1}, {2}}));
+  CHECK(consume(ordered, mac({0, 0x80, 4, 4}), 3).empty());
+  CHECK(ordered.poll(42).empty());
+  CHECK(ordered.poll(43) == (std::vector<packet>{{4}}));
+  CHECK(ordered.stats.pdcp_lost == 1 && ordered.stats.reorder_timeouts == 1);
+  CHECK(consume(ordered, mac({0, 0x80, 3, 3}), 44).empty()); // too late
+  CHECK(consume(ordered, mac({0, 0x80, 6, 6}), 45).empty());
+  ordered.reset();
+  CHECK(ordered.poll(100).empty()); // no delivery from the previous session
+  CHECK(consume(ordered, mac({0, 0x80, 0, 0}), 101).size() == 1);
+
+  rx_type ordered_wrap;
+  CHECK(consume(ordered_wrap, mac({0, 0x8f, 0xfe, 0})).size() == 1);
+  CHECK(consume(ordered_wrap, mac({0, 0x80, 0, 2}), 1).empty());
+  CHECK(consume(ordered_wrap, mac({0, 0x8f, 0xff, 1}), 2) == (std::vector<packet>{{1}, {2}}));
+
+  // Expiry releases only up to RX_REORD, then starts a new timer for a later gap.
+  rx_type timers;
+  CHECK(consume(timers, mac({0, 0x80, 0, 0})).size() == 1);
+  CHECK(consume(timers, mac({0, 0x80, 2, 2}), 1).empty());
+  CHECK(consume(timers, mac({0, 0x80, 4, 4}), 20).empty());
+  CHECK(timers.poll(41) == (std::vector<packet>{{2}}));
+  CHECK(timers.poll(80).empty());
+  CHECK(timers.poll(81) == (std::vector<packet>{{4}}));
+  CHECK(timers.stats.pdcp_lost == 2);
+
+  rx_type extended;
+  CHECK(extended.configure(12, 18, 40, 10));
+  CHECK(consume(extended, mac({0, 0x83, 0xff, 0xfe, 0x47})).size() == 1);
+  CHECK(consume(extended, mac({0, 0x80, 0, 0, 0x49}), 1).empty());
+  CHECK(consume(extended, mac({0, 0x83, 0xff, 0xff, 0x48}), 2) ==
+        (std::vector<packet>{{0x48}, {0x49}}));
+  CHECK(consume(extended, mac({0, 0x83, 0xff, 0xff, 0x48}), 3).empty());
+  CHECK(consume(extended, mac({0, 0x84, 0, 1, 0x47}), 4).empty()); // reserved PDCP18 bit
+  CHECK(consume(extended, mac({0x50, 0, 0x80, 0, 1}), 5).empty()); // reserved RLC12 bit
+  CHECK(consume(extended, mac({0, 0x80, 0, 0, 0x49}), 300).empty()); // no idle reset under MCCH
+
+  // Default broadcast zero timer immediately releases a PDCP gap.
+  rx_type immediate;
+  CHECK(immediate.configure(12, 18, 0, 0));
+  CHECK(consume(immediate, mac({0, 0x80, 0, 0, 0x47})).size() == 1);
+  CHECK(consume(immediate, mac({0, 0x80, 0, 2, 0x49}), 1) == (std::vector<packet>{{0x49}}));
+  CHECK(immediate.stats.pdcp_lost == 1);
+
+  // TS 38.322: a contiguous first segment has no internal gap and must not
+  // expire merely because its last segment has not arrived yet.
+  rx_type window;
+  CHECK(window.configure(6, 12, 40, 0));
+  CHECK(consume(window, mac({0x40, 0x80, 0, 0x47}), 0).empty());
+  CHECK(window.poll(100).empty() && window.stats.expired == 0);
+  CHECK(consume(window, mac({0x80, 0, 3, 0x48}), 101) == (std::vector<packet>{{0x47, 0x48}}));
+  // Missing bytes in SN1 start the shared timer. A later SN2 does not extend
+  // its deadline or get discarded when the earlier trigger expires.
+  CHECK(consume(window, mac({0x81, 0, 3, 0x48}), 102).empty());
+  CHECK(consume(window, mac({0x42, 0x80, 2, 0x49}), 110).empty());
+  CHECK(window.poll(141).empty() && window.stats.expired == 0);
+  CHECK(window.poll(142).empty() && window.stats.expired == 1);
+  CHECK(consume(window, mac({0x82, 0, 3, 0x50}), 143) == (std::vector<packet>{{0x49, 0x50}}));
+  CHECK(consume(window, mac({0x41, 0x80, 1, 0x47}), 144).empty());
+  CHECK(consume(window, mac({0x81, 0, 3, 0x48}), 145).empty()); // expired SN cannot revive
+  rx_type mcch;
+  mcch.configure_mcch();
+  for (unsigned n = 0; n < 70; ++n) {
+    auto head = mac({uint8_t(0x40 | (n & 63)), 0xaa}, 0);
+    auto tail = mac({uint8_t(0x80 | (n & 63)), 0, 1, 0xbb}, 0);
+    CHECK(mcch.consume(head.data(), head.size(), 0, n * 2).empty());
+    CHECK(mcch.consume(tail.data(), tail.size(), 0, n * 2 + 1) == (std::vector<packet>{{0xaa, 0xbb}}));
+    CHECK(mcch.consume(tail.data(), tail.size(), 0, n * 2 + 1).empty());
+  }
+  rx_type window12;
+  CHECK(window12.configure(12, 18, 0, 0));
+  for (unsigned n = 0; n < 4; ++n) {
+    const unsigned sn = (4094 + n) & 4095;
+    CHECK(consume(window12, mac({uint8_t(0x40 | (sn >> 8)), uint8_t(sn), 0x80, 0, uint8_t(n), 0x47}),
+                  n * 2).empty());
+    CHECK(consume(window12, mac({uint8_t(0x80 | (sn >> 8)), uint8_t(sn), 0, 4, 0x48}), n * 2 + 1) ==
+          (std::vector<packet>{{0x47, 0x48}}));
+  }
+
+  // Deterministic malformed-input stress; also run under ASan/UBSan.
+  std::mt19937 random(1717);
+  for (unsigned i = 0; i < 50000; ++i) {
+    packet bytes(random() % 300);
+    for (auto& byte : bytes) byte = random();
+    rx.consume(bytes.data(), bytes.size(), 1, 1000 + i);
+    extended.consume(bytes.data(), bytes.size(), 1, 1000 + i);
+  }
+  std::cout << "OCUDU MBS framing/reassembly tests passed\n";
+}
