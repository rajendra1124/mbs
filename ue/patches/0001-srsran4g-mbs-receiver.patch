@@ -0,0 +1,81 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+CONFIG="${1:-${REPO_DIR}/srsue/ue_ocudu_b210_n78_unicast.conf.example}"
+SRSUE_BIN="${SRSUE_BIN:-${REPO_DIR}/build/srsue/src/srsue}"
+MBS_BIN="${MBS_BIN:-${REPO_DIR}/build-mbs-local/srsue/src/srsue_mbs}"
+
+failures=0
+
+check_file()
+{
+  local path="$1"
+  local label="$2"
+  if [[ -e "${path}" ]]; then
+    echo "OK: ${label}: ${path}"
+  else
+    echo "MISSING: ${label}: ${path}"
+    failures=$((failures + 1))
+  fi
+}
+
+check_exe()
+{
+  local path="$1"
+  local label="$2"
+  if [[ -x "${path}" ]]; then
+    echo "OK: ${label}: ${path}"
+  else
+    echo "MISSING: ${label}: ${path}"
+    failures=$((failures + 1))
+  fi
+}
+
+check_cmd()
+{
+  local cmd="$1"
+  local label="$2"
+  if command -v "${cmd}" >/dev/null 2>&1; then
+    echo "OK: ${label}: $(command -v "${cmd}")"
+  else
+    echo "MISSING: ${label}: ${cmd}"
+    failures=$((failures + 1))
+  fi
+}
+
+check_file "${CONFIG}" "UE config"
+check_exe "${SRSUE_BIN}" "srsUE binary"
+check_exe "${MBS_BIN}" "MBS receiver binary"
+check_cmd ip "iproute2"
+check_cmd ping "ping"
+
+if command -v uhd_find_devices >/dev/null 2>&1; then
+  echo "OK: UHD tools: $(command -v uhd_find_devices)"
+  if uhd_find_devices >/tmp/srsran_ocudu_uhd_find_devices.log 2>&1; then
+    echo "OK: UHD device discovery completed"
+  else
+    echo "WARN: UHD device discovery failed; see /tmp/srsran_ocudu_uhd_find_devices.log"
+  fi
+else
+  echo "WARN: UHD tools not found; install UHD for B200/B210 RF use"
+fi
+
+echo
+echo "Configured OCUDU target:"
+echo "  PLMN/TAC: 99970 / 1"
+echo "  NR band:  n78"
+echo "  ARFCN:    632628"
+echo "  BW/SCS:   20 MHz / 30 kHz"
+echo "  Slice:    SST 1, SD 16777215"
+echo "  DNN:      internet"
+echo
+echo "Capability boundary:"
+echo "  This checkout can be used for ordinary NR SA attach/PDU-session testing."
+echo "  srsue_mbs implements the tested receive-only broadcast MBS path."
+echo "  Live SDR/video and connected multicast still require separate validation."
+
+if [[ "${failures}" -ne 0 ]]; then
+  exit 1
+fi
