+#include "srsue/hdr/stack/mbs/mbs_control.h"
+#include "srsue/hdr/phy/nr/mbs_dci.h"
+#include "mbs_control_fixture.h"
+#include <cstdlib>
+#include <iostream>
+#include <random>
+#define CHECK(x) do { if (!(x)) { std::cerr << "Failed line " << __LINE__ << ": " #x << '\n'; std::exit(1); } } while (0)
+using namespace asn1;
+namespace mbs = asn1::rrc_nr::mbs;
+using bytes = std::vector<uint8_t>;
+template<class T> bytes encode(const T& value)
+{
+  bytes out(8192);
+  bit_ref bits(out.data(), out.size());
+  CHECK(value.pack(bits) == SRSASN_SUCCESS);
+  out.resize((bits.distance() + 7) / 8);
+  return out;
+}
+static bytes make_si(unsigned offset = 1, unsigned start = 2)
+{
+  mbs::sib20_r17_s sib;
+  sib.mcch_cfg_r17.mcch_repeat_period_and_offset_r17.set_rf4_r17() = offset;
+  sib.mcch_cfg_r17.mcch_win_start_slot_r17 = start;
+  sib.mcch_cfg_r17.mcch_win_dur_r17_present = true;
+  sib.mcch_cfg_r17.mcch_win_dur_r17 = mbs::mcch_cfg_r17_s::mcch_win_dur_r17_opts::sl4;
+  sib.mcch_cfg_r17.mcch_mod_period_r17 = mbs::mcch_cfg_r17_s::mcch_mod_period_r17_opts::rf32;
+  auto payload = encode(sib);
+  bytes result(128);
+  bit_ref bits(result.data(), result.size());
+  CHECK(bits.pack(0, 5) == SRSASN_SUCCESS); // BCCH and SI roots; no late/noncritical extension
+  CHECK(pack_integer(bits, 2U, 1U, 32U) == SRSASN_SUCCESS);
+  // Unknown extension SIB19 must not prevent finding the following SIB20.
+  CHECK(bits.pack(1, 1) == SRSASN_SUCCESS);
+  CHECK(pack_norm_small_non_neg_whole_number(bits, 9U) == SRSASN_SUCCESS);
+  CHECK(pack_length(bits, 1U) == SRSASN_SUCCESS);
+  CHECK(bits.pack(0, 8) == SRSASN_SUCCESS);
+  CHECK(bits.pack(1, 1) == SRSASN_SUCCESS);
+  CHECK(pack_norm_small_non_neg_whole_number(bits, 10U) == SRSASN_SUCCESS);
+  CHECK(pack_length(bits, uint32_t(payload.size())) == SRSASN_SUCCESS);
+  for (auto byte : payload) CHECK(bits.pack(byte, 8) == SRSASN_SUCCESS);
+  result.resize((bits.distance() + 7) / 8);
+  return result;
+}
+static mbs::mcch_msg_r17_s make_mcch(unsigned rnti = 0xfe01, bool large_sn = false)
+{
+  mbs::mcch_msg_r17_s msg;
+  auto& cfg = msg.msg.set_c1().set_mbs_broadcast_cfg_r17().crit_exts.set_mbs_broadcast_cfg_r17();
+  cfg.mbs_session_info_list_r17.resize(1);
+  auto& session = cfg.mbs_session_info_list_r17[0];
+  session.mbs_session_id_r17.plmn_id_r17.set_plmn_idx() = 1;
+  session.mbs_session_id_r17.service_id_r17.from_string("000001");
+  session.g_rnti_r17 = rnti;
+  session.mrb_list_broadcast_r17.resize(2);
+  unsigned lcid = 1;
+  for (auto& mrb : session.mrb_list_broadcast_r17) {
+    mrb.pdcp_cfg_r17.pdcp_sn_size_dl_r17_present = !large_sn;
+    mrb.pdcp_cfg_r17.hdr_compress_r17.set_not_used();
+    mrb.pdcp_cfg_r17.t_reordering_r17_present = true;
+    mrb.pdcp_cfg_r17.t_reordering_r17 = mbs::mrb_pdcp_cfg_broadcast_r17_s::t_reordering_r17_opts::ms10;
+    mrb.rlc_cfg_r17.sn_field_len_r17_present = !large_sn;
+    mrb.rlc_cfg_r17.t_reassembly_r17_present = true;
+    mrb.rlc_cfg_r17.t_reassembly_r17 = asn1::rrc_nr::t_reassembly_opts::ms40;
+    mrb.rlc_cfg_r17.lc_ch_id_r17 = lcid++;
+  }
+  return msg;
+}
+int main()
+{
+  // Fixed bit vector checks the 4_0 wire layout independently of pack().
+  srsran_dci_msg_nr_t wire{};
+  wire.ctx.rnti = 0xfffd;
+  const std::string known = "011100100000000000110001100000000000000";
+  wire.nof_bits = known.size();
+  for (unsigned i = 0; i < known.size(); ++i) wire.payload[i] = known[i] - '0';
+  srsran_dci_dl_nr_t grant{};
+  unsigned notification = 0;
+  CHECK(srsue::nr::unpack_mbs_dci_4_0(wire, 48, grant, notification));
+  CHECK(grant.freq_domain_assigment == 912 && grant.mcs == 6 && grant.rv == 0 && notification == 3);
+  wire.ctx.rnti = 0x1234;
+  CHECK(!srsue::nr::unpack_mbs_dci_4_0(wire, 48, grant, notification)); // reserved notification bits
+  wire.ctx.rnti = 0xfffd;
+  wire.payload[wire.nof_bits - 1] = 1;
+  CHECK(!srsue::nr::unpack_mbs_dci_4_0(wire, 48, grant, notification)); // nonzero alignment padding
+  srsue::mbs_control rx({1, 1, 0});
+  const auto si = make_si();
+  CHECK(rx.system_information(si.data(), si.size()));
+  CHECK(rx.has_sib20() && !rx.active());
+  CHECK(!rx.mcch_slot(21, 20) && rx.mcch_slot(22, 20) && rx.mcch_slot(25, 20) && !rx.mcch_slot(26, 20));
+  CHECK(rx.mcch_slot(102, 20));
+  srsue::mbs_control crossing({1, 1, 0});
+  auto wrapped_si = make_si(3, 18);
+  CHECK(crossing.system_information(wrapped_si.data(), wrapped_si.size()));
+  CHECK(crossing.mcch_slot(78, 20) && crossing.mcch_slot(79, 20) && crossing.mcch_slot(0, 20) &&
+        crossing.mcch_slot(1, 20) && !crossing.mcch_slot(2, 20));
+  auto message = encode(make_mcch());
+  CHECK(rx.mcch(message.data(), message.size()) && rx.active() && rx.rnti() == 0xfe01);
+  const auto revision = rx.generation();
+  CHECK(rx.mcch(message.data(), message.size()) && rx.generation() == revision);
+  // Two MRBs may use the same PDCP SN without suppressing each other.
+  const bytes tb = {1, 4, 0, 0x80, 0, 0x47, 2, 4, 0, 0x80, 0, 0x48, 63};
+  auto out = rx.consume(tb.data(), tb.size(), 0);
+  CHECK(out.size() == 2 && out[0].lcid == 1 && out[0].bytes[0] == 0x47 && out[1].lcid == 2);
+  CHECK(rx.consume(tb.data(), tb.size(), 1).empty());
+  CHECK(rx.mcch(message.data(), message.size()));
+  CHECK(rx.consume(tb.data(), tb.size(), 2).empty()); // repeated MCCH preserves bearer sequence state
+  const bytes gap = {1, 4, 0, 0x80, 2, 0x49, 63};
+  CHECK(rx.consume(gap.data(), gap.size(), 3).empty());
+  CHECK(rx.poll(12).empty() && rx.poll(13).size() == 1); // MCCH-configured 10 ms timer
+  CHECK(rx.metrics().delivered == 3 && rx.metrics().pdcp_lost == 1);
+  CHECK(!rx.mcch(message.data(), 1) && rx.active()); // malformed control must not release active MRBs
+  // A valid group/config change replaces state, including PDCP/RLC SN sizes.
+  message = encode(make_mcch(0xfe02, true));
+  CHECK(rx.mcch(message.data(), message.size()) && rx.rnti() == 0xfe02 && rx.generation() > revision);
+  const bytes big = {1, 5, 0, 0x80, 0, 0, 0x47, 63};
+  CHECK(rx.consume(big.data(), big.size(), 14).size() == 1);
+  const bytes first = {1, 6, 0x4a, 0xbc, 0x80, 0, 1, 0x47, 63};
+  const bytes last = {1, 5, 0x8a, 0xbc, 0, 4, 0x48, 63};
+  CHECK(rx.consume(first.data(), first.size(), 15).empty());
+  out = rx.consume(last.data(), last.size(), 16);
+  CHECK(out.size() == 1 && out[0].bytes == (bytes{0x47, 0x48}));
+  // Empty authoritative session list releases the selected service.
+  mbs::mcch_msg_r17_s release;
+  release.msg.set_c1().set_mbs_broadcast_cfg_r17().crit_exts.set_mbs_broadcast_cfg_r17();
+  message = encode(release);
+  CHECK(rx.mcch(message.data(), message.size()) && !rx.active());
+  CHECK(rx.metrics().delivered == 5 && rx.metrics().pdcp_lost == 1); // release preserves counters
+  CHECK(rx.consume(tb.data(), tb.size(), 17).empty());
+  // The gNB's invalid advertised G-RNTI is never silently inferred from TMGI.
+  message = encode(make_mcch(0xffff));
+  CHECK(rx.mcch(message.data(), message.size()) && !rx.active());
+  srsue::mbs_control override_rx({1, 1, 0xfe01});
+  CHECK(override_rx.mcch(message.data(), message.size()) && override_rx.active());
+  override_rx.reset();
+  CHECK(!override_rx.active() && !override_rx.has_sib20());
+  // Standard MCCH MAC (LCID0) -> RLC UM6 -> RRC, with no PDCP header.
+  message = encode(make_mcch(0x1234));
+  bytes transport{0, uint8_t(message.size() + 1), 0};
+  transport.insert(transport.end(), message.begin(), message.end());
+  transport.push_back(63);
+  CHECK(rx.mcch_transport(transport.data(), transport.size(), 100));
+  CHECK(rx.active() && rx.rnti() == 0x1234);
+  auto explicit_message = make_mcch(0x2345);
+  auto& plmn = explicit_message.msg.c1().mbs_broadcast_cfg_r17().crit_exts.mbs_broadcast_cfg_r17()
+                   .mbs_session_info_list_r17[0].mbs_session_id_r17.plmn_id_r17.set_explicit_value();
+  plmn.mcc_present = true;
+  plmn.mcc[0] = 0; plmn.mcc[1] = 0; plmn.mcc[2] = 1;
+  plmn.mnc.resize(2); plmn.mnc[0] = 0; plmn.mnc[1] = 1;
+  srsue::mbs_control::selection wanted{1, 1, 0};
+  wanted.explicit_plmn = "00101";
+  srsue::mbs_control explicit_rx(wanted);
+  message = encode(explicit_message);
+  CHECK(explicit_rx.mcch(message.data(), message.size()) && explicit_rx.rnti() == 0x2345);
+  // A two-digit MNC must not alias its three-digit representation.
+  plmn.mnc.resize(3); plmn.mnc[0] = 0; plmn.mnc[1] = 0; plmn.mnc[2] = 1;
+  message = encode(explicit_message);
+  CHECK(explicit_rx.mcch(message.data(), message.size()) && !explicit_rx.active());
+  // SIB1 resolves indexed TMGIs by PLMN, including MCC inheritance and
+  // multiple PLMN-IdentityInfo entries. An explicit selection must not fall
+  // back to the default index before SIB1 has identified that network.
+  srsue::mbs_control indexed_rx({1, 1, 0, "99970"});
+  message = mbs_fixture::mcch(0x2345);
+  CHECK(indexed_rx.mcch(message.data(), message.size()) && !indexed_rx.active());
+  auto cell = mbs_fixture::sib1();
+  auto cell_bytes = mbs_fixture::sib1_message(cell);
+  CHECK(indexed_rx.system_information(cell_bytes.data(), cell_bytes.size()) && indexed_rx.has_sib1());
+  CHECK(indexed_rx.mcch(message.data(), message.size()) && indexed_rx.active());
+  const auto before = indexed_rx.generation();
+  CHECK(indexed_rx.system_information(cell_bytes.data(), cell_bytes.size()) && indexed_rx.generation() == before);
+  auto& identities = cell.cell_access_related_info.plmn_id_list[0].plmn_id_list;
+  identities.resize(2); identities[1].mnc.resize(3);
+  identities[1].mnc[0] = 0; identities[1].mnc[1] = 7; identities[1].mnc[2] = 0;
+  cell_bytes = mbs_fixture::sib1_message(cell);
+  CHECK(indexed_rx.system_information(cell_bytes.data(), cell_bytes.size()) && !indexed_rx.active());
+  auto indexed_msg = make_mcch(0x2345);
+  indexed_msg.msg.c1().mbs_broadcast_cfg_r17().crit_exts.mbs_broadcast_cfg_r17()
+      .mbs_session_info_list_r17[0].mbs_session_id_r17.plmn_id_r17.set_plmn_idx() = 2;
+  message = encode(indexed_msg);
+  CHECK(indexed_rx.mcch(message.data(), message.size()) && !indexed_rx.active());
+  srsue::mbs_control inherited_rx({1, 1, 0, "999070"});
+  CHECK(inherited_rx.system_information(cell_bytes.data(), cell_bytes.size()));
+  CHECK(inherited_rx.mcch(message.data(), message.size()) && inherited_rx.active());
+  // Radio callback rejection leaves the last valid SIB1 and its MRBs intact.
+  inherited_rx.configure_sib1 = [](const mbs::sib1_s&, std::string& error) { error = "rejected test config"; return false; };
+  cell.cell_sel_info_present = true; cell.cell_sel_info.q_rx_lev_min = -65;
+  cell_bytes = mbs_fixture::sib1_message(cell);
+  CHECK(!inherited_rx.system_information(cell_bytes.data(), cell_bytes.size()) && inherited_rx.active());
+  // Late SIB1 acquisition invalidates an already active bootstrap MRB.
+  srsue::mbs_control late_sib1({1, 1, 0});
+  message = mbs_fixture::mcch(0x2345);
+  CHECK(late_sib1.mcch(message.data(), message.size()) && late_sib1.active());
+  cell_bytes = mbs_fixture::sib1_message();
+  CHECK(late_sib1.system_information(cell_bytes.data(), cell_bytes.size()) && !late_sib1.active());
+  CHECK(late_sib1.mcch(message.data(), message.size()) && late_sib1.active());
+  unsigned radio_updates = 0;
+  late_sib1.configure_sib20 = [&](const mbs::sib20_r17_s&, std::string&) { ++radio_updates; return true; };
+  CHECK(late_sib1.system_information(si.data(), si.size()));
+  CHECK(late_sib1.mcch(message.data(), message.size()) && late_sib1.active());
+  CHECK(late_sib1.system_information(si.data(), si.size()) && radio_updates == 1 && late_sib1.active());
+  auto changed_si = make_si(2, 2);
+  CHECK(late_sib1.system_information(changed_si.data(), changed_si.size()) && radio_updates == 2 && !late_sib1.active());
+  std::cout << "MBS SIB20/MCCH, MRB lifecycle, sequence lengths and timer tests passed\n";
+}
