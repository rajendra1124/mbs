diff --git a/srsue/src/stack/mbs_control.cc b/srsue/src/stack/mbs_control.cc
new file mode 100644
index 000000000..d54fb7c22
--- /dev/null
+++ b/srsue/src/stack/mbs_control.cc
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#include "srsue/hdr/stack/mbs/mbs_control.h"
+#include <array>
+#include <set>
+
+namespace srsue {
+using namespace asn1;
+using namespace asn1::rrc_nr;
+namespace mbs = asn1::rrc_nr::mbs;
+
+namespace {
+// Decode the SystemInformation envelope independently of the Release 15 SIB
+// CHOICE. Extension choices are length-delimited UPER open types. Unknown SIBs
+// are skipped; SIB20 (extension index 10) is decoded with the MBS ASN.1 codec.
+SRSASN_CODE decode_si(cbit_ref& bits, mbs::sib20_r17_s& sib20, bool& found)
+{
+  unsigned choice = 0;
+  HANDLE_CODE(bits.unpack(choice, 3)); // c1, systemInformation, criticalExtensions.systemInformation
+  if (choice != 0) return SRSASN_ERROR_DECODE_FAIL;
+  bool late = false, future = false;
+  HANDLE_CODE(bits.unpack(late, 1));
+  HANDLE_CODE(bits.unpack(future, 1));
+  unsigned count = 0;
+  HANDLE_CODE(unpack_integer(count, bits, 1U, 32U));
+  for (unsigned i = 0; i < count; ++i) {
+    bool ext = false;
+    HANDLE_CODE(bits.unpack(ext, 1));
+    if (!ext) {
+      unsigned index = 0;
+      HANDLE_CODE(bits.unpack(index, 3));
+      sys_info_ies_s::sib_type_and_info_item_c_ sib;
+      sib.set(static_cast<sys_info_ies_s::sib_type_and_info_item_c_::types::options>(index));
+      switch (index) {
+        case 0: HANDLE_CODE(sib.sib2().unpack(bits)); break;
+        case 1: HANDLE_CODE(sib.sib3().unpack(bits)); break;
+        case 2: HANDLE_CODE(sib.sib4().unpack(bits)); break;
+        case 3: HANDLE_CODE(sib.sib5().unpack(bits)); break;
+        case 4: HANDLE_CODE(sib.sib6().unpack(bits)); break;
+        case 5: HANDLE_CODE(sib.sib7().unpack(bits)); break;
+        case 6: HANDLE_CODE(sib.sib8().unpack(bits)); break;
+        case 7: HANDLE_CODE(sib.sib9().unpack(bits)); break;
+      }
+    } else {
+      unsigned index = 0, length = 0;
+      HANDLE_CODE(unpack_norm_small_non_neg_whole_number(index, bits));
+      HANDLE_CODE(unpack_length(length, bits));
+      if (length > 65535) return SRSASN_ERROR_DECODE_FAIL;
+      std::vector<uint8_t> bytes(length);
+      for (auto& byte : bytes) HANDLE_CODE(bits.unpack(byte, 8));
+      if (index == 10) {
+        if (found) return SRSASN_ERROR_DECODE_FAIL;
+        cbit_ref field(bytes.data(), bytes.size());
+        HANDLE_CODE(sib20.unpack(field));
+        found = true;
+      }
+    }
+  }
+  if (late) { dyn_octstring ignored; HANDLE_CODE(ignored.unpack(bits)); }
+  return SRSASN_SUCCESS;
+}
+}
+
+std::string mbs_control::plmn_identity(unsigned index) const
+{
+  if (!sib1_valid || !index) return {};
+  unsigned current = 0;
+  std::string mcc;
+  for (const auto& info : cell.cell_access_related_info.plmn_id_list) {
+    for (const auto& plmn : info.plmn_id_list) {
+      if (plmn.mcc_present) {
+        mcc.clear();
+        for (auto digit : plmn.mcc) mcc += char('0' + digit);
+      }
+      if (++current == index) {
+        if (mcc.empty()) return {};
+        std::string result = mcc;
+        for (auto digit : plmn.mnc) result += char('0' + digit);
+        return result;
+      }
+    }
+  }
+  return {};
+}
+
+bool mbs_control::system_information(const uint8_t* data, size_t size)
+{
+  message.clear();
+  if (!data || !size || size > 65535) return false;
+  if ((data[0] >> 6) == 1) {
+    cbit_ref bits(data, size);
+    unsigned choice = 0;
+    if (bits.unpack(choice, 2) != SRSASN_SUCCESS) return false;
+    mbs::sib1_s decoded;
+    if (decoded.unpack(bits) != SRSASN_SUCCESS) return false;
+    const auto used = (bits.distance() + 7) / 8;
+    std::vector<uint8_t> next(data, data + used);
+    if (sib1_valid && cell_fingerprint == next) return true;
+    if (configure_sib1 && !configure_sib1(decoded, message)) return false;
+    if (active()) { release_bearers(); fingerprint.clear(); group = 0; }
+    // Reapply SIB20/MCCH after a radio change, including an initial SIB1
+    // arriving after the compatibility bootstrap acquired MCCH.
+    system_fingerprint.clear(); fingerprint.clear();
+    cell = std::move(decoded); cell_fingerprint = std::move(next); sib1_valid = true;
+    ++revision; message = "SIB1 radio configuration acquired";
+    return true;
+  }
+  mbs::sib20_r17_s decoded;
+  bool found = false;
+  cbit_ref bits(data, size);
+  if (decode_si(bits, decoded, found) != SRSASN_SUCCESS || !found) return false;
+  const auto& cfg = decoded.mcch_cfg_r17;
+  const auto& repetition = cfg.mcch_repeat_period_and_offset_r17;
+  unsigned frames = repetition.type().to_number();
+  unsigned offset = 0;
+  switch (repetition.type().value) {
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf1_r17: offset = repetition.rf1_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf2_r17: offset = repetition.rf2_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf4_r17: offset = repetition.rf4_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf8_r17: offset = repetition.rf8_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf16_r17: offset = repetition.rf16_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf32_r17: offset = repetition.rf32_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf64_r17: offset = repetition.rf64_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf128_r17: offset = repetition.rf128_r17(); break;
+    case mbs::mcch_repeat_period_and_offset_r17_c::types::rf256_r17: offset = repetition.rf256_r17(); break;
+    default: return false;
+  }
+  if (!frames || offset >= frames) return false;
+  std::vector<uint8_t> next_system(8192);
+  bit_ref encoded(next_system.data(), next_system.size());
+  if (decoded.pack(encoded) != SRSASN_SUCCESS) return false;
+  next_system.resize((encoded.distance() + 7) / 8);
+  if (sib20_valid && next_system == system_fingerprint) return true;
+  if (configure_sib20 && !configure_sib20(decoded, message)) return false;
+  if (active() || sib20_valid) { release_bearers(); fingerprint.clear(); group = 0; ++revision; }
+  system_fingerprint = std::move(next_system);
+  repeat_frames = frames;
+  repeat_offset = offset;
+  start_slot = cfg.mcch_win_start_slot_r17;
+  duration_slots = cfg.mcch_win_dur_r17_present ? cfg.mcch_win_dur_r17.to_number() : 1;
+  system = std::move(decoded);
+  sib20_valid = true;
+  message = "SIB20 acquired";
+  return true;
+}
+
+bool mbs_control::mcch_slot(unsigned slot, unsigned slots_per_frame) const
+{
+  if (!sib20_valid || !slots_per_frame) return false;
+  const unsigned period = repeat_frames * slots_per_frame;
+  const unsigned begin = (repeat_offset * slots_per_frame + start_slot) % period;
+  const unsigned position = (slot % period + period - begin) % period;
+  return position < duration_slots;
+}
+
+bool mbs_control::mcch(const uint8_t* data, size_t size)
+{
+  if (!data || !size || size > 65535) return false;
+  mbs::mcch_msg_r17_s decoded;
+  cbit_ref bits(data, size);
+  if (decoded.unpack(bits) != SRSASN_SUCCESS || decoded.msg.type() != mbs::mcch_msg_type_r17_c::types::c1 ||
+      decoded.msg.c1().type() != mbs::mcch_msg_type_r17_c::c1_c_::types::mbs_broadcast_cfg_r17) return false;
+  const auto& critical = decoded.msg.c1().mbs_broadcast_cfg_r17().crit_exts;
+  if (critical.type() != mbs::mbs_broadcast_cfg_r17_s::crit_exts_c_::types::mbs_broadcast_cfg_r17) return false;
+  const auto& cfg = critical.mbs_broadcast_cfg_r17();
+  // RRC padding in the OCUDU transport block is zero. Without this check a
+  // different SI payload could appear to be an empty MCCH followed by garbage.
+  for (size_t i = (bits.distance() + 7) / 8; i < size; ++i) if (data[i] != 0) return false;
+  const mbs::mbs_session_info_r17_s* selected = nullptr;
+  for (const auto& session : cfg.mbs_session_info_list_r17) {
+    const auto& id = session.mbs_session_id_r17;
+    const unsigned service = (unsigned(id.service_id_r17[0]) << 16) | (id.service_id_r17[1] << 8) | id.service_id_r17[2];
+    bool plmn_matches = false;
+    if (id.plmn_id_r17.type() == mbs::tmgi_r17_s::plmn_id_r17_c_::types::plmn_idx) {
+      const unsigned index = id.plmn_id_r17.plmn_idx();
+      plmn_matches = wanted.explicit_plmn.empty() ? index == wanted.plmn_index :
+          sib1_valid && plmn_identity(index) == wanted.explicit_plmn;
+      if (sib1_valid && plmn_identity(index).empty()) plmn_matches = false;
+    } else {
+      const auto& plmn = id.plmn_id_r17.explicit_value();
+      std::string digits;
+      if (plmn.mcc_present) for (auto digit : plmn.mcc) digits += char('0' + digit);
+      for (auto digit : plmn.mnc) digits += char('0' + digit);
+      const std::string expected = wanted.explicit_plmn.empty() ? plmn_identity(wanted.plmn_index) : wanted.explicit_plmn;
+      plmn_matches = plmn.mcc_present && !expected.empty() && digits == expected;
+    }
+    if (service == wanted.service_id && plmn_matches) {
+      if (selected) { message = "MCCH has duplicate selected TMGI"; return false; }
+      selected = &session;
+    }
+  }
+  if (!selected) {
+    if (active()) { release_bearers(); fingerprint.clear(); group = 0; ++revision; }
+    message = "Selected TMGI is absent from MCCH; MRBs released";
+    return true;
+  }
+  const uint16_t next_group = wanted.rnti_override ? wanted.rnti_override : selected->g_rnti_r17;
+  auto unsupported = [&](const char* why) {
+    release_bearers(); fingerprint.clear(); group = 0; ++revision; message = why; return true;
+  };
+  if (next_group == 0 || next_group > 0xfff2)
+    return unsupported("MCCH advertises an invalid G-RNTI; explicit --rnti is required for this OCUDU profile");
+  if (!configure_mcch && (cfg.pdsch_cfg_mtch_r17_present || (sib20_valid && system.cfr_cfg_mcch_mtch_r17_present)))
+    return unsupported("Explicit broadcast PDSCH/CFR configuration requires PHY mapping not supported by this receiver");
+  std::array<uint8_t, 8192> encoded{};
+  bit_ref writer(encoded.data(), encoded.size());
+  // Include common PDSCH configuration in the fingerprint: the selected MRB
+  // can stay unchanged while MCCH changes its modulation or time allocation.
+  if (selected->pack(writer) != SRSASN_SUCCESS || writer.pack(cfg.pdsch_cfg_mtch_r17_present, 1) != SRSASN_SUCCESS ||
+      (cfg.pdsch_cfg_mtch_r17_present && cfg.pdsch_cfg_mtch_r17.pack(writer) != SRSASN_SUCCESS)) return false;
+  std::vector<uint8_t> next_fingerprint(encoded.begin(), encoded.begin() + (writer.distance() + 7) / 8);
+  if (fingerprint == next_fingerprint && group == next_group) return true;
+  std::map<unsigned, ocudu_mbs_rx> next_bearers;
+  for (const auto& mrb : selected->mrb_list_broadcast_r17) {
+    const auto& pdcp = mrb.pdcp_cfg_r17;
+    const auto& rlc = mrb.rlc_cfg_r17;
+    if (mrb.ext || pdcp.hdr_compress_r17.type() != mbs::mrb_pdcp_cfg_broadcast_r17_s::hdr_compress_r17_c_::types::not_used)
+      return unsupported("Selected MRB requires unsupported extensions or ROHC");
+    if (next_bearers.count(rlc.lc_ch_id_r17)) return unsupported("MCCH contains duplicate MRB LCIDs");
+    if (rlc.t_reassembly_r17_present && rlc.t_reassembly_r17.value >= t_reassembly_opts::spare1)
+      return unsupported("MCCH contains a reserved t-Reassembly value");
+    auto& bearer = next_bearers[rlc.lc_ch_id_r17];
+    if (!bearer.configure(rlc.sn_field_len_r17_present ? 6 : 12,
+                          pdcp.pdcp_sn_size_dl_r17_present ? 12 : 18,
+                          rlc.t_reassembly_r17_present ? rlc.t_reassembly_r17.to_number() : 0,
+                          pdcp.t_reordering_r17_present ? pdcp.t_reordering_r17.to_number() : 0))
+      return unsupported("Unsupported MRB SN size or timer");
+  }
+  if (configure_mcch && !configure_mcch(cfg, *selected, message)) {
+    release_bearers(); fingerprint.clear(); group = 0; ++revision; return true;
+  }
+  release_bearers();
+  bearers = std::move(next_bearers);
+  fingerprint = std::move(next_fingerprint);
+  group = next_group;
+  ++revision;
+  message = wanted.rnti_override && group != selected->g_rnti_r17 ?
+      "MRBs configured from MCCH with explicit G-RNTI override" : "MRBs configured from MCCH";
+  return true;
+}
+
+std::vector<mbs_control::sdu> mbs_control::consume(const uint8_t* data, size_t size, uint64_t now)
+{
+  std::vector<sdu> output;
+  for (auto& item : bearers)
+    for (auto& packet : item.second.consume(data, size, item.first, now)) output.push_back({item.first, std::move(packet)});
+  return output;
+}
+bool mbs_control::mcch_transport(const uint8_t* data, size_t size, uint64_t now)
+{
+  bool accepted = false;
+  for (const auto& packet : mcch_rx.consume(data, size, 0, now)) accepted = mcch(packet.data(), packet.size()) || accepted;
+  return accepted;
+}
+std::vector<mbs_control::sdu> mbs_control::poll(uint64_t now)
+{
+  std::vector<sdu> output;
+  for (auto& item : bearers)
+    for (auto& packet : item.second.poll(now)) output.push_back({item.first, std::move(packet)});
+  return output;
+}
+void mbs_control::reset()
+{
+  release_bearers(); fingerprint.clear(); group = 0; sib20_valid = false; ++revision;
+  sib1_valid = false; cell_fingerprint.clear(); system_fingerprint.clear();
+  mcch_rx.reset();
+  message = "Cell lost; SIB20/MCCH and MRBs released";
+}
+ocudu_mbs_rx::counters mbs_control::metrics() const
+{
+  auto total = retired;
+  for (const auto& item : bearers) total += item.second.stats;
+  return total;
+}
+void mbs_control::release_bearers()
+{
+  for (const auto& item : bearers) retired += item.second.stats;
+  bearers.clear();
+}
