+// TS 38.211 Tables 7.4.1.1.2-3/-4. Type-B positions are relative
+// to the start of the allocation, rather than the beginning of the slot.
+static int dmrs_symbols_type_b(const srsran_dmrs_sch_cfg_t* cfg,
+                               const srsran_sch_grant_nr_t* grant,
+                               uint32_t symbols[SRSRAN_DMRS_SCH_MAX_SYMBOLS])
+{
+  const unsigned length = grant->L;
+  if (length < 2 || length > 13 || grant->S + length > 14) return SRSRAN_ERROR;
+  unsigned count = 0;
+  symbols[count++] = grant->S;
+  if (cfg->length == srsran_dmrs_sch_len_2) {
+    if (length < 5 || (cfg->additional_pos != srsran_dmrs_sch_add_pos_0 &&
+                      cfg->additional_pos != srsran_dmrs_sch_add_pos_1)) return SRSRAN_ERROR;
+    symbols[count++] = grant->S + 1;
+    if (length >= 8 && cfg->additional_pos == srsran_dmrs_sch_add_pos_1) {
+      unsigned additional = length < 10 ? 5 : length < 12 ? 7 : 8;
+      symbols[count++] = grant->S + additional;
+      symbols[count++] = grant->S + additional + 1;
+    }
+    return count;
+  }
+  if (cfg->length != srsran_dmrs_sch_len_1) return SRSRAN_ERROR;
+  if (length < 5 || cfg->additional_pos == srsran_dmrs_sch_add_pos_0) return count;
+  if (cfg->additional_pos != srsran_dmrs_sch_add_pos_1 && cfg->additional_pos != srsran_dmrs_sch_add_pos_2 &&
+      cfg->additional_pos != srsran_dmrs_sch_add_pos_3) return SRSRAN_ERROR;
+  if (length <= 7) {
+    symbols[count++] = grant->S + 4;
+  } else if (length >= 11 && cfg->additional_pos == srsran_dmrs_sch_add_pos_3) {
+    for (unsigned offset = 3; offset <= 9; offset += 3) symbols[count++] = grant->S + offset;
+  } else {
+    unsigned last = length == 8 ? 6 : length <= 10 ? 7 : length == 11 ? 8 : 9;
+    if (cfg->additional_pos != srsran_dmrs_sch_add_pos_1)
+      symbols[count++] = grant->S + (length == 8 ? 3 : length <= 11 ? 4 : 5);
+    symbols[count++] = grant->S + last;
+  }
+  return count;
+}
