+  // (38.214 5.1.3.2). Rate matching uses the actual mapped data REs.
+  uint32_t reserved = srsran_re_pattern_list_count(&cfg->rvd_re, grant->S, grant->S + grant->L, grant->prb_idx);
+  if (dmrs_re < 0 || (unsigned)dmrs_re >= SRSRAN_NRE * grant->L) return SRSRAN_ERROR;
