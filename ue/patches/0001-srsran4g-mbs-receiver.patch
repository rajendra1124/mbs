diff --git a/srsue/hdr/phy/nr/mbs_dci.h b/srsue/hdr/phy/nr/mbs_dci.h
new file mode 100644
index 000000000..5d355200f
--- /dev/null
+++ b/srsue/hdr/phy/nr/mbs_dci.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#pragma once
+#include "srsran/srsran.h"
+#include <algorithm>
+
+namespace srsue { namespace nr {
+// TS 38.212 7.3.1.5.1. Input/output payload uses one byte per bit, as in
+// srsran_dci_msg_nr_t. Padding brings 4_0 to the common DCI 1_0 size.
+inline unsigned mbs_frequency_bits(unsigned prbs)
+{
+  unsigned bits = 0;
+  if (prbs < 1 || prbs > 275) return 0;
+  const unsigned values = prbs * (prbs + 1) / 2;
+  while ((1U << bits) < values) ++bits;
+  return bits;
+}
+inline bool unpack_mbs_dci_4_0(const srsran_dci_msg_nr_t& message, unsigned prbs,
+                               srsran_dci_dl_nr_t& grant, unsigned& notification)
+{
+  const unsigned frequency_bits = mbs_frequency_bits(prbs);
+  if (!frequency_bits || message.nof_bits < frequency_bits + 14 || message.nof_bits > sizeof(message.payload)) return false;
+  unsigned cursor = 0;
+  bool valid = true;
+  auto get = [&](unsigned count) {
+    unsigned value = 0;
+    for (unsigned i = 0; i < count; ++i) {
+      const uint8_t bit = message.payload[cursor++];
+      valid = valid && bit <= 1;
+      value = (value << 1) | bit;
+    }
+    return value;
+  };
+  grant = {};
+  grant.ctx = message.ctx;
+  grant.coreset0_bw = prbs;
+  // Convert only the grant representation to the common allocation helper.
+  // The incoming wire payload was decoded explicitly as 4_0, without a 1_0
+  // format identifier, short-message fields, NDI or HARQ process number.
+  grant.ctx.format = srsran_dci_format_nr_1_0;
+  grant.ctx.rnti_type = srsran_rnti_type_p;
+  grant.ctx.ss_type = srsran_search_space_type_common_2;
+  grant.smi = 1;
+  grant.freq_domain_assigment = get(frequency_bits);
+  grant.time_domain_assigment = get(4);
+  grant.vrb_to_prb_mapping = get(1);
+  grant.mcs = get(5);
+  grant.rv = get(2);
+  notification = get(2);
+  if (message.ctx.rnti != 0xfffd && notification) valid = false;
+  while (cursor < message.nof_bits) if (get(1)) valid = false;
+  return valid && grant.freq_domain_assigment < prbs * (prbs + 1) / 2;
+}
+inline bool pack_mbs_dci_4_0(const srsran_dci_dl_nr_t& grant, unsigned prbs, unsigned notification,
+                             unsigned aligned_size, srsran_dci_msg_nr_t& message)
+{
+  const unsigned frequency_bits = mbs_frequency_bits(prbs);
+  if (!frequency_bits || aligned_size < frequency_bits + 14 || aligned_size > sizeof(message.payload) ||
+      grant.freq_domain_assigment >= prbs * (prbs + 1) / 2 || grant.time_domain_assigment > 15 ||
+      grant.vrb_to_prb_mapping > 1 || grant.mcs > 31 || grant.rv > 3 || notification > 3 ||
+      (grant.ctx.rnti != 0xfffd && notification)) return false;
+  message = {};
+  message.ctx = grant.ctx;
+  message.nof_bits = aligned_size;
+  unsigned cursor = 0;
+  auto put = [&](unsigned value, unsigned count) {
+    for (unsigned i = count; i > 0; --i) message.payload[cursor++] = (value >> (i - 1)) & 1;
+  };
+  put(grant.freq_domain_assigment, frequency_bits);
+  put(grant.time_domain_assigment, 4);
+  put(grant.vrb_to_prb_mapping, 1);
+  put(grant.mcs, 5);
+  put(grant.rv, 2);
+  put(notification, 2);
+  return true;
+}
+} } // namespace srsue::nr
diff --git a/srsue/hdr/phy/nr/mbs_pdsch.h b/srsue/hdr/phy/nr/mbs_pdsch.h
new file mode 100644
index 000000000..312c15e84
--- /dev/null
+++ b/srsue/hdr/phy/nr/mbs_pdsch.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#pragma once
+#include "srsran/srsran.h"
+#include <cmath>
+#include <array>
+
+namespace srsue { namespace nr {
+struct mbs_pdsch_profile {
+  srsran_sch_hl_cfg_nr_t common{};
+  unsigned start_rb = 0, bandwidth = 0;
+  unsigned allocation_width = 0; // DCI 4_0 RIV uses CORESET0/initial-BWP width.
+  unsigned aggregation = 1;
+  std::array<unsigned, SRSRAN_MAX_NOF_TIME_RA> repetitions{};
+  unsigned repetition_count(unsigned tdra) const
+  {
+    return tdra < repetitions.size() && repetitions[tdra] ? repetitions[tdra] : aggregation;
+  }
+};
+
+// TS 38.214 Table 5.1.2.1-2, indexed by the DCI RV and occasion number.
+inline unsigned mbs_repetition_rv(unsigned initial_rv, unsigned occasion)
+{
+  static const unsigned sequence[4][4] = {{0,2,3,1}, {1,0,2,3}, {2,3,1,0}, {3,1,0,2}};
+  return sequence[initial_rv % 4][occasion % 4];
+}
+
+// Grant construction for broadcast. RNTI-dependent unicast MCS rules and
+// dedicated UE reservations are deliberately outside this path.
+inline bool make_mbs_pdsch(const srsran_carrier_nr_t& carrier, const mbs_pdsch_profile& profile,
+                           const srsran_dci_dl_nr_t& dci, srsran_sch_cfg_nr_t& result)
+{
+  const unsigned width = profile.allocation_width ? profile.allocation_width : profile.bandwidth;
+  if (!profile.bandwidth || !width || profile.start_rb + profile.bandwidth > carrier.nof_prb ||
+      dci.vrb_to_prb_mapping || dci.freq_domain_assigment >= width * (width + 1) / 2 ||
+      profile.common.nof_common_time_ra > SRSRAN_MAX_NOF_TIME_RA) return false;
+  result = {};
+  auto& grant = result.grant;
+  if (srsran_ra_dl_nr_time(&profile.common, srsran_rnti_type_p, srsran_search_space_type_common_2,
+                           0, dci.time_domain_assigment, &grant) < 0) return false;
+  if (grant.mapping == srsran_sch_mapping_type_A &&
+      grant.S > (profile.common.typeA_pos == srsran_dmrs_sch_typeA_pos_3 ? 3U : 2U)) return false;
+  unsigned length = dci.freq_domain_assigment / width + 1;
+  unsigned start = dci.freq_domain_assigment % width;
+  if (length > width - start) { length = width + 2 - length; start = width - 1 - start; }
+  unsigned scale = 1;
+  for (unsigned k : {1U, 2U, 4U, 6U, 8U, 10U, 12U}) if (k <= profile.bandwidth / width) scale = k;
+  start *= scale; length *= scale;
+  if (!length || start + length > profile.bandwidth) return false;
+  grant.nof_prb = length;
+  for (unsigned rb = profile.start_rb + start; rb < profile.start_rb + start + length; ++rb) grant.prb_idx[rb] = true;
+  grant.rnti = dci.ctx.rnti;
+  grant.rnti_type = dci.ctx.rnti_type;
+  grant.dci_format = dci.ctx.format;
+  grant.dci_search_space = dci.ctx.ss_type;
+  grant.nof_layers = 1;
+  grant.nof_dmrs_cdm_groups_without_data = grant.L == 2 ? 1 : 2;
+  grant.beta_dmrs = grant.nof_dmrs_cdm_groups_without_data == 1 ? 1.0f : srsran_convert_dB_to_amplitude(3.0f);
+  grant.tb[0].rv = dci.rv;
+  result.sch_cfg = profile.common.sch_cfg;
+  result.sch_cfg.mcs_table = profile.common.mcs_table;
+  result.scrambling_id_present = profile.common.scrambling_id_present;
+  result.scambling_id = profile.common.scambling_id;
+  result.dmrs.type = srsran_dmrs_sch_type_1;
+  result.dmrs.length = srsran_dmrs_sch_len_1;
+  result.dmrs.typeA_pos = profile.common.typeA_pos;
+  result.dmrs.additional_pos = srsran_dmrs_sch_add_pos_2;
+  result.dmrs.scrambling_id0_present = profile.common.dmrs_typeA.scrambling_id0_present;
+  result.dmrs.scrambling_id0 = profile.common.dmrs_typeA.scrambling_id0;
+  return srsran_ra_nr_fill_tb_mbs(&result, &grant, dci.mcs, &grant.tb[0]) == SRSRAN_SUCCESS;
+}
+} }
diff --git a/srsue/hdr/phy/nr/mbs_radio_config.h b/srsue/hdr/phy/nr/mbs_radio_config.h
new file mode 100644
index 000000000..278cde022
--- /dev/null
+++ b/srsue/hdr/phy/nr/mbs_radio_config.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#pragma once
+#include "mbs_pdsch.h"
+#include "srsran/asn1/mbs_rrc_nr.h"
+#include <map>
+#include <string>
+
+namespace srsue { namespace nr {
+struct mbs_search_space {
+  srsran_search_space_t phy{};
+  unsigned period = 1, offset = 0, duration = 1;
+  uint16_t symbols = 1;
+  bool monitors(unsigned slot) const { return period && (slot + period - offset) % period < duration; }
+};
+
+// All offsets refer to the captured carrier grid. Updates are validated on a
+// copy before the receiver installs them, preserving the last valid settings.
+struct mbs_radio_config {
+  srsran_carrier_nr_t carrier{};
+  srsran_pdcch_cfg_nr_t pdcch{};
+  mbs_search_space sib1, si, mcch, mtch;
+  mbs_pdsch_profile initial, mcch_pdsch, mtch_pdsch;
+  unsigned initial_start = 0, initial_width = 0;
+  bool sib1_valid = false;
+  std::vector<uint16_t> uplink_symbols;
+  bool allows_downlink(unsigned slot, unsigned start, unsigned length) const
+  {
+    if (!length || start + length > 14) return false;
+    const unsigned mask = ((1U << length) - 1) << start;
+    return uplink_symbols.empty() || !(uplink_symbols[slot % uplink_symbols.size()] & mask);
+  }
+  bool load_mib(const srsran_mib_nr_t&, std::string& error);
+  bool load_sib1(const asn1::rrc_nr::mbs::sib1_s&, std::string& error);
+  bool load_sib20(const asn1::rrc_nr::mbs::sib20_r17_s&, std::string& error);
+  bool load_mcch(const asn1::rrc_nr::mbs::mbs_broadcast_cfg_r17_ies_s&,
+                 const asn1::rrc_nr::mbs::mbs_session_info_r17_s&, std::string& error);
+};
+} }
diff --git a/srsue/hdr/phy/nr/mbs_radio_receiver.h b/srsue/hdr/phy/nr/mbs_radio_receiver.h
new file mode 100644
index 000000000..32ea65247
--- /dev/null
+++ b/srsue/hdr/phy/nr/mbs_radio_receiver.h
@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#ifndef SRSUE_MBS_RADIO_RECEIVER_H
+#define SRSUE_MBS_RADIO_RECEIVER_H
+
+#include "mbs_slot_demodulator.h"
+#include "ocudu_mbs_phy.h"
+#include "mbs_dci.h"
+#include "mbs_radio_config.h"
+#include <array>
+#include <functional>
+#include <vector>
+#include <memory>
+
+namespace srsue {
+namespace nr {
+// Receive-only group radio path. It has a slot timeline independent of the
+// legacy srsUE active-mode UL/HARQ subframe timeline.
+class mbs_radio_receiver
+{
+public:
+  struct config {
+    double rate_hz = 23.04e6, center_hz = 3489.42e6, ssb_hz = 3488.16e6;
+    unsigned scs_khz = 30, prbs = 51, pci = 1, coreset0_index = 13;
+    unsigned pdsch_start = 2, pdsch_length = 12;
+    uint16_t group_rnti = 0xfe01;
+    bool standard_mbs = false;
+    // PDCCH DMRS pre-detection gates. The library defaults (0.5, -80 dBFS)
+    // rejected ~15% of valid OCUDU MTCH DCIs over the air; 0.08 recovered all
+    // of them on the B210 testbed. The 24-bit RNTI-scrambled DCI CRC still
+    // rejects false candidates.
+    float pdcch_corr_thr = 0.08f, pdcch_epre_thr_dbfs = -120.0f;
+  };
+  struct counters { uint64_t slots = 0, dcis = 0, crc_ok = 0, crc_fail = 0, invalid_grants = 0; } stats;
+  using callback = std::function<void(uint16_t, const uint8_t*, size_t)>;
+  using control_callback = std::function<void(bool, const uint8_t*, size_t)>; // true: MCCH, false: BCCH SI
+
+  mbs_radio_receiver() = default;
+  mbs_radio_receiver(const mbs_radio_receiver&) = delete;
+  mbs_radio_receiver& operator=(const mbs_radio_receiver&) = delete;
+  ~mbs_radio_receiver()
+  {
+    srsran_ue_dl_nr_free(&dl);
+    srsran_softbuffer_rx_free(&softbuffer);
+    free(scratch);
+  }
+
+  bool init(const config& value)
+  {
+    if (ready || value.pci > 1007 || value.pdsch_start > 3 ||
+        value.pdsch_length < 3 || value.pdsch_start + value.pdsch_length > 14 ||
+        value.group_rnti == 0 || value.group_rnti > 0xfff2 || value.coreset0_index > 15 ||
+        !std::isfinite(value.ssb_hz) || value.ssb_hz <= 0 ||
+        !demod.init(value.rate_hz, value.scs_khz, value.prbs, value.center_hz)) return false;
+    cfg = value;
+    carrier.pci = cfg.pci;
+    carrier.nof_prb = cfg.prbs;
+    carrier.max_mimo_layers = 1;
+    carrier.scs = cfg.scs_khz == 30 ? srsran_subcarrier_spacing_30kHz : srsran_subcarrier_spacing_15kHz;
+    carrier.dl_center_frequency_hz = cfg.center_hz;
+    carrier.ssb_center_freq_hz = cfg.ssb_hz;
+    scratch = srsran_vec_cf_malloc(15 * srsran_min_symbol_sz_rb(cfg.prbs));
+    if (!scratch) return false;
+    cf_t* input[SRSRAN_MAX_PORTS] = {scratch};
+    srsran_ue_dl_nr_args_t args{};
+    args.nof_max_prb = cfg.prbs;
+    args.nof_rx_antennas = 1;
+    args.pdcch_dmrs_corr_thr = cfg.pdcch_corr_thr;
+    args.pdcch_dmrs_epre_thr = cfg.pdcch_epre_thr_dbfs;
+    if (srsran_ue_dl_nr_init(&dl, input, &args) != SRSRAN_SUCCESS ||
+        srsran_ue_dl_nr_set_carrier(&dl, &carrier) != SRSRAN_SUCCESS ||
+        srsran_softbuffer_rx_init_guru(&softbuffer, SRSRAN_SCH_NR_MAX_NOF_CB_LDPC,
+                                      SRSRAN_LDPC_MAX_LEN_ENCODED_CB) != SRSRAN_SUCCESS) return false;
+    const double point_a = cfg.center_hz - cfg.prbs * 6 * cfg.scs_khz * 1000;
+    if (cfg.ssb_hz < point_a || cfg.ssb_hz >= cfg.center_hz + cfg.prbs * 6 * cfg.scs_khz * 1000) return false;
+    srsran_pdcch_cfg_nr_t pdcch{};
+    pdcch.coreset_present[0] = true;
+    if (srsran_coreset_zero(cfg.pci, std::lround(cfg.ssb_hz - point_a), carrier.scs, carrier.scs,
+                            cfg.coreset0_index, &pdcch.coreset[0]) != SRSRAN_SUCCESS) return false;
+    if (srsran_coreset_start_rb(&pdcch.coreset[0]) + srsran_coreset_get_bw(&pdcch.coreset[0]) > cfg.prbs) return false;
+    auto& ss = pdcch.search_space[0];
+    pdcch.search_space_present[0] = true;
+    ss.id = 1;
+    ss.coreset_id = 0;
+    ss.type = srsran_search_space_type_common_2;
+    ss.nof_formats = 1;
+    ss.formats[0] = srsran_dci_format_nr_1_0;
+    // OCUDU make_default_common_search_space_config: one AL4 candidate.
+    // Candidate counts also determine CCE locations; searching with arbitrary
+    // larger counts is not equivalent to the configured common search space.
+    if (srsran_pdcch_nr_max_candidates_coreset(&pdcch.coreset[0], 2) == 0) return false;
+    ss.nof_candidates[2] = 1;
+    srsran_dci_cfg_nr_t dci{};
+    dci.bwp_dl_initial_bw = dci.bwp_dl_active_bw = cfg.prbs;
+    dci.bwp_ul_initial_bw = dci.bwp_ul_active_bw = cfg.prbs;
+    dci.coreset0_bw = srsran_coreset_get_bw(&pdcch.coreset[0]);
+    dci.monitor_common_0_0 = dci.monitor_0_0_and_1_0 = true;
+    if (srsran_ue_dl_nr_set_pdcch_config(&dl, &pdcch, &dci) != SRSRAN_SUCCESS) return false;
+    common.typeA_pos = srsran_dmrs_sch_typeA_pos_2;
+    common.nof_common_time_ra = 1;
+    common.common_time_ra[0].mapping_type = srsran_sch_mapping_type_A;
+    common.common_time_ra[0].sliv = cfg.pdsch_length - 1 <= 7 ?
+        14 * (cfg.pdsch_length - 1) + cfg.pdsch_start : 14 * (15 - cfg.pdsch_length) + 13 - cfg.pdsch_start;
+    settings.carrier = carrier;
+    settings.pdcch = pdcch;
+    settings.si.phy = settings.mcch.phy = settings.mtch.phy = ss;
+    settings.initial.common = common;
+    settings.initial.start_rb = srsran_coreset_start_rb(&pdcch.coreset[0]);
+    settings.initial.bandwidth = settings.initial.allocation_width = srsran_coreset_get_bw(&pdcch.coreset[0]);
+    settings.initial_start = 0; settings.initial_width = cfg.prbs;
+    settings.mcch_pdsch = settings.mtch_pdsch = settings.initial;
+    srsran_mib_nr_t assumed{};
+    assumed.scs_common = carrier.scs; assumed.coreset0_idx = cfg.coreset0_index;
+    assumed.dmrs_typeA_pos = common.typeA_pos;
+    std::string error;
+    if (!settings.load_mib(assumed, error)) return false;
+    bootstrap = settings;
+    ready = true;
+    return true;
+  }
+
+  unsigned samples_per_slot() const { return demod.samples_per_slot(); }
+  unsigned slots_per_subframe() const { return demod.slots_per_subframe(); }
+  void set_group(uint16_t rnti)
+  {
+    if (rnti != cfg.group_rnti) {
+      ++mtch_generation;
+      pending.erase(std::remove_if(pending.begin(), pending.end(), [](const scheduled& item) { return item.role == channel::mtch; }), pending.end());
+    }
+    cfg.group_rnti = rnti;
+  }
+  bool configure_mib(const srsran_mib_nr_t& mib, bool& changed, std::string& error)
+  {
+    changed = !mib_valid || mib.coreset0_idx != last_mib.coreset0_idx || mib.ss0_idx != last_mib.ss0_idx ||
+        mib.dmrs_typeA_pos != last_mib.dmrs_typeA_pos || mib.scs_common != last_mib.scs_common ||
+        mib.ssb_idx != last_mib.ssb_idx || mib.ssb_offset != last_mib.ssb_offset;
+    if (!changed) return true;
+    auto next = bootstrap;
+    if (!next.load_mib(mib, error) || !install(next, error)) return false;
+    bootstrap = next; last_mib = mib; mib_valid = true;
+    pending.clear(); ++mtch_generation;
+    return true;
+  }
+  bool reset_radio(std::string& error)
+  {
+    pending.clear(); ++mtch_generation; have_slot = false;
+    return install(bootstrap, error);
+  }
+  void set_control_handler(control_callback handler) { control_handler = std::move(handler); }
+  const mbs_radio_config& radio_config() const { return settings; }
+  bool configure_sib1(const asn1::rrc_nr::mbs::sib1_s& sib, std::string& error)
+  {
+    auto next = settings;
+    if (!next.load_sib1(sib, error) || !install(next, error)) return false;
+    pending.clear(); ++mtch_generation;
+    return true;
+  }
+  bool configure_sib20(const asn1::rrc_nr::mbs::sib20_r17_s& sib, std::string& error)
+  {
+    auto next = settings;
+    if (!next.load_sib20(sib, error) || !install(next, error)) return false;
+    pending.clear(); ++mtch_generation;
+    return true;
+  }
+  bool configure_mcch(const asn1::rrc_nr::mbs::mbs_broadcast_cfg_r17_ies_s& mcch,
+                       const asn1::rrc_nr::mbs::mbs_session_info_r17_s& session, std::string& error)
+  {
+    auto next = settings;
+    if (!next.load_mcch(mcch, session, error) || !install(next, error)) return false;
+    ++mtch_generation;
+    pending.erase(std::remove_if(pending.begin(), pending.end(), [](const scheduled& item) { return item.role == channel::mtch; }), pending.end());
+    return true;
+  }
+
+  bool receive(const cf_t* samples, size_t count, unsigned slot_index, const callback& deliver)
+  {
+    if (!ready || !demod.demodulate(samples, count, slot_index, dl.sf_symbols[0])) return false;
+    srsran_slot_cfg_t slot{}; slot.idx = slot_index;
+    ++stats.slots;
+    dl.pdcch_info_count = 0;
+    if (have_slot && slot_index != (last_slot + 1) % (10240 * slots_per_subframe())) pending.clear();
+    have_slot = true; last_slot = slot_index;
+    // Move due grants out before delivery: an MCCH callback can replace radio
+    // settings and invalidate queued MTCHs without invalidating this iterator.
+    std::vector<scheduled> due;
+    for (auto it = pending.begin(); it != pending.end();) {
+      if (it->slot == slot_index) { due.push_back(std::move(*it)); it = pending.erase(it); }
+      else ++it;
+    }
+    for (auto& item : due) {
+      if (item.radio_generation != radio_generation ||
+          (item.role == channel::mtch &&
+           (item.pdsch.grant.rnti != cfg.group_rnti || item.group_generation != mtch_generation))) continue;
+      if (!decode_pdsch(slot, item.role, item.pdsch, deliver, item.repetition)) return false;
+    }
+    if (control_handler) {
+      if (!decode(slot, 0xffff, channel::sib1, deliver) || !decode(slot, 0xffff, channel::si, deliver)) return false;
+      if (!decode(slot, cfg.standard_mbs ? 0xfffd : 0xffff, channel::mcch, deliver)) return false;
+    }
+    return cfg.group_rnti == 0 || decode(slot, cfg.group_rnti, channel::mtch, deliver);
+  }
+
+private:
+  enum class channel { sib1, si, mcch, mtch };
+  struct repetition_state {
+    srsran_softbuffer_rx_t buffer{};
+    bool ready = false, delivered = false;
+    explicit repetition_state(const srsran_sch_tb_t& tb)
+    {
+      srsran_cbsegm_t segmentation{};
+      const int status = srsran_sch_nr_select_basegraph(tb.tbs, tb.R) == BG1 ?
+          srsran_cbsegm_ldpc_bg1(&segmentation, tb.tbs) : srsran_cbsegm_ldpc_bg2(&segmentation, tb.tbs);
+      if (status < 0 || !segmentation.C || segmentation.C > SRSRAN_SCH_NR_MAX_NOF_CB_LDPC) return;
+      ready = srsran_softbuffer_rx_init_guru(&buffer, segmentation.C, SRSRAN_LDPC_MAX_LEN_ENCODED_CB) == SRSRAN_SUCCESS;
+      if (ready) srsran_softbuffer_rx_reset(&buffer);
+    }
+    ~repetition_state() { srsran_softbuffer_rx_free(&buffer); }
+    repetition_state(const repetition_state&) = delete;
+    repetition_state& operator=(const repetition_state&) = delete;
+  };
+  struct scheduled {
+    unsigned slot;
+    channel role;
+    srsran_sch_cfg_nr_t pdsch;
+    uint64_t group_generation;
+    uint64_t radio_generation;
+    std::shared_ptr<repetition_state> repetition;
+  };
+  std::vector<std::weak_ptr<repetition_state>> repetitions;
+  std::vector<scheduled> pending;
+  mbs_radio_config settings, bootstrap;
+  uint64_t mtch_generation = 0;
+  uint64_t radio_generation = 0;
+  srsran_mib_nr_t last_mib{};
+  bool mib_valid = false;
+  bool have_slot = false;
+  unsigned last_slot = 0;
+  bool install(const mbs_radio_config& next, std::string& error)
+  {
+    srsran_dci_cfg_nr_t dci{};
+    dci.bwp_dl_initial_bw = dci.bwp_dl_active_bw = next.initial_width;
+    dci.bwp_ul_initial_bw = dci.bwp_ul_active_bw = cfg.prbs;
+    dci.coreset0_bw = srsran_coreset_get_bw(&next.pdcch.coreset[0]);
+    dci.monitor_common_0_0 = dci.monitor_0_0_and_1_0 = true;
+    if (srsran_ue_dl_nr_set_pdcch_config(&dl, &next.pdcch, &dci) != SRSRAN_SUCCESS) {
+      dci.bwp_dl_initial_bw = dci.bwp_dl_active_bw = settings.initial_width;
+      dci.coreset0_bw = srsran_coreset_get_bw(&settings.pdcch.coreset[0]);
+      if (srsran_ue_dl_nr_set_pdcch_config(&dl, &settings.pdcch, &dci) != SRSRAN_SUCCESS) ready = false;
+      error = "Unable to install PDCCH configuration"; return false;
+    }
+    settings = next;
+    ++radio_generation;
+    return true;
+  }
+  bool decode_pdsch(const srsran_slot_cfg_t& slot, channel role, srsran_sch_cfg_nr_t& pdsch, const callback& deliver,
+                     const std::shared_ptr<repetition_state>& repetition = {})
+  {
+    if ((repetition && repetition->delivered) || !settings.allows_downlink(slot.idx, pdsch.grant.S, pdsch.grant.L)) return true;
+    payload.resize(pdsch.grant.tb[0].tbs / 8);
+    if (!repetition) srsran_softbuffer_rx_reset(&softbuffer);
+    pdsch.grant.tb[0].softbuffer.rx = repetition ? &repetition->buffer : &softbuffer;
+    srsran_pdsch_res_nr_t result{}; result.tb[0].payload = payload.data();
+    if (srsran_ue_dl_nr_decode_pdsch(&dl, &slot, &pdsch, &result) != SRSRAN_SUCCESS) return false;
+    if (result.tb[0].crc) {
+      ++stats.crc_ok;
+      if (repetition) repetition->delivered = true;
+      if (role == channel::mtch) deliver(pdsch.grant.rnti, payload.data(), payload.size());
+      else if (control_handler) control_handler(role == channel::mcch, payload.data(), payload.size());
+    } else {
+      ++stats.crc_fail;
+      // If individual code-block CRCs passed but the TB CRC failed, allow
+      // subsequent occasions to decode those blocks again after combining.
+      if (repetition) {
+        auto& buffer = repetition->buffer;
+        bool all = true;
+        for (unsigned cb = 0; cb < buffer.max_cb; ++cb) all = all && buffer.cb_crc[cb];
+        if (all) srsran_softbuffer_rx_reset_cb_crc(&buffer, buffer.max_cb);
+      }
+    }
+    return true;
+  }
+  bool decode(const srsran_slot_cfg_t& slot, uint16_t rnti, channel role, const callback& deliver)
+  {
+    // Snapshot calendar and PDSCH settings: callbacks may install a new MCCH.
+    const bool system_info = role == channel::si || role == channel::sib1;
+    const auto search = role == channel::sib1 ? settings.sib1 : role == channel::si ? settings.si : role == channel::mcch ? settings.mcch : settings.mtch;
+    const auto profile = role == channel::mcch ? settings.mcch_pdsch : settings.mtch_pdsch;
+    if (!search.monitors(slot.idx)) return true;
+    const auto type = system_info ? srsran_rnti_type_si : srsran_rnti_type_p;
+    for (unsigned symbol = 0; symbol < 14; ++symbol) {
+      if (!(search.symbols & (1U << symbol)) ||
+          !settings.allows_downlink(slot.idx, symbol, settings.pdcch.coreset[search.phy.coreset_id].duration)) continue;
+      std::fill(std::begin(dl.cfg.search_space_present), std::end(dl.cfg.search_space_present), false);
+      dl.cfg.search_space_present[0] = true;
+      dl.cfg.search_space[0] = search.phy;
+      dl.cfg.search_space[0].type = role == channel::sib1 ? srsran_search_space_type_common_0 : role == channel::si ? srsran_search_space_type_common_0A : srsran_search_space_type_common_2;
+      const unsigned coreset_id = search.phy.coreset_id;
+      if (srsran_dmrs_pdcch_estimate_at(&dl.dmrs_pdcch[coreset_id], &slot, symbol, dl.sf_symbols[0]) < 0) return false;
+      std::array<srsran_dci_dl_nr_t, SRSRAN_MAX_DCI_MSG_NR> grants{};
+      cf_t* grid = dl.sf_symbols[0];
+      dl.sf_symbols[0] += symbol * carrier.nof_prb * 12;
+      const int n = cfg.standard_mbs && !system_info ? find_dci4(slot, rnti, search.phy, grants.data(), grants.size()) :
+          srsran_ue_dl_nr_find_dl_dci(&dl, &slot, rnti, type, grants.data(), grants.size());
+      dl.sf_symbols[0] = grid;
+      if (n < 0) return false;
+      stats.dcis += n;
+      for (int i = 0; i < n; ++i) {
+        if (system_info && (grants[i].sii == 0) != (role == channel::sib1)) continue;
+        srsran_sch_cfg_nr_t pdsch{};
+        pdsch.dmrs.typeA_pos = settings.initial.common.typeA_pos;
+        const bool valid = system_info ?
+            srsran_ra_dl_dci_to_grant_nr(&carrier, &slot, &settings.initial.common, &grants[i], &pdsch, &pdsch.grant) == SRSRAN_SUCCESS :
+            make_mbs_pdsch(carrier, profile, grants[i], pdsch);
+        if (!valid || pdsch.grant.tb[0].tbs <= 0 || pdsch.grant.tb[0].tbs / 8 > 65536 || pdsch.grant.k > 128) {
+          ++stats.invalid_grants; continue;
+        }
+        const unsigned count = role == channel::mtch ? profile.repetition_count(grants[i].time_domain_assigment) : 1;
+        if (!count || count > 16 || pending.size() + count > 64) { ++stats.invalid_grants; continue; }
+        std::shared_ptr<repetition_state> repetition;
+        if (count > 1) {
+          repetitions.erase(std::remove_if(repetitions.begin(), repetitions.end(),
+              [](const std::weak_ptr<repetition_state>& item) { return item.expired(); }), repetitions.end());
+          if (repetitions.size() >= 8) { ++stats.invalid_grants; continue; }
+          repetition = std::make_shared<repetition_state>(pdsch.grant.tb[0]);
+          if (!repetition->ready) return false;
+          repetitions.push_back(repetition);
+        }
+        const unsigned delay = pdsch.grant.k;
+        for (unsigned occasion = 0; occasion < count; ++occasion) {
+          auto next = pdsch;
+          next.grant.tb[0].rv = mbs_repetition_rv(grants[i].rv, occasion);
+          if (delay + occasion) {
+            pending.push_back({(slot.idx + delay + occasion) % (10240 * slots_per_subframe()), role, next,
+                               mtch_generation, radio_generation, repetition});
+          } else if (!decode_pdsch(slot, role, next, deliver, repetition)) return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  int find_dci4(const srsran_slot_cfg_t& slot, uint16_t rnti, const srsran_search_space_t& search,
+                srsran_dci_dl_nr_t* grants, unsigned capacity)
+  {
+    const unsigned id = search.coreset_id;
+    const auto& coreset = dl.cfg.coreset[id];
+    if (srsran_pdcch_nr_set_carrier(&dl.pdcch, &carrier, &coreset) < 0) return -1;
+    unsigned count = 0;
+    for (unsigned L = 0; L < 5 && count < capacity; ++L) {
+      uint32_t candidates[SRSRAN_SEARCH_SPACE_MAX_NOF_CANDIDATES_NR]{};
+      const int n = srsran_pdcch_nr_locations_coreset(&coreset, &search, rnti, L,
+          SRSRAN_SLOT_NR_MOD(carrier.scs, slot.idx), candidates);
+      if (n < 0) return -1;
+      for (int candidate = 0; candidate < n && count < capacity; ++candidate) {
+        srsran_dci_msg_nr_t message{};
+        message.ctx.rnti = rnti; message.ctx.rnti_type = srsran_rnti_type_p;
+        message.ctx.ss_type = srsran_search_space_type_common_2;
+        message.ctx.format = srsran_dci_format_nr_1_0;
+        message.ctx.coreset_id = id;
+        message.ctx.coreset_start_rb = srsran_coreset_start_rb(&coreset);
+        message.ctx.location.L = L; message.ctx.location.ncce = candidates[candidate];
+        message.nof_bits = srsran_dci_nr_size(&dl.dci, message.ctx.ss_type, message.ctx.format);
+        srsran_dmrs_pdcch_measure_t measure{};
+        if (srsran_dmrs_pdcch_get_measure(&dl.dmrs_pdcch[id], &message.ctx.location, &measure) < 0) return -1;
+        if (!std::isnormal(measure.norm_corr) || measure.norm_corr < dl.pdcch_dmrs_corr_thr || measure.epre_dBfs < dl.pdcch_dmrs_epre_thr) continue;
+        if (srsran_dmrs_pdcch_get_ce(&dl.dmrs_pdcch[id], &message.ctx.location, dl.pdcch_ce) < 0) return -1;
+        srsran_pdcch_nr_res_t result{};
+        if (srsran_pdcch_nr_decode_mbs(&dl.pdcch, dl.sf_symbols[0], dl.pdcch_ce, &message, &result) < 0) return -1;
+        unsigned notification = 0;
+        const unsigned width = settings.initial.allocation_width;
+        if (result.crc && unpack_mbs_dci_4_0(message, width, grants[count], notification)) ++count;
+      }
+    }
+    return count;
+  }
+
+private:
+  bool ready = false;
+  config cfg;
+  mbs_slot_demodulator demod;
+  srsran_carrier_nr_t carrier{};
+  srsran_ue_dl_nr_t dl{};
+  srsran_softbuffer_rx_t softbuffer{};
+  srsran_sch_hl_cfg_nr_t common{};
+  cf_t* scratch = nullptr;
+  std::vector<uint8_t> payload;
+  control_callback control_handler;
+};
+} // namespace nr
+} // namespace srsue
+#endif
diff --git a/srsue/hdr/phy/nr/mbs_slot_demodulator.h b/srsue/hdr/phy/nr/mbs_slot_demodulator.h
new file mode 100644
index 000000000..7c4b9db80
--- /dev/null
+++ b/srsue/hdr/phy/nr/mbs_slot_demodulator.h
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#ifndef SRSUE_MBS_SLOT_DEMODULATOR_H
+#define SRSUE_MBS_SLOT_DEMODULATOR_H
+
+#include "srsran/srsran.h"
+#include <cmath>
+#include <complex>
+#include <cstdint>
+#include <vector>
+
+namespace srsue {
+namespace nr {
+
+// Normal-CP FR1 slot receiver (TS 38.211 5.3.1). The legacy LTE OFDM
+// demodulator places long CPs at symbols 0 and 7, which is wrong at 30 kHz.
+class mbs_slot_demodulator
+{
+public:
+  ~mbs_slot_demodulator()
+  {
+    if (plan.size) srsran_dft_plan_free(&plan);
+    free(bins);
+  }
+  mbs_slot_demodulator() = default;
+  mbs_slot_demodulator(const mbs_slot_demodulator&) = delete;
+  mbs_slot_demodulator& operator=(const mbs_slot_demodulator&) = delete;
+
+  bool init(double rate, unsigned scs_khz, unsigned prbs, double center_hz)
+  {
+    if (plan.size || !std::isfinite(rate) || !std::isfinite(center_hz) ||
+        rate <= 0 || center_hz <= 0 || (scs_khz != 15 && scs_khz != 30) || prbs == 0 || prbs > 275) {
+      return false;
+    }
+    const double size = rate / (scs_khz * 1000.0);
+    if (size < 128 || size > 4096 || std::abs(size - std::round(size)) > 1e-6) return false;
+    fft_size = std::lround(size);
+    if (fft_size % 128 || prbs * 12 > fft_size) return false;
+    if (srsran_dft_plan_c(&plan, fft_size, SRSRAN_DFT_FORWARD) != SRSRAN_SUCCESS) return false;
+    bins = srsran_vec_cf_malloc(fft_size);
+    if (!bins) return false;
+    srsran_dft_plan_set_norm(&plan, true);
+    srsran_dft_plan_set_mirror(&plan, false);
+    rate_hz = rate;
+    carrier_hz = center_hz;
+    numerology = scs_khz == 30 ? 1 : 0;
+    nof_sc = prbs * 12;
+    window_rotation.resize(nof_sc);
+    const unsigned window = (fft_size * 144 / 2048) / 2;
+    for (unsigned sc = 0; sc < nof_sc; ++sc) {
+      const int k = int(sc) - int(nof_sc / 2);
+      const double correction = 2 * M_PI * k * window / fft_size;
+      __real__ window_rotation[sc] = std::cos(correction);
+      __imag__ window_rotation[sc] = std::sin(correction);
+    }
+    return true;
+  }
+
+  unsigned samples_per_slot() const { return fft_size * 15; }
+  unsigned slots_per_subframe() const { return 1U << numerology; }
+  unsigned cp_samples(unsigned symbol) const
+  {
+    const bool long_cp = symbol == 0 || (numerology == 0 && symbol == 7);
+    return fft_size * (144 + (long_cp ? (16U << numerology) : 0)) / 2048;
+  }
+
+  bool demodulate(const cf_t* samples, size_t count, unsigned slot_index, cf_t* grid)
+  {
+    if (!bins || !samples || !grid || count < samples_per_slot()) return false;
+    const unsigned window = (fft_size * 144 / 2048) / 2;
+    unsigned cursor = 0;
+    for (unsigned symbol = 0; symbol < 14; ++symbol) {
+      cursor += cp_samples(symbol);
+      srsran_dft_run_c(&plan, samples + cursor - window, bins);
+      const uint64_t absolute_sample = uint64_t(slot_index % (10 * slots_per_subframe())) * samples_per_slot() + cursor;
+      const double phase = 2 * M_PI * std::remainder(carrier_hz * (double(absolute_sample) / rate_hz), 1.0);
+      cf_t symbol_rotation;
+      __real__ symbol_rotation = std::cos(phase);
+      __imag__ symbol_rotation = std::sin(phase);
+      for (unsigned sc = 0; sc < nof_sc; ++sc) {
+        const int k = int(sc) - int(nof_sc / 2);
+        const unsigned bin = k < 0 ? fft_size + k : k;
+        grid[symbol * nof_sc + sc] = bins[bin] * window_rotation[sc] * symbol_rotation;
+      }
+      cursor += fft_size;
+    }
+    return cursor == samples_per_slot();
+  }
+
+private:
+  srsran_dft_plan_t plan{};
+  cf_t* bins = nullptr;
+  unsigned fft_size = 0, numerology = 0, nof_sc = 0;
+  double rate_hz = 0, carrier_hz = 0;
+  std::vector<cf_t> window_rotation;
+};
+} // namespace nr
+} // namespace srsue
+#endif
diff --git a/srsue/hdr/phy/nr/ocudu_mbs_phy.h b/srsue/hdr/phy/nr/ocudu_mbs_phy.h
new file mode 100644
index 000000000..246a8b934
--- /dev/null
+++ b/srsue/hdr/phy/nr/ocudu_mbs_phy.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#ifndef SRSUE_OCUDU_MBS_PHY_H
+#define SRSUE_OCUDU_MBS_PHY_H
+#include "srsran/srsran.h"
+#include <algorithm>
+
+namespace srsue {
+namespace nr {
+// Use only common PDSCH configuration for OCUDU's paging-format PTM grants.
+// Dedicated CSI-RS reservations, MCS tables and scrambling IDs belong to the
+// unicast UE and must not leak into the group decoder.
+inline bool make_ocudu_mbs_pdsch(const srsran_carrier_nr_t& carrier,
+                                const srsran_slot_cfg_t& slot,
+                                const srsran_sch_hl_cfg_nr_t& serving,
+                                const srsran_dci_dl_nr_t& dci,
+                                srsran_sch_cfg_nr_t& result)
+{
+  if (dci.ctx.rnti_type != srsran_rnti_type_p || dci.ctx.format != srsran_dci_format_nr_1_0 ||
+      dci.smi != 1 || serving.nof_common_time_ra > SRSRAN_MAX_NOF_TIME_RA) {
+    return false;
+  }
+  srsran_sch_hl_cfg_nr_t common{};
+  common.typeA_pos = serving.typeA_pos;
+  common.scs_cfg = serving.scs_cfg;
+  common.mcs_table = srsran_mcs_table_64qam;
+  common.nof_common_time_ra = serving.nof_common_time_ra;
+  std::copy_n(serving.common_time_ra, common.nof_common_time_ra, common.common_time_ra);
+  result = {};
+  result.dmrs.typeA_pos = serving.typeA_pos;
+  return srsran_ra_dl_dci_to_grant_nr(&carrier, &slot, &common, &dci, &result, &result.grant) == SRSRAN_SUCCESS &&
+         result.grant.k == 0;
+}
+} // namespace nr
+} // namespace srsue
+#endif
