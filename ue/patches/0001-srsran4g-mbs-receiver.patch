+void rrc_nr::handle_system_info(const sys_info_s& sys_info)
+{
+  if (sys_info.crit_exts.type() != sys_info_s::crit_exts_c_::types::sys_info) {
+    logger.warning("Ignoring SystemInformation with criticalExtensions type=%s",
+                   sys_info.crit_exts.type().to_string());
+    return;
+  }
+
+  const sys_info_ies_s& ies = sys_info.crit_exts.sys_info();
+  logger.info("Processing NR SystemInformation with %u SIB item(s)", (uint32_t)ies.sib_type_and_info.size());
+
+  for (const auto& sib_item : ies.sib_type_and_info) {
+    logger.info("Received NR %s in SystemInformation", sib_item.type().to_string());
+    switch (sib_item.type().value) {
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib2:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib3:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib4:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib5:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib6:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib7:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib8:
+      case sys_info_ies_s::sib_type_and_info_item_c_::types_opts::sib9:
+        break;
+      default:
+        logger.warning("Ignoring unknown NR SIB item type=%s", sib_item.type().to_string());
+        break;
+    }
+  }
+
+  logger.warning("NR Release 17 MBS SystemInformation/MCCH is not decodable in this ASN.1 set; "
+                 "only baseline NR SIB2-SIB9 choices are generated");
+}
