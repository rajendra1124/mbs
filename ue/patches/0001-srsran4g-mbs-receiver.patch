+bool mbs_radio_config::load_mib(const srsran_mib_nr_t& mib, std::string& error)
+{
+  if (mib.scs_common != carrier.scs || carrier.scs > srsran_subcarrier_spacing_30kHz ||
+      mib.ss0_idx > 15 || mib.coreset0_idx > 15 || mib.ssb_idx > 7 || mib.ssb_offset > 23)
+    return reject(error, "MIB is outside the supported FR1 same-numerology SIB1 profile");
+  const double point_a = carrier.dl_center_frequency_hz - carrier.nof_prb * 6 * 15000 * (1U << unsigned(carrier.scs));
+  srsran_coreset_t coreset0{};
+  if (srsran_coreset_zero(carrier.pci, std::lround(carrier.ssb_center_freq_hz - point_a), carrier.scs, carrier.scs,
+                           mib.coreset0_idx, &coreset0) < 0 ||
+      srsran_coreset_start_rb(&coreset0) + srsran_coreset_get_bw(&coreset0) > carrier.nof_prb)
+    return reject(error, "MIB CORESET0 is outside the captured grid");
+  pdcch.coreset[0] = coreset0; pdcch.coreset_present[0] = true;
+  initial.start_rb = srsran_coreset_start_rb(&coreset0);
+  initial.bandwidth = initial.allocation_width = srsran_coreset_get_bw(&coreset0);
+  initial.common.typeA_pos = mib.dmrs_typeA_pos;
+  mcch_pdsch = mtch_pdsch = initial;
+  // TS 38.213 Table 13-11: normal FR1, multiplexing pattern 1.
+  static const unsigned O[] = {0,0,2,2,5,5,7,7,0,5,0,0,2,2,5,5};
+  const unsigned index = mib.ss0_idx;
+  const bool half = index < 8 && (index & 1);
+  const unsigned beam_slots = half ? mib.ssb_idx / 2 : index == 8 || index == 9 ? 2 * mib.ssb_idx : mib.ssb_idx;
+  sib1 = {};
+  sib1.period = 20 * (1U << unsigned(carrier.scs));
+  sib1.offset = (O[index] * (1U << unsigned(carrier.scs)) + beam_slots) % sib1.period;
+  sib1.duration = 2;
+  const unsigned first = index >= 10 ? 1 + (index & 1) : 0;
+  sib1.symbols = 1U << first;
+  if (half) sib1.symbols |= 1U << coreset0.duration;
+  sib1.phy.id = 0; sib1.phy.coreset_id = 0; sib1.phy.type = srsran_search_space_type_common_0;
+  sib1.phy.nof_formats = 1; sib1.phy.formats[0] = srsran_dci_format_nr_1_0;
+  for (unsigned L = 2; L < 5; ++L)
+    sib1.phy.nof_candidates[L] = std::min(4 >> (L - 2), srsran_pdcch_nr_max_candidates_coreset(&coreset0, L));
+  return true;
+}
+
+bool mbs_radio_config::load_sib1(const mbs::sib1_s& sib, std::string& error)
+{
+  if (!sib.serving_cell_cfg_common_present) return reject(error, "SIB1 omits serving-cell configuration");
+  uplink_symbols.clear();
+  if (sib.serving_cell_cfg_common.tdd_ul_dl_cfg_common_present) {
+    const auto& tdd = sib.serving_cell_cfg_common.tdd_ul_dl_cfg_common;
+    if (tdd.ref_subcarrier_spacing.to_number() != 15 * (1U << unsigned(carrier.scs)))
+      return reject(error, "TDD reference numerology differs from the captured carrier");
+    if (!append_tdd(tdd.pattern1, 1U << unsigned(carrier.scs), uplink_symbols, error) ||
+        (tdd.pattern2_present && !append_tdd(tdd.pattern2, 1U << unsigned(carrier.scs), uplink_symbols, error))) return false;
+  }
+  const auto& downlink = sib.serving_cell_cfg_common.dl_cfg_common;
+  bool matching_carrier = false;
+  for (const auto& scs : downlink.freq_info_dl.scs_specific_carrier_list) {
+    if (scs.subcarrier_spacing.to_number() != 15 * (1U << unsigned(carrier.scs))) continue;
+    if (matching_carrier || scs.offset_to_carrier || scs.carrier_bw != carrier.nof_prb)
+      return reject(error, "SIB1 carrier grid differs from the configured zero-offset capture");
+    matching_carrier = true;
+  }
+  if (!matching_carrier) return reject(error, "SIB1 omits the configured carrier numerology");
+  const auto& bwp = downlink.init_dl_bwp;
+  if (bwp.generic_params.subcarrier_spacing.to_number() != 15 * (1U << unsigned(carrier.scs)) || bwp.generic_params.cp_present)
+    return reject(error, "SIB1 changes the configured subcarrier spacing or cyclic prefix");
+  if (!bandwidth(bwp.generic_params.location_and_bw, initial_start, initial_width) ||
+      initial_start + initial_width > carrier.nof_prb) return reject(error, "Initial BWP is outside the captured carrier");
+  initial.common.nof_common_time_ra = 0;
+  if (bwp.pdsch_cfg_common_present && bwp.pdsch_cfg_common.type().value == asn1::setup_release_opts::setup) {
+    const auto& list = bwp.pdsch_cfg_common.setup().pdsch_time_domain_alloc_list;
+    initial.common.nof_common_time_ra = list.size();
+    if (list.size() > SRSRAN_MAX_NOF_TIME_RA) return false;
+    for (unsigned i = 0; i < list.size(); ++i)
+      if (!srsran::make_phy_common_time_ra(list[i], &initial.common.common_time_ra[i])) return false;
+  }
+  if (!bwp.pdcch_cfg_common_present || bwp.pdcch_cfg_common.type().value != asn1::setup_release_opts::setup)
+    return reject(error, "SIB1 omits PDCCH configuration");
+  const auto& p = bwp.pdcch_cfg_common.setup();
+  if (p.common_coreset_present && !coreset(p.common_coreset, initial_start, carrier, pdcch, error)) return false;
+  std::map<unsigned, mbs_search_space> spaces;
+  unsigned index = 0;
+  for (const auto& item : p.common_search_space_list) {
+    mbs_search_space value;
+    if (!search(item, value, error) || spaces.count(item.search_space_id)) return false;
+    if (p.common_search_space_list_ext_r16.is_present() && index < p.common_search_space_list_ext_r16->size()) {
+      const auto& ext = (*p.common_search_space_list_ext_r16)[index];
+      if (ext.coreset_id_r16_present) value.phy.coreset_id = ext.coreset_id_r16;
+      if (ext.freq_monitor_locations_r16_present) return reject(error, "Multiple frequency monitoring locations are unsupported");
+    }
+    if (p.common_search_space_list_ext2_r17.is_present() && index < p.common_search_space_list_ext2_r17->size()) {
+      const auto& ext = (*p.common_search_space_list_ext2_r17)[index];
+      if (ext.monitoring_slot_periodicity_and_offset_v1710_present) {
+        const auto& period = ext.monitoring_slot_periodicity_and_offset_v1710;
+        value.period = period.type().to_number();
+        switch (value.period) {
+#define PERIOD(n) case n: value.offset = period.sl##n(); break
+          PERIOD(32); PERIOD(64); PERIOD(128); PERIOD(5120); PERIOD(10240); PERIOD(20480);
+#undef PERIOD
+          default: return false;
+        }
+      }
+      if (ext.dur_r17_present) value.duration = ext.dur_r17;
+      if (ext.monitoring_slots_within_slot_group_r17_present) return reject(error, "Slot-group monitoring is unsupported");
+    }
+    if (!value.period || value.offset >= value.period || !value.duration || value.duration > value.period || !value.symbols ||
+        value.phy.coreset_id >= SRSRAN_UE_DL_NR_MAX_NOF_CORESET || !pdcch.coreset_present[value.phy.coreset_id])
+      return reject(error, "Invalid common search-space calendar or CORESET reference");
+    const auto& c = pdcch.coreset[value.phy.coreset_id];
+    for (unsigned symbol = 0; symbol < 14; ++symbol)
+      if ((value.symbols & (1U << symbol)) && symbol + c.duration > 14) return reject(error, "CORESET overruns slot");
+    spaces.emplace(item.search_space_id, value); ++index;
+  }
+  auto select = [&](unsigned id, mbs_search_space& target) {
+    if (id == 0) { target = sib1; return true; }
+    if (!spaces.count(id)) return reject(error, "SIB1 refers to an absent common search space");
+    target = spaces.at(id); return true;
+  };
+  if (p.search_space_other_sys_info_present && p.search_space_other_sys_info && !select(p.search_space_other_sys_info, si)) return false;
+  // The workspace OCUDU omits the r17 fields and uses its paging search space.
+  const unsigned mcch_id = p.search_space_mcch_r17_present ? p.search_space_mcch_r17 : p.paging_search_space;
+  if (!select(mcch_id, mcch) || !select(p.search_space_mtch_r17_present ? p.search_space_mtch_r17 : mcch_id, mtch)) return false;
+  sib1_valid = true;
+  return true;
+}
+
+bool mbs_radio_config::load_sib20(const mbs::sib20_r17_s& sib, std::string& error)
+{
+  mcch_pdsch = initial;
+  if (!sib.cfr_cfg_mcch_mtch_r17_present) return true;
+  const auto& cfr = sib.cfr_cfg_mcch_mtch_r17;
+  if (cfr.location_and_bw_broadcast_r17_present) {
+    if (cfr.location_and_bw_broadcast_r17.type() == mbs::location_and_bw_broadcast_r17_c::types::same_as_sib1_cfg_location_and_bw) {
+      if (!sib1_valid) return reject(error, "Broadcast CFR needs SIB1 first");
+      mcch_pdsch.start_rb = initial_start; mcch_pdsch.bandwidth = initial_width;
+    } else if (!bandwidth(cfr.location_and_bw_broadcast_r17.location_and_bw(), mcch_pdsch.start_rb, mcch_pdsch.bandwidth)) return false;
+  }
+  if (mcch_pdsch.start_rb + mcch_pdsch.bandwidth > carrier.nof_prb) return reject(error, "Broadcast CFR is outside captured carrier");
+  if (cfr.common_coreset_ext_r17_present && !coreset(cfr.common_coreset_ext_r17, initial_start, carrier, pdcch, error)) return false;
+  return !cfr.pdsch_cfg_mcch_r17_present || pdsch(cfr.pdsch_cfg_mcch_r17, 0, mcch_pdsch, error);
+}
+
+bool mbs_radio_config::load_mcch(const mbs::mbs_broadcast_cfg_r17_ies_s& cfg,
+                                const mbs::mbs_session_info_r17_s& session, std::string& error)
+{
+  mtch_pdsch = initial;
+  mtch_pdsch.start_rb = mcch_pdsch.start_rb;
+  mtch_pdsch.bandwidth = mcch_pdsch.bandwidth;
+  return !cfg.pdsch_cfg_mtch_r17_present || pdsch(cfg.pdsch_cfg_mtch_r17,
+      session.pdsch_cfg_idx_r17_present ? session.pdsch_cfg_idx_r17 : 0, mtch_pdsch, error);
+}
+} }
