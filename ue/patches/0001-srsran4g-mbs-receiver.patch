index 000000000..f98651578
--- /dev/null
+++ b/srsue/hdr/stack/mbs/mbs_control.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#pragma once
+#include "srsran/asn1/mbs_rrc_nr.h"
+#include "ocudu_mbs_rx.h"
+#include <map>
+#include <string>
+#include <functional>
+
+namespace srsue {
+// Broadcast control-plane state is owned by the receive thread. Each MRB has
+// independent sequence numbers, reassembly, timers and delivery counters.
+class mbs_control
+{
+public:
+  struct selection {
+    uint32_t service_id = 0;
+    unsigned plmn_index = 1;
+    uint16_t rnti_override = 0;
+    std::string explicit_plmn; // MCC followed by two or three MNC digits.
+  };
+  struct sdu { unsigned lcid; ocudu_mbs_rx::packet bytes; };
+  explicit mbs_control(selection value) : wanted(value) { mcch_rx.configure_mcch(); }
+  bool system_information(const uint8_t* data, size_t size);
+  bool mcch(const uint8_t* data, size_t size);
+  bool mcch_transport(const uint8_t* data, size_t size, uint64_t now);
+  bool mcch_slot(unsigned slot, unsigned slots_per_frame) const;
+  std::vector<sdu> consume(const uint8_t* data, size_t size, uint64_t now);
+  std::vector<sdu> poll(uint64_t now);
+  ocudu_mbs_rx::counters metrics() const;
+  void reset();
+  bool active() const { return !bearers.empty(); }
+  uint16_t rnti() const { return group; }
+  bool has_sib20() const { return sib20_valid; }
+  uint64_t generation() const { return revision; }
+  const std::string& diagnostic() const { return message; }
+  const asn1::rrc_nr::mbs::sib20_r17_s& sib20() const { return system; }
+  bool has_sib1() const { return sib1_valid; }
+  const asn1::rrc_nr::mbs::sib1_s& sib1() const { return cell; }
+  std::function<bool(const asn1::rrc_nr::mbs::sib1_s&, std::string&)> configure_sib1;
+  std::function<bool(const asn1::rrc_nr::mbs::sib20_r17_s&, std::string&)> configure_sib20;
+  std::function<bool(const asn1::rrc_nr::mbs::mbs_broadcast_cfg_r17_ies_s&,
+                     const asn1::rrc_nr::mbs::mbs_session_info_r17_s&, std::string&)> configure_mcch;
+
+private:
+  selection wanted;
+  bool sib20_valid = false;
+  bool sib1_valid = false;
+  asn1::rrc_nr::mbs::sib1_s cell;
+  std::vector<uint8_t> cell_fingerprint, system_fingerprint;
+  std::string plmn_identity(unsigned index) const;
+  uint16_t group = 0;
+  uint64_t revision = 0;
+  unsigned repeat_frames = 1, repeat_offset = 0, start_slot = 0, duration_slots = 2;
+  asn1::rrc_nr::mbs::sib20_r17_s system;
+  std::map<unsigned, ocudu_mbs_rx> bearers;
+  ocudu_mbs_rx::counters retired;
+  void release_bearers();
+  ocudu_mbs_rx mcch_rx;
+  std::vector<uint8_t> fingerprint;
+  std::string message;
+};
+} // namespace srsue
diff --git a/srsue/hdr/stack/mbs/ocudu_mbs_gateway.h b/srsue/hdr/stack/mbs/ocudu_mbs_gateway.h
new file mode 100644
index 000000000..0199decb4
--- /dev/null
+++ b/srsue/hdr/stack/mbs/ocudu_mbs_gateway.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#ifndef SRSUE_OCUDU_MBS_GATEWAY_H
+#define SRSUE_OCUDU_MBS_GATEWAY_H
+
+#include "ocudu_mbs_rx.h"
+#include <arpa/inet.h>
+#include <chrono>
+#include <mutex>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace srsue {
+// Shared by the PHY workers so RLC segments decoded in different slots meet
+// in a single MRB. No network I/O may block a radio worker.
+class ocudu_mbs_gateway
+{
+public:
+  ~ocudu_mbs_gateway() { if (fd >= 0) close(fd); }
+  ocudu_mbs_gateway() = default;
+  ocudu_mbs_gateway(const ocudu_mbs_gateway&) = delete;
+  ocudu_mbs_gateway& operator=(const ocudu_mbs_gateway&) = delete;
+
+  bool deliver(const uint8_t* data, size_t size, uint8_t lcid, uint16_t port)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return send(rx.consume(data, size, lcid, now_ms()), port);
+  }
+  bool tick(uint16_t port)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return send(rx.poll(now_ms()), port);
+  }
+  bool send_sdu(const ocudu_mbs_rx::packet& packet, uint16_t port)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return send({packet}, port);
+  }
+  void reset()
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    rx.reset();
+  }
+  ocudu_mbs_rx::counters metrics()
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return rx.stats;
+  }
+
+private:
+  static uint64_t now_ms()
+  {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+  bool send(const std::vector<ocudu_mbs_rx::packet>& packets, uint16_t port)
+  {
+    if (packets.empty()) return true;
+    if (fd < 0) {
+      fd = socket(AF_INET, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+      if (fd < 0) return false;
+    }
+    sockaddr_in destination{};
+    destination.sin_family = AF_INET;
+    destination.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    destination.sin_port = htons(port);
+    bool ok = true;
+    for (const auto& packet : packets) {
+      if (sendto(fd, packet.data(), packet.size(), MSG_DONTWAIT,
+                 reinterpret_cast<const sockaddr*>(&destination), sizeof(destination)) != ssize_t(packet.size())) {
+        ok = false;
+      }
+    }
+    return ok;
+  }
+  std::mutex mutex;
+  ocudu_mbs_rx rx;
+  int fd = -1;
+};
+} // namespace srsue
+#endif
diff --git a/srsue/hdr/stack/mbs/ocudu_mbs_rx.h b/srsue/hdr/stack/mbs/ocudu_mbs_rx.h
new file mode 100644
index 000000000..2bdb52b70
--- /dev/null
+++ b/srsue/hdr/stack/mbs/ocudu_mbs_rx.h
@@ -0,0 +1,445 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#ifndef SRSUE_OCUDU_MBS_RX_H
+#define SRSUE_OCUDU_MBS_RX_H
+
+#include <array>
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <vector>
+#include <utility>
+
+namespace srsue {
+// Broadcast bearer receiver, configured by MCCH or the static OCUDU profile.
+// Payload is the original NG-U SDU (raw TS in the demo). SDAP, ciphering and
+// ROHC are not handled by this bearer.
+class ocudu_mbs_rx
+{
+public:
+  using packet = std::vector<uint8_t>;
+  struct counters {
+    uint64_t transport_blocks = 0, rlc_pdus = 0, delivered = 0, malformed = 0, expired = 0, duplicates = 0;
+    uint64_t pdcp_lost = 0, reorder_timeouts = 0, resource_drops = 0;
+    counters& operator+=(const counters& other)
+    {
+      transport_blocks += other.transport_blocks;
+      rlc_pdus += other.rlc_pdus;
+      delivered += other.delivered;
+      malformed += other.malformed;
+      expired += other.expired;
+      duplicates += other.duplicates;
+      pdcp_lost += other.pdcp_lost;
+      reorder_timeouts += other.reorder_timeouts;
+      resource_drops += other.resource_drops;
+      return *this;
+    }
+  } stats;
+
+  bool configure(unsigned rlc_bits, unsigned pdcp_bits, unsigned rlc_timer, unsigned pdcp_timer,
+                 bool allow_idle_restart = false)
+  {
+    if ((rlc_bits != 6 && rlc_bits != 12) || (pdcp_bits != 12 && pdcp_bits != 18) ||
+        rlc_timer > 2000 || pdcp_timer > 2750) return false;
+    reset();
+    rlc_sn_bits = rlc_bits;
+    pdcp_sn_bits = pdcp_bits;
+    reassembly_ms = rlc_timer;
+    reordering_ms = pdcp_timer;
+    idle_restart = allow_idle_restart;
+    standard_rlc = !allow_idle_restart;
+    states.resize(1U << rlc_bits);
+    completed.assign(1U << rlc_bits, -1);
+    pdcp_enabled = true;
+    return true;
+  }
+  void configure_mcch()
+  {
+    configure(6, 12, 0, 0);
+    pdcp_enabled = false;
+  }
+
+  // Clear bearer state on loss of synchronization or session replacement.
+  // Counters remain cumulative so an RF interruption is visible to the user.
+  void reset()
+  {
+    for (auto& state : states) state = {};
+    reassembly_bytes = 0;
+    pending.clear();
+    ready_packets.clear();
+    pending_bytes = 0;
+    pdcp_valid = timer_running = false;
+    rlc_valid = false;
+    rlc_timer_running = false;
+    std::fill(completed.begin(), completed.end(), -1);
+  }
+
+  // Caller serializes access and supplies monotonic milliseconds.
+  std::vector<packet> consume(const uint8_t* data, size_t size, uint8_t lcid, uint64_t now)
+  {
+    expire(now);
+    ++stats.transport_blocks;
+    if ((!data && size) || (lcid == 0 && pdcp_enabled) || lcid > 32) {
+      ++stats.malformed;
+      return {};
+    }
+    // Validate the entire MAC TB before modifying reassembly state.
+    std::vector<std::pair<size_t, size_t>> sdus;
+    size_t pos = 0;
+    while (pos < size) {
+      const uint8_t header = data[pos++];
+      const uint8_t id = header & 0x3f;
+      if (header & 0x80) {
+        ++stats.malformed;
+        return {};
+      }
+      if (id == 63) {
+        break;
+      }
+      if ((id == 0 && pdcp_enabled) || id > 32 || size - pos < ((header & 0x40) ? 2U : 1U)) {
+        ++stats.malformed;
+        return {};
+      }
+      size_t length = data[pos++];
+      if (header & 0x40) {
+        length = (length << 8) | data[pos++];
+      }
+      if (length == 0 || length > size - pos) {
+        ++stats.malformed;
+        return {};
+      }
+      if (id == lcid) {
+        sdus.emplace_back(pos, length);
+      }
+      pos += length;
+    }
+    for (const auto& sdu : sdus) {
+      auto value = consume_rlc(data + sdu.first, sdu.second, now);
+      if (!value.empty()) {
+        if (pdcp_enabled) pdcp(std::move(value), now);
+        else { ready_packets.push_back(std::move(value)); ++stats.delivered; }
+      }
+    }
+    return poll(now);
+  }
+
+  // Called even in slots without MTCH, so the final packet behind a loss is
+  // released when t-Reordering expires, without waiting for another TB.
+  std::vector<packet> poll(uint64_t now)
+  {
+    expire(now);
+    auto result = std::move(ready_packets);
+    ready_packets.clear();
+    return result;
+  }
+
+  void expire(uint64_t now)
+  {
+    if (standard_rlc) {
+      if (rlc_timer_running && now >= rlc_timer_started && now - rlc_timer_started >= reassembly_ms) {
+        rlc_timer_running = false;
+        rlc_reassembly = rlc_trigger;
+        advance_reassembly();
+        for (auto& state : states) {
+          if (state.active && state.sequence < rlc_reassembly) { discard(state); ++stats.expired; }
+        }
+        update_rlc_timer(now);
+      }
+    } else {
+      for (auto& state : states) {
+        if (state.active && now >= state.started && now - state.started >= reassembly_ms) {
+          discard(state);
+          ++stats.expired;
+        }
+      }
+    }
+    if (timer_running && now >= timer_started && now - timer_started >= reordering_ms) {
+      ++stats.reorder_timeouts;
+      while (!pending.empty() && pending.begin()->first < reorder_count) {
+        stats.pdcp_lost += pending.begin()->first - rx_deliv;
+        rx_deliv = pending.begin()->first;
+        release_contiguous();
+      }
+      if (rx_deliv < reorder_count) {
+        stats.pdcp_lost += reorder_count - rx_deliv;
+        rx_deliv = reorder_count;
+      }
+      release_contiguous();
+      timer_running = false;
+      update_timer(now);
+    }
+    // Static testbed sessions may restart the SN after an idle interval.
+    if (idle_restart && pdcp_valid && pending.empty() && now >= last_pdcp_time && now - last_pdcp_time >= 200) {
+      pdcp_valid = false;
+    }
+  }
+
+private:
+  uint64_t reassembly_ms = 40, reordering_ms = 40;
+  unsigned rlc_sn_bits = 6, pdcp_sn_bits = 12;
+  bool idle_restart = true, rlc_valid = false;
+  bool pdcp_enabled = true;
+  bool standard_rlc = false, rlc_timer_running = false;
+  int64_t rlc_highest = 0, rlc_reassembly = 0, rlc_trigger = 0;
+  uint64_t rlc_timer_started = 0;
+  std::vector<int64_t> completed = std::vector<int64_t>(64, -1);
+  unsigned rlc_latest = 0;
+  static constexpr size_t max_sdu = 65507 + 3; // UDP limit plus largest PDCP header.
+  struct reassembly {
+    bool active = false, first = false;
+    size_t total = 0;
+    size_t bytes = 0;
+    uint64_t started = 0;
+    int64_t sequence = 0;
+    std::map<size_t, packet> segments;
+  };
+  std::vector<reassembly> states = std::vector<reassembly>(64);
+  size_t reassembly_bytes = 0;
+  void discard(reassembly& state)
+  {
+    reassembly_bytes -= state.bytes;
+    state = {};
+  }
+  unsigned rlc_index(int64_t count) const { return unsigned(count) & ((1U << rlc_sn_bits) - 1); }
+  void advance_reassembly()
+  {
+    while (rlc_reassembly < rlc_highest && completed[rlc_index(rlc_reassembly)] == rlc_reassembly)
+      ++rlc_reassembly;
+  }
+  bool missing_rlc_bytes() const
+  {
+    const auto& state = states[rlc_index(rlc_reassembly)];
+    if (!state.active || state.sequence != rlc_reassembly) return false;
+    size_t cursor = 0;
+    for (const auto& part : state.segments) {
+      if (part.first > cursor) return true;
+      cursor = part.first + part.second.size();
+    }
+    return false; // An unknown tail alone does not start t-Reassembly.
+  }
+  void update_rlc_timer(uint64_t now)
+  {
+    const int64_t base = rlc_highest - (1U << (rlc_sn_bits - 1));
+    if (rlc_timer_running && (rlc_trigger <= rlc_reassembly ||
+        (rlc_trigger < base && rlc_trigger != rlc_highest) ||
+        (rlc_highest == rlc_reassembly + 1 && !missing_rlc_bytes()))) rlc_timer_running = false;
+    if (!rlc_timer_running && (rlc_highest > rlc_reassembly + 1 ||
+        (rlc_highest == rlc_reassembly + 1 && missing_rlc_bytes()))) {
+      rlc_timer_running = true;
+      rlc_timer_started = now;
+      rlc_trigger = rlc_highest;
+    }
+  }
+  void update_rlc_window(int64_t count, uint64_t now)
+  {
+    if (count >= rlc_highest) {
+      rlc_highest = count + 1;
+      const int64_t base = rlc_highest - (1U << (rlc_sn_bits - 1));
+      for (auto& state : states) {
+        if (state.active && state.sequence < base) { discard(state); ++stats.expired; }
+      }
+      if (rlc_reassembly < base) { rlc_reassembly = base; advance_reassembly(); }
+    }
+    update_rlc_timer(now);
+  }
+  bool pdcp_valid = false;
+  uint64_t last_pdcp_time = 0;
+  int64_t rx_deliv = 0, rx_next = 0, reorder_count = 0;
+  bool timer_running = false;
+  uint64_t timer_started = 0;
+  size_t pending_bytes = 0;
+  std::map<int64_t, packet> pending;
+  std::vector<packet> ready_packets;
+
+  void release_contiguous()
+  {
+    while (!pending.empty() && pending.begin()->first == rx_deliv) {
+      pending_bytes -= pending.begin()->second.size();
+      ready_packets.push_back(std::move(pending.begin()->second));
+      pending.erase(pending.begin());
+      ++rx_deliv;
+      ++stats.delivered;
+    }
+  }
+
+  void update_timer(uint64_t now)
+  {
+    if (timer_running && rx_deliv >= reorder_count) timer_running = false;
+    if (!timer_running && rx_deliv < rx_next) {
+      timer_running = true;
+      timer_started = now;
+      reorder_count = rx_next;
+    }
+  }
+
+  void pdcp(packet pdu, uint64_t now)
+  {
+    const unsigned header_size = pdcp_sn_bits == 12 ? 2 : 3;
+    if (pdu.size() <= header_size || pdu.size() - header_size > 65507 ||
+        (pdu[0] & (pdcp_sn_bits == 12 ? 0xf0 : 0xfc)) != 0x80) {
+      ++stats.malformed;
+      return;
+    }
+    const unsigned sn = pdcp_sn_bits == 12 ? ((pdu[0] & 15) << 8) | pdu[1] :
+                                           ((pdu[0] & 3) << 16) | (pdu[1] << 8) | pdu[2];
+    const int64_t modulus = int64_t(1) << pdcp_sn_bits;
+    if (!pdcp_valid) {
+      rx_deliv = rx_next = sn;
+      pdcp_valid = true;
+    }
+    int64_t count = (rx_deliv & ~(modulus - 1)) + sn;
+    if (count < rx_deliv - modulus / 2) count += modulus;
+    else if (count >= rx_deliv + modulus / 2) count -= modulus;
+    if (count < rx_deliv || pending.count(count)) {
+      ++stats.duplicates;
+      return;
+    }
+    if (pending_bytes + pdu.size() > 8 * 1024 * 1024) {
+      ++stats.resource_drops;
+      return;
+    }
+    last_pdcp_time = now;
+    pdu.erase(pdu.begin(), pdu.begin() + header_size);
+    pending_bytes += pdu.size();
+    pending.emplace(count, std::move(pdu));
+    rx_next = std::max(rx_next, count + 1);
+    release_contiguous();
+    update_timer(now);
+  }
+
+  packet consume_rlc(const uint8_t* data, size_t length, uint64_t now)
+  {
+    ++stats.rlc_pdus;
+    const unsigned si = data[0] >> 6;
+    if (si == 0) {
+      if ((data[0] & 63) != 0 || length <= 1 || length - 1 > max_sdu) {
+        ++stats.malformed;
+        return {};
+      }
+      return packet(data + 1, data + length);
+    }
+    const unsigned sn_bytes = rlc_sn_bits == 6 ? 1 : 2;
+    if (length < sn_bytes || (rlc_sn_bits == 12 && (data[0] & 0x30))) {
+      ++stats.malformed;
+      return {};
+    }
+    const unsigned sn = rlc_sn_bits == 6 ? data[0] & 63 : ((data[0] & 15) << 8) | data[1];
+    const size_t header_length = sn_bytes + (si == 1 ? 0 : 2);
+    if (length <= header_length) {
+      ++stats.malformed;
+      return {};
+    }
+    const unsigned modulus = 1U << rlc_sn_bits;
+    int64_t sequence = sn;
+    if (standard_rlc) {
+      if (!rlc_valid) {
+        rlc_highest = rlc_reassembly = sn;
+        rlc_valid = true;
+      }
+      const int64_t base = rlc_highest - modulus / 2;
+      sequence = base + ((int64_t(sn) - base) % modulus + modulus) % modulus;
+      if (sequence < rlc_reassembly || completed[sn] == sequence) {
+        ++stats.duplicates;
+        return {};
+      }
+    } else if (!rlc_valid) {
+      rlc_latest = sn;
+      rlc_valid = true;
+    } else {
+      const unsigned forward = (sn + modulus - rlc_latest) % modulus;
+      if (forward && forward < modulus / 2) {
+        for (unsigned i = 1; i <= forward; ++i) {
+          auto& stale = states[(rlc_latest + i + modulus / 2) % modulus];
+          if (stale.active) { discard(stale); ++stats.expired; }
+        }
+        rlc_latest = sn;
+      } else if (forward == modulus / 2) {
+        ++stats.duplicates;
+        return {};
+      }
+    }
+    size_t offset = si == 1 ? 0 : (size_t(data[sn_bytes]) << 8) | data[sn_bytes + 1];
+    const size_t end = offset + length - header_length;
+    auto& state = states[sn];
+    if (end > max_sdu || (si != 1 && offset == 0)) {
+      discard(state);
+      ++stats.malformed;
+      return {};
+    }
+    if (!state.active) {
+      state.active = true;
+      state.started = now;
+      state.sequence = sequence;
+    }
+    packet segment(data + header_length, data + length);
+    auto duplicate = state.segments.find(offset);
+    if (duplicate != state.segments.end()) {
+      if (duplicate->second != segment) {
+        discard(state);
+        ++stats.malformed;
+      } else {
+        ++stats.duplicates;
+      }
+      return {};
+    }
+    // Reject overlaps and inconsistent terminal offsets; never emit corrupt SDUs.
+    for (const auto& old : state.segments) {
+      if ((offset < old.first + old.second.size() && end > old.first) ||
+          (si == 2 && old.first + old.second.size() > end)) {
+        discard(state);
+        ++stats.malformed;
+        return {};
+      }
+    }
+    if ((state.total && end > state.total) || (si == 2 && state.total && end != state.total)) {
+      discard(state);
+      ++stats.malformed;
+      return {};
+    }
+    if (state.segments.size() >= 1024) {
+      discard(state);
+      ++stats.malformed;
+      return {};
+    }
+    state.first = state.first || si == 1;
+    if (si == 2) {
+      state.total = end;
+    }
+    if (reassembly_bytes + segment.size() > 8 * 1024 * 1024) {
+      discard(state);
+      ++stats.resource_drops;
+      return {};
+    }
+    state.bytes += segment.size();
+    reassembly_bytes += segment.size();
+    state.segments.emplace(offset, std::move(segment));
+    if (standard_rlc) update_rlc_window(sequence, now);
+    if (!state.first || !state.total) {
+      return {};
+    }
+    size_t cursor = 0;
+    for (const auto& part : state.segments) {
+      if (part.first != cursor) {
+        return {};
+      }
+      cursor += part.second.size();
+    }
+    if (cursor != state.total) {
+      return {};
+    }
+    packet result;
+    result.reserve(cursor);
+    for (const auto& part : state.segments) {
+      result.insert(result.end(), part.second.begin(), part.second.end());
+    }
+    discard(state);
+    if (standard_rlc) {
+      completed[sn] = sequence;
+      if (sequence == rlc_reassembly) advance_reassembly();
+      update_rlc_timer(now);
+    }
+    return result;
+  }
+};
+} // namespace srsue
+#endif
