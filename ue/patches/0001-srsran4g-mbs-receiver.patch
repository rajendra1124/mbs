diff --git a/srsue/src/mbs_receiver_main.cc b/srsue/src/mbs_receiver_main.cc
new file mode 100644
index 000000000..a8fbb3bec
--- /dev/null
+++ b/srsue/src/mbs_receiver_main.cc
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+#include "srsue/hdr/phy/nr/mbs_radio_receiver.h"
+#include "srsue/hdr/stack/mbs/ocudu_mbs_gateway.h"
+#include "srsue/hdr/stack/mbs/mbs_control.h"
+extern "C" {
+#include "srsran/phy/rf/rf.h"
+}
+#include <boost/program_options.hpp>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <iomanip>
+#include <iostream>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+
+namespace {
+volatile std::sig_atomic_t running = 1;
+void stop(int) { running = 0; }
+
+struct rf_error_counts {
+  uint64_t overflows = 0, late = 0;
+};
+void count_rf_error(void* arg, srsran_rf_error_t error)
+{
+  auto& counts = *static_cast<rf_error_counts*>(arg);
+  if (error.type == srsran_rf_error_t::SRSRAN_RF_ERROR_OVERFLOW) ++counts.overflows;
+  if (error.type == srsran_rf_error_t::SRSRAN_RF_ERROR_LATE) ++counts.late;
+}
+
+struct source {
+  FILE* file = nullptr;
+  srsran_rf_t rf{};
+  bool radio_open = false, streaming = false, eof = false, truncated = false;
+  double rate = 0;
+  uint64_t samples_read = 0;
+  ~source()
+  {
+    if (streaming) srsran_rf_stop_rx_stream(&rf);
+    if (radio_open) srsran_rf_close(&rf);
+    if (file) fclose(file);
+  }
+  static int read(void* context, cf_t** buffers, uint32_t count, srsran_timestamp_t* timestamp)
+  {
+    auto& self = *static_cast<source*>(context);
+    if (!running) return -1;
+    if (self.file) {
+      const size_t n = fread(buffers[0], sizeof(cf_t), count, self.file);
+      const double seconds = double(self.samples_read) / self.rate;
+      srsran_timestamp_init(timestamp, time_t(seconds), seconds - std::floor(seconds));
+      self.samples_read += n;
+      if (n != count) {
+        self.eof = feof(self.file);
+        self.truncated = n != 0 || ferror(self.file);
+        return -1;
+      }
+      return n;
+    }
+    const int received = srsran_rf_recv_with_time_multi(&self.rf, reinterpret_cast<void**>(buffers), count, true,
+                                                       &timestamp->full_secs, &timestamp->frac_secs);
+    return received == int(count) ? received : -1;
+  }
+};
+struct synchronizer {
+  srsran_ue_sync_nr_t object{};
+  ~synchronizer() { srsran_ue_sync_nr_free(&object); }
+};
+struct output_file {
+  FILE* file = nullptr;
+  ~output_file() { if (file) fclose(file); }
+};
+} // namespace
+
+int main(int argc, char** argv)
+{
+  namespace po = boost::program_options;
+  srsue::nr::mbs_radio_receiver::config config;
+  std::string device = "uhd", device_args = "type=b200", iq_file, payload_file;
+  std::string service_id, explicit_plmn;
+  std::string wire_format = "ocudu";
+  unsigned plmn_index = 1;
+  double gain = 40;
+  unsigned rnti = config.group_rnti, lcid = 1, udp_port = 5005, max_subframes = 0, ssb_period = 20;
+  unsigned sync_loss_hold_ms = 100;
+  int aligned_sfn = -1;
+  po::options_description options("srsUE receive-only OCUDU MBS radio adapter (no uplink or registration)");
+  options.add_options()
+    ("help,h", "Show options")
+    ("rate", po::value<double>(&config.rate_hz)->default_value(config.rate_hz), "Receiver sample rate in Hz")
+    ("frequency", po::value<double>(&config.center_hz)->default_value(config.center_hz), "DL carrier center frequency in Hz")
+    ("ssb-frequency", po::value<double>(&config.ssb_hz)->default_value(config.ssb_hz), "SSB center frequency in Hz")
+    ("scs", po::value<unsigned>(&config.scs_khz)->default_value(30), "Common and SSB spacing, 15 or 30 kHz")
+    ("prbs", po::value<unsigned>(&config.prbs)->default_value(51), "DL carrier resource blocks")
+    ("pci", po::value<unsigned>(&config.pci)->default_value(1), "Physical cell ID")
+    ("coreset0", po::value<unsigned>(&config.coreset0_index)->default_value(13), "CORESET0 index from gNB/MIB")
+    ("pdsch-start", po::value<unsigned>(&config.pdsch_start)->default_value(2), "Common PDSCH allocation 0 start symbol")
+    ("pdsch-length", po::value<unsigned>(&config.pdsch_length)->default_value(12), "Common PDSCH allocation 0 symbol count")
+    ("rnti", po::value<unsigned>(&rnti)->default_value(65025), "Group RNTI in decimal")
+    ("service-id", po::value<std::string>(&service_id), "Six hexadecimal TMGI service digits; enables SIB20/MCCH session control")
+    ("mbs-wire-format", po::value<std::string>(&wire_format)->default_value("ocudu"), "ocudu: paging DCI/raw MCCH; release17: DCI 4_0 and MCCH MAC/RLC")
+    ("plmn-index", po::value<unsigned>(&plmn_index)->default_value(1), "TMGI PLMN index for service selection, 1..12")
+    ("plmn", po::value<std::string>(&explicit_plmn), "MCC/MNC (5 or 6 digits) used to resolve indexed or explicit TMGI identities")
+    ("lcid", po::value<unsigned>(&lcid)->default_value(1), "MRB LCID")
+    ("udp-port", po::value<unsigned>(&udp_port)->default_value(5005), "Loopback UDP output port; 0 disables UDP")
+    ("output-file", po::value<std::string>(&payload_file), "Write recovered SDUs consecutively, e.g. MPEG-TS")
+    ("iq-file", po::value<std::string>(&iq_file), "Read complex float32 IQ instead of a radio")
+    ("aligned-sfn", po::value<int>(&aligned_sfn)->default_value(-1), "IQ-file only: first sample is frame boundary; -1 uses SSB sync")
+    ("max-subframes", po::value<unsigned>(&max_subframes)->default_value(0), "Stop after N received milliseconds; 0 runs continuously")
+    ("ssb-period", po::value<unsigned>(&ssb_period)->default_value(20), "SSB periodicity in milliseconds")
+    ("sync-loss-hold-ms", po::value<unsigned>(&sync_loss_hold_ms)->default_value(sync_loss_hold_ms), "Keep timing and MRB reassembly through missed SSBs for this long before a full reset; 0 resets at the first miss")
+    ("pdcch-corr-thr", po::value<float>(&config.pdcch_corr_thr)->default_value(config.pdcch_corr_thr), "PDCCH DMRS normalized correlation needed before DCI decoding")
+    ("pdcch-epre-thr", po::value<float>(&config.pdcch_epre_thr_dbfs)->default_value(config.pdcch_epre_thr_dbfs), "PDCCH DMRS EPRE in dBFS needed before DCI decoding")
+    ("rf.device", po::value<std::string>(&device)->default_value(device), "RF plugin")
+    ("rf.args", po::value<std::string>(&device_args)->default_value(device_args), "RF device arguments including serial")
+    ("rf.gain", po::value<double>(&gain)->default_value(gain), "Receiver gain in dB");
+  try {
+    po::variables_map values;
+    po::store(po::parse_command_line(argc, argv, options), values);
+    po::notify(values);
+    if (values.count("help")) { std::cout << options << '\n'; return 0; }
+    if (rnti == 0 || rnti > 0xfff2 || lcid < 1 || lcid > 32 || udp_port > 65535 ||
+        (wire_format != "ocudu" && wire_format != "release17") ||
+        aligned_sfn < -1 || aligned_sfn > 1023 || (aligned_sfn >= 0 && iq_file.empty()) ||
+        (udp_port == 0 && payload_file.empty()) || !std::isfinite(gain) || sync_loss_hold_ms > 10000 ||
+        !std::isnormal(config.pdcch_corr_thr) || config.pdcch_corr_thr > 1 || !std::isnormal(config.pdcch_epre_thr_dbfs) ||
+        (ssb_period != 5 && ssb_period != 10 && ssb_period != 20 && ssb_period != 40 && ssb_period != 80 && ssb_period != 160)) {
+      throw std::runtime_error("Invalid group, output, synchronization, gain, PDCCH threshold or SSB period options");
+    }
+    config.group_rnti = rnti;
+    config.standard_mbs = wire_format == "release17";
+    std::unique_ptr<srsue::mbs_control> control;
+    if (!service_id.empty()) {
+      if (service_id.size() != 6 || service_id.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos ||
+          plmn_index < 1 || plmn_index > 12 ||
+          (!explicit_plmn.empty() && ((explicit_plmn.size() != 5 && explicit_plmn.size() != 6) ||
+                                     explicit_plmn.find_first_not_of("0123456789") != std::string::npos)))
+        throw std::runtime_error("Invalid TMGI service ID or PLMN identity");
+      srsue::mbs_control::selection selected;
+      selected.service_id = std::stoul(service_id, nullptr, 16);
+      selected.plmn_index = plmn_index;
+      selected.explicit_plmn = explicit_plmn;
+      selected.rnti_override = values["rnti"].defaulted() ? 0 : rnti;
+      control.reset(new srsue::mbs_control(selected));
+    }
+    auto receiver = std::unique_ptr<srsue::nr::mbs_radio_receiver>(new srsue::nr::mbs_radio_receiver);
+    if (!receiver->init(config)) throw std::runtime_error("Invalid or unsupported radio configuration");
+    output_file output;
+    if (!payload_file.empty()) {
+      // Exclusive creation protects an existing video/capture from accidental overwrite.
+      output.file = fopen(payload_file.c_str(), "wbx");
+      if (!output.file) throw std::runtime_error("Cannot create output file (it must not already exist)");
+    }
+    rf_error_counts rf_errors;
+    source input;
+    input.rate = config.rate_hz;
+    if (!iq_file.empty()) {
+      input.file = fopen(iq_file.c_str(), "rb");
+      if (!input.file) throw std::runtime_error("Cannot open IQ file");
+    } else {
+      std::vector<char> args(device_args.begin(), device_args.end());
+      args.push_back(0);
+      if (srsran_rf_open_devname(&input.rf, device.c_str(), args.data(), 1)) throw std::runtime_error("Cannot open SDR");
+      input.radio_open = true;
+      if (std::abs(srsran_rf_set_rx_srate(&input.rf, config.rate_hz) - config.rate_hz) > 1) throw std::runtime_error("SDR rejected sample rate");
+      srsran_rf_set_rx_freq(&input.rf, 0, config.center_hz);
+      srsran_rf_set_rx_gain(&input.rf, gain);
+      srsran_rf_register_error_handler(&input.rf, count_rf_error, &rf_errors);
+      if (srsran_rf_start_rx_stream(&input.rf, false)) throw std::runtime_error("Cannot start SDR receiver");
+      input.streaming = true;
+    }
+    synchronizer sync;
+    if (aligned_sfn < 0) {
+      srsran_ue_sync_nr_args_t args{};
+      args.max_srate_hz = config.rate_hz;
+      args.min_scs = config.scs_khz == 30 ? srsran_subcarrier_spacing_30kHz : srsran_subcarrier_spacing_15kHz;
+      args.nof_rx_channels = 1;
+      args.recv_obj = &input;
+      args.recv_callback = source::read;
+      // Missed SSBs tolerated while tracking; the main loop holds any remaining loss for the same budget.
+      args.max_track_misses = sync_loss_hold_ms / ssb_period;
+      if (srsran_ue_sync_nr_init(&sync.object, &args)) throw std::runtime_error("Cannot initialize SSB synchronizer");
+      srsran_ue_sync_nr_cfg_t cfg{};
+      cfg.N_id = config.pci;
+      cfg.ssb.srate_hz = config.rate_hz;
+      cfg.ssb.center_freq_hz = config.center_hz;
+      cfg.ssb.ssb_freq_hz = config.ssb_hz;
+      cfg.ssb.scs = args.min_scs;
+      cfg.ssb.pattern = config.scs_khz == 30 ? SRSRAN_SSB_PATTERN_C : SRSRAN_SSB_PATTERN_A;
+      cfg.ssb.duplex_mode = config.scs_khz == 30 ? SRSRAN_DUPLEX_MODE_TDD : SRSRAN_DUPLEX_MODE_FDD;
+      cfg.ssb.periodicity_ms = ssb_period;
+      if (srsran_ue_sync_nr_set_cfg(&sync.object, &cfg)) throw std::runtime_error("Cannot configure SSB synchronizer");
+    }
+    std::signal(SIGINT, stop);
+    std::signal(SIGTERM, stop);
+    const unsigned slot_size = receiver->samples_per_slot();
+    const unsigned slots_per_sf = receiver->slots_per_subframe();
+    std::vector<cf_t> samples(slot_size * slots_per_sf);
+    cf_t* buffers[SRSRAN_MAX_PORTS] = {samples.data()};
+    srsue::ocudu_mbs_gateway gateway;
+    srsue::ocudu_mbs_rx file_rx;
+    uint64_t udp_errors = 0;
+    uint64_t controlled_sdus = 0;
+    uint64_t received = 0;
+    unsigned current_slot = 0;
+    std::string last_control_error;
+    if (control) {
+      receiver->set_group(0);
+      control->configure_sib1 = [&](const asn1::rrc_nr::mbs::sib1_s& sib, std::string& error) {
+        return receiver->configure_sib1(sib, error);
+      };
+      control->configure_sib20 = [&](const asn1::rrc_nr::mbs::sib20_r17_s& sib, std::string& error) {
+        return receiver->configure_sib20(sib, error);
+      };
+      control->configure_mcch = [&](const asn1::rrc_nr::mbs::mbs_broadcast_cfg_r17_ies_s& cfg,
+                                    const asn1::rrc_nr::mbs::mbs_session_info_r17_s& session, std::string& error) {
+        return receiver->configure_mcch(cfg, session, error);
+      };
+      receiver->set_control_handler([&](bool is_mcch, const uint8_t* bytes, size_t size) {
+        const uint64_t previous = control->generation();
+        const bool had_sib20 = control->has_sib20();
+        const bool accepted = is_mcch ?
+            control->mcch_slot(current_slot, slots_per_sf * 10) &&
+                (config.standard_mbs ? control->mcch_transport(bytes, size, received) : control->mcch(bytes, size)) :
+            control->system_information(bytes, size);
+        if (accepted && (previous != control->generation() || had_sib20 != control->has_sib20())) {
+          std::cout << control->diagnostic() << "; group=" << control->rnti() << std::endl;
+        }
+        if (!is_mcch && !accepted && !control->diagnostic().empty() && control->diagnostic() != last_control_error) {
+          last_control_error = control->diagnostic();
+          std::cerr << "Broadcast configuration rejected: " << last_control_error << std::endl;
+        }
+        if (accepted) last_control_error.clear();
+        receiver->set_group(control->rnti());
+      });
+    }
+    auto emit_controlled = [&](std::vector<srsue::mbs_control::sdu> packets) {
+      for (const auto& packet : packets) {
+        // The requested LCID selects the application stream; other MRBs retain
+        // independent protocol state but are not concatenated into this stream.
+        if (packet.lcid != lcid) continue;
+        ++controlled_sdus;
+        if (udp_port && !gateway.send_sdu(packet.bytes, udp_port)) ++udp_errors;
+        if (output.file && fwrite(packet.bytes.data(), 1, packet.bytes.size(), output.file) != packet.bytes.size())
+          throw std::runtime_error("Output write failed");
+      }
+    };
+    bool was_synced = false, holding = false;
+    uint64_t hold_start = 0, last_sf_received = 0, held = 0, resets = 0;
+    unsigned last_sf = 0;
+    uint32_t miss_run = 0;
+    auto full_reset = [&]() {
+      std::string error;
+      if (!receiver->reset_radio(error)) throw std::runtime_error(error);
+      gateway.reset();
+      file_rx.reset();
+      if (control) { control->reset(); receiver->set_group(0); }
+      ++resets;
+    };
+    auto sync_stats = [&]() {
+      std::ostringstream text;
+      text << " held=" << held << " resets=" << resets << " uhd_O=" << rf_errors.overflows
+           << " uhd_L=" << rf_errors.late;
+      if (aligned_sfn < 0) {
+        text << " ssb_snr=" << std::fixed << std::setprecision(1) << sync.object.ssb_snr_db << "dB";
+      }
+      return text.str();
+    };
+    std::cout << "MBS receiver: " << config.scs_khz << " kHz, " << slots_per_sf << " slots/ms, group=" << rnti << '\n';
+    while (running && (max_subframes == 0 || received < max_subframes)) {
+      srsran_ue_sync_nr_outcome_t timing{};
+      if (aligned_sfn >= 0) {
+        if (source::read(&input, buffers, samples.size(), &timing.timestamp) < 0) break;
+        timing.in_sync = true;
+        timing.sfn = (aligned_sfn + received / 10) % 1024;
+        timing.sf_idx = received % 10;
+      } else if (srsran_ue_sync_nr_zerocopy(&sync.object, buffers, &timing) != SRSRAN_SUCCESS) {
+        if (input.eof || !running) break;
+        throw std::runtime_error("SDR/IQ synchronization receive error");
+      }
+      if (aligned_sfn < 0) {
+        // The legacy synchronizer reports the NEXT subframe. These samples
+        // belong to the preceding one, including at the 1024-frame wrap.
+        const unsigned current_sf = (timing.sfn * 10 + timing.sf_idx + 10239) % 10240;
+        timing.sfn = current_sf / 10;
+        timing.sf_idx = current_sf % 10;
+      }
+      ++received;
+      const unsigned sf_abs = timing.sfn * 10 + timing.sf_idx;
+      if (aligned_sfn < 0) {
+        // SSB misses absorbed by the synchronizer without leaving TRACK: decoding continued on the held timing.
+        if (sync.object.track_misses > miss_run) {
+          miss_run = sync.object.track_misses;
+        } else if (miss_run > 0 && sync.object.track_misses == 0 && timing.in_sync) {
+          std::cout << "SSB miss held: " << miss_run * ssb_period << " ms (tracking kept)\n";
+          ++held;
+          miss_run = 0;
+        }
+        if (!timing.in_sync) miss_run = 0;
+      }
+      if (!timing.in_sync) {
+        if (was_synced) {
+          was_synced = false;
+          if (sync_loss_hold_ms == 0) {
+            std::cout << "SSB synchronization lost; resetting MRB reassembly\n";
+            full_reset();
+          } else {
+            // Keep MRB reassembly and control state; skip decoding until the cell returns or the hold expires.
+            holding = true;
+            hold_start = received;
+          }
+        } else if (holding && received - hold_start >= sync_loss_hold_ms) {
+          holding = false;
+          std::cout << "SSB synchronization lost for " << sync_loss_hold_ms << " ms; resetting MRB reassembly\n";
+          full_reset();
+        }
+        continue;
+      }
+      if (!was_synced) {
+        const unsigned expected_sf = (last_sf + (received - last_sf_received)) % 10240;
+        if (holding && sf_abs == expected_sf) {
+          std::cout << "SSB miss held: " << received - hold_start << " ms (resynchronized, SFN continuous)\n";
+          ++held;
+        } else {
+          if (holding) {
+            std::cout << "SSB resynchronized with a timing jump (expected SFN=" << expected_sf / 10 << '.'
+                      << expected_sf % 10 << ", got " << timing.sfn << '.' << timing.sf_idx
+                      << "); resetting MRB reassembly\n";
+            full_reset();
+          }
+          std::cout << "SSB synchronized: SFN=" << timing.sfn << " CFO=" << timing.cfo_hz << " Hz\n";
+        }
+        holding = false;
+      }
+      last_sf = sf_abs;
+      last_sf_received = received;
+      if (aligned_sfn < 0 && sync.object.mib_valid) {
+        bool changed = false;
+        std::string error;
+        if (!receiver->configure_mib(sync.object.mib, changed, error)) throw std::runtime_error(error);
+        if (changed && control) { control->reset(); receiver->set_group(0); }
+      }
+      was_synced = true;
+      for (unsigned s = 0; s < slots_per_sf; ++s) {
+        const unsigned slot = (timing.sfn * 10 + timing.sf_idx) * slots_per_sf + s;
+        current_slot = slot;
+        if (!receiver->receive(samples.data() + s * slot_size, slot_size, slot,
+          [&](uint16_t, const uint8_t* tb, size_t size) {
+            if (control) { emit_controlled(control->consume(tb, size, received)); return; }
+            if (udp_port && !gateway.deliver(tb, size, lcid, udp_port)) ++udp_errors;
+            if (output.file) {
+              for (const auto& packet : file_rx.consume(tb, size, lcid, received)) {
+                if (fwrite(packet.data(), 1, packet.size(), output.file) != packet.size()) throw std::runtime_error("Output write failed");
+              }
+            }
+          })) throw std::runtime_error("MBS slot decoder failed");
+      }
+      if (control) emit_controlled(control->poll(received));
+      if (!control && udp_port && !gateway.tick(udp_port)) ++udp_errors;
+      if (output.file) {
+        for (const auto& packet : file_rx.poll(received)) {
+          if (fwrite(packet.data(), 1, packet.size(), output.file) != packet.size()) throw std::runtime_error("Output write failed");
+        }
+      }
+      if (received % 1000 == 0) {
+        const auto& stats = receiver->stats;
+        const auto bearer = control ? control->metrics() : (udp_port ? gateway.metrics() : file_rx.stats);
+        std::cout << "slots=" << stats.slots << " grants=" << stats.dcis << " crc_ok=" << stats.crc_ok
+                  << " crc_fail=" << stats.crc_fail << " sdus=" << (control ? controlled_sdus : bearer.delivered)
+                  << " malformed=" << bearer.malformed << " pdcp_lost=" << bearer.pdcp_lost
+                  << " udp_errors=" << udp_errors << sync_stats() << std::endl;
+      }
+    }
+    if (input.truncated) throw std::runtime_error("Truncated IQ subframe or input read error");
+    if (output.file && fflush(output.file)) throw std::runtime_error("Output flush failed");
+    const auto bearer = control ? control->metrics() : (udp_port ? gateway.metrics() : file_rx.stats);
+    std::cout << "Stopped: slots=" << receiver->stats.slots << " crc_ok=" << receiver->stats.crc_ok
+              << " crc_fail=" << receiver->stats.crc_fail << " sdus=" << (control ? controlled_sdus : bearer.delivered)
+              << " malformed=" << bearer.malformed << " pdcp_lost=" << bearer.pdcp_lost
+              << " udp_errors=" << udp_errors << sync_stats() << '\n';
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << "srsue_mbs: " << error.what() << '\n';
+    return 1;
+  }
+}
