+void cc_worker::decode_ocudu_mbs()
+{
+  if (!mbs_ready || cc_idx != 0 || cfg.carrier.scs != srsran_subcarrier_spacing_15kHz) {
+    return;
+  }
+  if (!phy.mbs_gateway.tick(phy.args.mbs_port)) {
+    logger.warning("OCUDU MBS UDP delivery failed while advancing reordering timer");
+  }
+  // OCUDU uses common search spaces and paging-format DCI 1_0, with the
+  // actual group RNTI in the CRC and PDSCH scrambling sequence. Keep the
+  // library's paging type to select that wire format; no HARQ-ACK is sent.
+  const auto saved_pdcch = ue_dl.cfg;
+  bool found_common = false;
+  for (unsigned i = 0; i < SRSRAN_UE_DL_NR_MAX_NOF_SEARCH_SPACE; ++i) {
+    auto& ss = ue_dl.cfg.search_space[i];
+    if (!ue_dl.cfg.search_space_present[i] || !SRSRAN_SEARCH_SPACE_IS_COMMON(ss.type) ||
+        ss.type == srsran_search_space_type_common_0) {
+      ue_dl.cfg.search_space_present[i] = false;
+      continue;
+    }
+    ss.type = srsran_search_space_type_common_2;
+    ss.nof_formats = 1;
+    ss.formats[0] = srsran_dci_format_nr_1_0;
+    found_common = true;
+  }
+  std::array<srsran_dci_dl_nr_t, SRSRAN_SEARCH_SPACE_MAX_NOF_CANDIDATES_NR> dcis{};
+  const int count = found_common ? srsran_ue_dl_nr_find_dl_dci(
+      &ue_dl, &dl_slot_cfg, phy.args.mbs_rnti, srsran_rnti_type_p, dcis.data(), dcis.size()) : 0;
+  ue_dl.cfg = saved_pdcch;
+  if (count < SRSRAN_SUCCESS) {
+    logger.warning("OCUDU MBS: PDCCH search failed");
+    return;
+  }
+  for (int i = 0; i < count; ++i) {
+    srsran_sch_cfg_nr_t group_cfg{};
+    if (!make_ocudu_mbs_pdsch(cfg.carrier, dl_slot_cfg, cfg.pdsch, dcis[i], group_cfg)) {
+      logger.warning("OCUDU MBS: invalid grant or unsupported nonzero k0");
+      continue;
+    }
+    auto data = srsran::make_byte_buffer();
+    const unsigned size = group_cfg.grant.tb[0].tbs / 8;
+    if (!data || size > data->get_tailroom()) {
+      logger.warning("OCUDU MBS: transport block exceeds receive buffer");
+      continue;
+    }
+    srsran_softbuffer_rx_reset(&mbs_softbuffer);
+    group_cfg.grant.tb[0].softbuffer.rx = &mbs_softbuffer;
+    srsran_pdsch_res_nr_t result{};
+    result.tb[0].payload = data->msg;
+    if (srsran_ue_dl_nr_decode_pdsch(&ue_dl, &dl_slot_cfg, &group_cfg, &result) < SRSRAN_SUCCESS) {
+      logger.warning("OCUDU MBS: PDSCH decoder failed");
+      continue;
+    }
+    ++mbs_tb_count;
+    mbs_crc_failures += !result.tb[0].crc;
+    if (result.tb[0].crc && !phy.mbs_gateway.deliver(data->msg, size, phy.args.mbs_lcid, phy.args.mbs_port)) {
+      logger.warning("OCUDU MBS: loopback UDP delivery failed");
+    }
+    if (mbs_tb_count == 1 || mbs_tb_count % 200 == 0) {
+      const auto stats = phy.mbs_gateway.metrics();
+      logger.info("OCUDU MBS: rnti=0x%x crc=%s worker_tbs=%llu crc_failures=%llu delivered=%llu malformed=%llu expired=%llu duplicates=%llu",
+                  phy.args.mbs_rnti, result.tb[0].crc ? "OK" : "KO",
+                  (unsigned long long)mbs_tb_count, (unsigned long long)mbs_crc_failures,
+                  (unsigned long long)stats.delivered,
+                  (unsigned long long)stats.malformed, (unsigned long long)stats.expired,
+                  (unsigned long long)stats.duplicates);
+    }
+  }
+}
