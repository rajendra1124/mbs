# MBS UE settings, read by ue/start.sh. Every value can be overridden on the command line,
# e.g.  RF_GAIN=60 SERVICE_ID=D83A6E ./ue/start.sh
# The cell values must match gnb/config/gnb.yml.

# Radio (USRP B200/B210). Add serial=... when several USRPs are attached.
# RF_DEVICE=file replays an IQ recording instead: RF_ARGS="rx_file=/path/rec.cf32,base_srate=23.04e6"
RF_DEVICE="${RF_DEVICE:-uhd}"
RF_ARGS="${RF_ARGS:-type=b200,num_recv_frames=512}"   # larger USB buffer absorbs host stalls
RF_GAIN="${RF_GAIN:-70}"

# Cell: n78, 3489.42 MHz, 20 MHz / 30 kHz SCS / 51 PRB, PCI 1, CORESET#0 index 13
SRATE="${SRATE:-23040000}"
FREQUENCY="${FREQUENCY:-3489420000}"
SSB_FREQUENCY="${SSB_FREQUENCY:-3488160000}"
SCS="${SCS:-30}"
PRBS="${PRBS:-51}"
PCI="${PCI:-1}"
CORESET0="${CORESET0:-13}"
SSB_PERIOD="${SSB_PERIOD:-20}"
PLMN="${PLMN:-99970}"

# Broadcast: G-RNTI 0xFE01 (65025) = first session after a gNB start, OCUDU wire format
GROUP_RNTI="${GROUP_RNTI:-65025}"
LCID="${LCID:-1}"
MBS_WIRE_FORMAT="${MBS_WIRE_FORMAT:-ocudu}"
SERVICE_ID="${SERVICE_ID:-}"          # optional 6-hex-digit session ID
PDCCH_CORR_THR="${PDCCH_CORR_THR:-0.04}"

# Output: the received MPEG-TS goes to UDP 127.0.0.1:${UDP_PORT}; the player listens there
UDP_PORT="${UDP_PORT:-5005}"
PLAYER="${PLAYER:-auto}"              # auto | vlc | ffplay | mpv | none
RECORD="${RECORD:-1}"                 # 1 = also save the stream as received_<time>.ts
SAVE_DIR="${SAVE_DIR:-/dev/shm/mbs_ue}"   # RAM (tmpfs): recording never blocks on disk; lost on reboot
